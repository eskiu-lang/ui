// ui: create an app on the ui package and build or run it on the web, macOS, iOS or Android.
//
//   eskiuc tools/ui.esk -o ~/.eskiu/bin/ui     # install (any directory on the PATH)
//   ui new myapp                              # a project that depends on ui
//   cd myapp && ui run ios                    # web | macos | ios | android
//
// Inside a project, the ui package is the one eskiu.lock names; its hosts (web/, desktop/,
// ios/, android/, hosts/) are built around the app. Yoga, for the native hosts, is fetched and
// compiled once into $ESKIU_HOME/cache.
import <io>;
import <string>;
import <list>;
import <fs>;
import <process>;
import <env>;
import <path>;
import <net>;
import <time>;

const string kUiGit = "https://github.com/eskiu-lang/ui";
const string kYogaGit = "https://github.com/react/yoga.git";
const string kYogaTag = "v3.2.1";

void fail(string message) {
    println_err(message);
    exit(1);
}

// A command line: its parts are copies, so temporaries can be passed.
struct Cmd { List<String> parts; }

void Cmd_add(Cmd* self, string part) {
    String copy;
    String_from(&copy, part);
    self.parts.push(copy);
}

void Cmd_free(Cmd* self) {
    for (i in 0..self.parts.size) { String_free(&self.parts.data[i]); }
    self.parts.free();
}

// Run it in `cwd` (null: here) with its output on ours; the exit code.
int Cmd_run(Cmd* self, string cwd) {
    List<string> argv;
    defer argv.free();
    for (i in 0..self.parts.size) { argv.push(self.parts.data[i].data); }
    ProcessOptions options = ProcessOptions{cwd: cwd, inherit_stdout: true, inherit_stderr: true};
    ProcessResult result;
    defer ProcessResult_free(&result);
    if (process_run(&argv, &options, &result) != 0) { return -1; }
    return result.exit_code;
}

// Run it and stop the tool if it fails.
void Cmd_must(Cmd* self, string cwd) {
    if (self.run(cwd) != 0) {
        String line;
        for (i in 0..self.parts.size) {
            if (i > 0) { String_append(&line, " "); }
            String_append(&line, self.parts.data[i].data);
        }
        print_err("ui: failed: ");
        fail(line.data);
    }
}

// Run it and keep its standard output, trimmed; false if it failed.
bool Cmd_output(Cmd* self, String* out) {
    List<string> argv;
    defer argv.free();
    for (i in 0..self.parts.size) { argv.push(self.parts.data[i].data); }
    ProcessResult result;
    defer ProcessResult_free(&result);
    if (process_run(&argv, null, &result) != 0 || result.exit_code != 0) { return false; }
    String_from(out, result.stdout.data == null ? "" : result.stdout.data);
    String_trim(out);
    return true;
}

// `a/b` into a fresh string the caller frees.
string join(string a, string b) {
    String out;
    path_join(&out, a, b);
    return out.data;
}

string eskiu_home() {
    string home = env_get("ESKIU_HOME");
    if (home != null && home[0] != 0) { return home; }
    return join(env_get("HOME"), ".eskiu");
}

string eskiuc() {
    string path = env_get("ESKIUC");
    return path != null && path[0] != 0 ? path : "eskiuc";
}

bool newer(string source, string target) {
    FileStat a;
    FileStat b;
    if (fs_stat(target, &b) != 0) { return true; }
    if (fs_stat(source, &a) != 0) { return true; }
    return a.mtime > b.mtime;
}

// The project: its root (where eskiu.toml is), its name, and the ui package's root.
struct Project { String root; String name; String ui; String id; }

// The value of `key = "..."` on its own line in a TOML file, or "".
void toml_value(string text, string key, String* out) {
    List<String> lines;
    defer fs_list_free(&lines);
    String all;
    defer String_free(&all);
    String_from(&all, text);
    String_lines(&all, &lines);
    for (i in 0..lines.size) {
        String* line = &lines.data[i];
        String_trim(line);
        if (String_starts_with(line, key) != 1) { continue; }
        int64 quote = String_index_of(line, '"');
        if (quote < 0) { continue; }
        String_clear(out);
        for (int64 j = quote + 1; j < line.len && line.data[j] != '"'; j++) {
            char[2] one;
            one[0] = line.data[j]; one[1] = 0;
            String_append(out, (string)&one[0]);
        }
        return;
    }
}

void Project_find(Project* self) {
    String dir;
    fs_cwd(&dir);
    while (true) {
        string toml = join(dir.data, "eskiu.toml");
        if (fs_exists(toml) == 1) { free(toml); break; }
        free(toml);
        String parent;
        path_dirname(&parent, dir.data);
        if (String_eq_cstr(&parent, dir.data) == 1) { fail("ui: no eskiu.toml here or above; run ui new NAME first"); }
        String_free(&dir);
        dir = parent;
    }
    self.root = dir;
    String text;
    defer String_free(&text);
    fs_read_text(join(dir.data, "eskiu.toml"), &text);
    toml_value(text.data, "name", &self.name);
    if (self.name.len == 0) { String_from(&self.name, "app"); }
    // org.eskiu.app.NAME: lowercase letters and digits, others as "_".
    String_from(&self.id, "org.eskiu.app.");
    for (i in 0..self.name.len) {
        char c = self.name.data[i];
        if (c >= 'A' && c <= 'Z') { c = (char)(c + 32); }
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) { c = '_'; }
        char[2] one;
        one[0] = c; one[1] = 0;
        String_append(&self.id, (string)&one[0]);
    }
    // The ui package: the lock's entry (NAME git URL REV COMMIT, or NAME path DIR).
    String lock;
    defer String_free(&lock);
    if (fs_read_text(join(dir.data, "eskiu.lock"), &lock) != 0) {
        fail("ui: no eskiu.lock: run eskiuc build or eskiuc fetch once");
    }
    List<String> lines;
    defer fs_list_free(&lines);
    String_lines(&lock, &lines);
    for (i in 0..lines.size) {
        List<String> fields;
        String_split(&lines.data[i], '\t', &fields);
        if (fields.size >= 3 && String_eq_cstr(&fields.data[0], "ui") == 1) {
            if (String_eq_cstr(&fields.data[1], "git") == 1 && fields.size >= 5) {
                string pkgs = join(eskiu_home(), "pkgs/ui");
                String_from(&self.ui, join(pkgs, fields.data[4].data));
            } else if (String_eq_cstr(&fields.data[1], "path") == 1) {
                if (fields.data[2].data[0] == '/') { String_from(&self.ui, fields.data[2].data); }
                else { String_from(&self.ui, join(dir.data, fields.data[2].data)); }
            }
        }
        fs_list_free(&fields);
    }
    if (self.ui.len == 0) { fail("ui: eskiu.lock has no ui package: eskiuc add ui --git https://github.com/eskiu-lang/ui"); }
}

// build/ui/TARGET, created.
string Project_out(Project* self, string target) {
    string out = join(join(self.root.data, "build/ui"), target);
    fs_mkdir_p(out);
    return out;
}

// The file every host build compiles: the app and the bridge to the hosts.
string Project_entry(Project* self) {
    string build = join(self.root.data, "build/ui");
    fs_mkdir_p(build);
    String text;
    defer String_free(&text);
    String_appendf(&text, "// Made by ui: the app and the bridge to the hosts.\nimport \"%s\";\nimport \"%s\";\n",
        join(self.root.data, "src/main.esk"), join(self.ui.data, "hosts/bridge.esk"));
    string entry = join(build, "entry.esk");
    fs_write_text(entry, text.data);
    return entry;
}

// The project's assets (images and other files the app loads by name) into `dir`.
void Project_copy_assets(Project* self, string dir) {
    string assets = join(self.root.data, "assets");
    if (fs_is_dir(assets) != 1) { return; }
    List<String> names;
    defer fs_list_free(&names);
    fs_list_dir(assets, &names);
    for (i in 0..names.size) { fs_copy(join(assets, names.data[i].data), join(dir, names.data[i].data)); }
}

// ---- web ----

string build_web(Project* p) {
    string out = p.out("web");
    Cmd cmd;
    defer cmd.free();
    cmd.add(eskiuc()); cmd.add(p.entry()); cmd.add("--target"); cmd.add("wasm32-unknown-emscripten");
    cmd.add("-O2"); cmd.add("-o"); cmd.add(join(out, "app.mjs"));
    String library;
    defer String_free(&library);
    String_appendf(&library, "--link-arg=%s", join(p.ui.data, "web/ui-library.js"));
    cmd.add("--link-arg=--js-library"); cmd.add(library.data);
    cmd.add("--link-arg=-sMODULARIZE=1"); cmd.add("--link-arg=-sEXPORT_ES6=1");
    cmd.add("--link-arg=-sALLOW_MEMORY_GROWTH=1"); cmd.add("--link-arg=-sINVOKE_RUN=0");
    cmd.add("--link-arg=--no-entry");
    cmd.add("--link-arg=-sEXPORTED_FUNCTIONS=_ui_start,_ui_dispatch,_ui_dispatch_text,_ui_dispatch_focus,"
            "_ui_dispatch_toggle,_ui_dispatch_scroll,_ui_dispatch_alert,_ui_dispatch_refresh,_ui_report_back,"
            "_ui_report_link,_ui_report_window,_ui_tick,_ui_stop,_ui_conformance_log");
    cmd.add("--link-arg=-sEXPORTED_RUNTIME_METHODS=UTF8ToString,ccall");
    cmd.must(null);
    fs_copy(join(p.ui.data, "web/renderer.mjs"), join(out, "renderer.mjs"));
    fs_copy(join(p.ui.data, "web/scheduler.mjs"), join(out, "scheduler.mjs"));
    String page;
    defer String_free(&page);
    fs_read_text(join(p.ui.data, "web/app.html"), &page);
    String_replace_all(&page, "{{name}}", p.name.data);
    fs_write_text(join(out, "index.html"), page.data);
    p.copy_assets(out);
    return out;
}

// A static file server for build/ui/web: one connection at a time is plenty for a page.
string serve_root;

string content_type(string path) {
    String name;
    defer String_free(&name);
    String_from(&name, path);
    if (String_ends_with(&name, ".html") == 1) { return "text/html; charset=utf-8"; }
    if (String_ends_with(&name, ".mjs") == 1 || String_ends_with(&name, ".js") == 1) { return "text/javascript"; }
    if (String_ends_with(&name, ".wasm") == 1) { return "application/wasm"; }
    if (String_ends_with(&name, ".png") == 1) { return "image/png"; }
    if (String_ends_with(&name, ".jpg") == 1 || String_ends_with(&name, ".jpeg") == 1) { return "image/jpeg"; }
    if (String_ends_with(&name, ".svg") == 1) { return "image/svg+xml"; }
    if (String_ends_with(&name, ".css") == 1) { return "text/css"; }
    if (String_ends_with(&name, ".json") == 1) { return "application/json"; }
    return "application/octet-stream";
}

void serve_one(int client) {
    char[8192] request;
    int64 got = 0;
    while (got < 8191) {
        int64 n = net_recv(client, &request[got], 8191 - got);
        if (n <= 0) { break; }
        got += n;
        request[got] = 0;
        if (strstr((string)&request[0], "\r\n\r\n") != null) { break; }
    }
    request[got] = 0;
    // "GET /path?query HTTP/1.1"
    String path;
    defer String_free(&path);
    int at = 0;
    while (at < got && request[at] != ' ') { at++; }
    at++;
    while (at < got && request[at] != ' ' && request[at] != '?') {
        char[2] one;
        one[0] = request[at]; one[1] = 0;
        String_append(&path, (string)&one[0]);
        at++;
    }
    if (path.len == 0 || String_eq_cstr(&path, "/") == 1) { String_from(&path, "/index.html"); }
    String header;
    defer String_free(&header);
    int64 size = 0;
    *uint8 body = null;
    if (String_contains(&path, "..") != 1) { body = fs_read_all(join(serve_root, &path.data[1]), &size); }
    if (body == null) {
        net_send_str(client, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
    } else {
        String_appendf(&header, "HTTP/1.1 200 OK\r\nContent-Type: %s\r\nContent-Length: %lld\r\n"
            "Cache-Control: no-store\r\nConnection: close\r\n\r\n", content_type(path.data), size);
        net_send_str(client, header.data);
        int64 sent = 0;
        while (sent < size) {
            int64 n = net_send(client, &body[sent], size - sent);
            if (n <= 0) { break; }
            sent += n;
        }
        free(body);
    }
    net_close(client);
}

void serve(string root, int port) {
    serve_root = root;
    int listener = net_tcp_listen((uint16)port);
    if (listener < 0) { fail("ui: cannot listen on the port (set UI_PORT to another one)"); }
    while (true) {
        int client = net_accept(listener);
        if (client >= 0) { serve_one(client); }
    }
}

int port() {
    string value = env_get("UI_PORT");
    return value != null && value[0] != 0 ? atoi(value) : 8765;
}

void open_url(string url) {
    Cmd cmd;
    defer cmd.free();
    cmd.add("open"); cmd.add(url);
    if (cmd.run(null) != 0) { printf("Open %s\n", url); }
}

// ---- macOS ----

string build_macos(Project* p) {
    build_web(p);
    string out = p.out("macos");
    string binary = join(out, p.name.data);
    Cmd cmd;
    defer cmd.free();
    cmd.add("xcrun"); cmd.add("clang"); cmd.add("-fobjc-arc"); cmd.add(join(p.ui.data, "desktop/host.m"));
    cmd.add("-framework"); cmd.add("Cocoa"); cmd.add("-framework"); cmd.add("WebKit"); cmd.add("-o"); cmd.add(binary);
    cmd.must(null);
    return binary;
}

// ---- Yoga, for the native hosts ----

string yoga_source() {
    string dir = join(eskiu_home(), "cache/yoga-3.2.1");
    if (fs_is_dir(join(dir, "yoga")) != 1) {
        fs_mkdir_p(join(eskiu_home(), "cache"));
        Cmd cmd;
        defer cmd.free();
        cmd.add("git"); cmd.add("clone"); cmd.add("--depth"); cmd.add("1"); cmd.add("--branch"); cmd.add(kYogaTag);
        cmd.add(kYogaGit); cmd.add(dir);
        cmd.must(null);
    }
    return dir;
}

// Yoga's objects for one toolchain, compiled once into `cache` (only what changed after).
void yoga_objects(List<string>* compiler, string cache, List<String>* objects) {
    string source = yoga_source();
    fs_mkdir_p(cache);
    List<String> files;
    defer fs_list_free(&files);
    fs_glob(join(source, "yoga/**/*.cpp"), &files);
    for (i in 0..files.size) {
        String name;
        String_from(&name, &files.data[i].data[strlen(source) + 1]);
        String_replace_all(&name, "/", "_");
        String_append(&name, ".o");
        string object = join(cache, name.data);
        if (newer(files.data[i].data, object)) {
            Cmd cmd;
            for (j in 0..compiler.size) { cmd.add(compiler.data[j]); }
            // Upstream Yoga needs C++20; the hosts use C++17.
            cmd.add("-std=c++20"); cmd.add("-I"); cmd.add(source); cmd.add("-c"); cmd.add(files.data[i].data);
            cmd.add("-o"); cmd.add(object);
            cmd.must(null);
            cmd.free();
        }
        String path;
        String_from(&path, object);
        objects.push(path);
    }
}

// ---- iOS (the simulator) ----

string ios_arch() {
    Cmd cmd;
    defer cmd.free();
    cmd.add("uname"); cmd.add("-m");
    String out;
    cmd.output(&out);
    return out.data;
}

string build_ios(Project* p) {
    string out = p.out("ios");
    Cmd find;
    find.add("xcrun"); find.add("--sdk"); find.add("iphonesimulator"); find.add("--show-sdk-path");
    String sdk;
    if (!find.output(&sdk)) { fail("ui: no iOS simulator SDK (install Xcode)"); }
    find.free();
    Cmd tool;
    tool.add("xcrun"); tool.add("--sdk"); tool.add("iphonesimulator"); tool.add("--find"); tool.add("clang++");
    String clang;
    tool.output(&clang);
    tool.free();
    String target;
    String_appendf(&target, "%s-apple-ios15.0-simulator", ios_arch());
    List<string> compiler;
    compiler.push(clang.data); compiler.push("-target"); compiler.push(target.data);
    compiler.push("-isysroot"); compiler.push(sdk.data); compiler.push("-O2");
    List<String> objects;
    yoga_objects(&compiler, join(eskiu_home(), join("cache/yoga-ios", ios_arch())), &objects);
    string host = join(out, "host.o");
    Cmd cmd;
    for (i in 0..compiler.size) { cmd.add(compiler.data[i]); }
    cmd.add("-std=c++17"); cmd.add("-fobjc-arc"); cmd.add("-I"); cmd.add(yoga_source());
    cmd.add("-c"); cmd.add(join(p.ui.data, "ios/host.mm")); cmd.add("-o"); cmd.add(host);
    cmd.must(null);
    cmd.free();
    string app = join(out, "app.o");
    Cmd esk;
    esk.add(eskiuc()); esk.add(p.entry()); esk.add("--target"); esk.add(target.data); esk.add("-O2");
    esk.add("-o"); esk.add(app);
    esk.must(null);
    esk.free();
    String bundle_name;
    String_appendf(&bundle_name, "%s.app", p.name.data);
    string bundle = join(out, bundle_name.data);
    fs_mkdir_p(bundle);
    String plist;
    String_appendf(&plist, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict>\n"
        "<key>CFBundleIdentifier</key><string>%s</string>\n<key>CFBundleName</key><string>%s</string>\n"
        "<key>CFBundleDisplayName</key><string>%s</string>\n<key>CFBundleExecutable</key><string>%s</string>\n"
        "<key>CFBundlePackageType</key><string>APPL</string>\n<key>CFBundleVersion</key><string>1</string>\n"
        "<key>CFBundleShortVersionString</key><string>0.1.0</string>\n<key>LSRequiresIPhoneOS</key><true/>\n"
        "<key>UILaunchScreen</key><dict/>\n<key>UIApplicationSceneManifest</key><dict>\n"
        "<key>UIApplicationSupportsMultipleScenes</key><false/>\n<key>UISceneConfigurations</key><dict>\n"
        "<key>UIWindowSceneSessionRoleApplication</key><array><dict>\n"
        "<key>UISceneConfigurationName</key><string>Default</string>\n"
        "<key>UISceneDelegateClassName</key><string>UiSceneDelegate</string>\n</dict></array></dict></dict>\n"
        "<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>\n</dict></plist>\n",
        p.id.data, p.name.data, p.name.data, p.name.data);
    fs_write_text(join(bundle, "Info.plist"), plist.data);
    p.copy_assets(bundle);
    Cmd link;
    for (i in 0..compiler.size) { link.add(compiler.data[i]); }
    link.add(host); link.add(app);
    for (i in 0..objects.size) { link.add(objects.data[i].data); }
    link.add("-framework"); link.add("UIKit"); link.add("-framework"); link.add("Foundation");
    link.add("-framework"); link.add("CoreGraphics"); link.add("-framework"); link.add("QuartzCore");
    link.add("-o"); link.add(join(bundle, p.name.data));
    link.must(null);
    link.free();
    Cmd sign;
    sign.add("codesign"); sign.add("--force"); sign.add("--sign"); sign.add("-"); sign.add(bundle);
    sign.must(null);
    sign.free();
    return bundle;
}

// A booted simulator, booting the first available iPhone when none is.
void ios_simulator() {
    Cmd list;
    list.add("xcrun"); list.add("simctl"); list.add("list"); list.add("devices"); list.add("available");
    String devices;
    list.output(&devices);
    list.free();
    if (String_contains(&devices, "(Booted)") == 1) { return; }
    List<String> lines;
    String_lines(&devices, &lines);
    for (i in 0..lines.size) {
        String* line = &lines.data[i];
        if (String_contains(line, "iPhone") != 1) { continue; }
        // "    iPhone 18 Pro (UUID) (Shutdown)": the UUID is the first group of 36 characters.
        int64 open = String_index_of(line, '(');
        if (open < 0 || open + 37 > line.len) { continue; }
        String uuid;
        for (int64 j = open + 1; j < open + 37; j++) {
            char[2] one;
            one[0] = line.data[j]; one[1] = 0;
            String_append(&uuid, (string)&one[0]);
        }
        printf("Booting %s\n", line.data);
        Cmd boot;
        boot.add("xcrun"); boot.add("simctl"); boot.add("boot"); boot.add(uuid.data);
        boot.must(null);
        boot.free();
        return;
    }
    fail("ui: no iPhone simulator; add one in Xcode");
}

void run_ios(Project* p) {
    string bundle = build_ios(p);
    ios_simulator();
    // Simulator.app lives inside Xcode, where `open -a` does not always find it by name.
    Cmd developer;
    developer.add("xcode-select"); developer.add("-p");
    String dir;
    developer.output(&dir);
    developer.free();
    Cmd show;
    show.add("open"); show.add("-a"); show.add(join(dir.data, "Applications/Simulator.app"));
    show.run(null);
    show.free();
    Cmd install;
    install.add("xcrun"); install.add("simctl"); install.add("install"); install.add("booted"); install.add(bundle);
    install.must(null);
    install.free();
    Cmd launch;
    launch.add("xcrun"); launch.add("simctl"); launch.add("launch"); launch.add("--terminate-running-process");
    launch.add("booted"); launch.add(p.id.data);
    launch.must(null);
    launch.free();
}

// ---- Android ----

string android_sdk() {
    string sdk = env_get("ANDROID_HOME");
    if (sdk != null && sdk[0] != 0) { return sdk; }
    return join(env_get("HOME"), "Library/Android/sdk");
}

// The last entry (by name) of a directory: the newest NDK, build tools, platform.
string newest(string dir, string prefix) {
    List<String> names;
    defer fs_list_free(&names);
    if (fs_list_dir(dir, &names) != 0) { return null; }
    string best = null;
    for (i in 0..names.size) {
        if (String_starts_with(&names.data[i], prefix) == 1) { best = join(dir, names.data[i].data); }
    }
    return best;
}

string build_android(Project* p) {
    string out = p.out("android");
    string sdk = android_sdk();
    string ndk = env_get("ANDROID_NDK_HOME");
    if (ndk == null || ndk[0] == 0) { ndk = newest(join(sdk, "ndk"), ""); }
    string tools = newest(join(sdk, "build-tools"), "");
    string platform = newest(join(sdk, "platforms"), "android-");
    if (ndk == null || tools == null || platform == null) {
        fail("ui: no Android SDK with an NDK, build tools and a platform (ANDROID_HOME, ANDROID_NDK_HOME)");
    }
    string jar = join(platform, "android.jar");
    string clang = join(ndk, "toolchains/llvm/prebuilt/darwin-x86_64/bin/aarch64-linux-android24-clang++");
    List<string> compiler;
    compiler.push(clang); compiler.push("-fPIC"); compiler.push("-O2");
    List<String> objects;
    yoga_objects(&compiler, join(eskiu_home(), "cache/yoga-android-arm64"), &objects);
    string host = join(out, "host.o");
    Cmd cmd;
    cmd.add(clang); cmd.add("-fPIC"); cmd.add("-O2"); cmd.add("-std=c++17"); cmd.add("-I"); cmd.add(yoga_source());
    cmd.add("-c"); cmd.add(join(p.ui.data, "android/host.cpp")); cmd.add("-o"); cmd.add(host);
    cmd.must(null);
    cmd.free();
    string app = join(out, "app.o");
    Cmd esk;
    esk.add(eskiuc()); esk.add(p.entry()); esk.add("--target"); esk.add("aarch64-linux-android24"); esk.add("-O2");
    esk.add("-o"); esk.add(app);
    esk.must(null);
    esk.free();
    string libs = join(out, "lib/arm64-v8a");
    fs_mkdir_p(libs);
    Cmd link;
    link.add(clang); link.add("-shared"); link.add("-static-libstdc++"); link.add("-Wl,-z,max-page-size=16384");
    link.add(host); link.add(app);
    for (i in 0..objects.size) { link.add(objects.data[i].data); }
    link.add("-llog"); link.add("-o"); link.add(join(libs, "libeskiu_ui.so"));
    link.must(null);
    link.free();
    string classes = join(out, "classes");
    fs_mkdir_p(classes);
    String bootclasspath;
    String_appendf(&bootclasspath, "%s:%s", join(tools, "core-lambda-stubs.jar"), jar);
    Cmd javac;
    javac.add("javac"); javac.add("-nowarn"); javac.add("-source"); javac.add("8"); javac.add("-target"); javac.add("8");
    javac.add("-bootclasspath"); javac.add(bootclasspath.data); javac.add("-d"); javac.add(classes);
    javac.add(join(p.ui.data, "android/UiActivity.java"));
    javac.must(null);
    javac.free();
    List<String> class_files;
    fs_glob(join(classes, "**/*.class"), &class_files);
    Cmd d8;
    d8.add(join(tools, "d8")); d8.add("--min-api"); d8.add("24"); d8.add("--lib"); d8.add(jar);
    d8.add("--output"); d8.add(out);
    for (i in 0..class_files.size) { d8.add(class_files.data[i].data); }
    d8.must(null);
    d8.free();
    // The app's id and label; the activity keeps the class the JNI names are built from.
    String manifest;
    String_appendf(&manifest, "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\" package=\"%s\">\n"
        "  <uses-sdk android:minSdkVersion=\"24\" android:targetSdkVersion=\"35\"/>\n"
        "  <application android:label=\"%s\" android:theme=\"@android:style/Theme.Material.Light.NoActionBar\""
        " android:debuggable=\"true\">\n"
        "    <activity android:name=\"org.eskiu.ui.prototype.UiActivity\" android:exported=\"true\">\n"
        "      <intent-filter><action android:name=\"android.intent.action.MAIN\"/>"
        "<category android:name=\"android.intent.category.LAUNCHER\"/></intent-filter>\n"
        "    </activity>\n  </application>\n</manifest>\n", p.id.data, p.name.data);
    fs_write_text(join(out, "AndroidManifest.xml"), manifest.data);
    string assets = join(out, "assets");
    fs_mkdir_p(assets);
    p.copy_assets(assets);
    string unsigned_apk = join(out, "unsigned.apk");
    Cmd aapt;
    aapt.add(join(tools, "aapt")); aapt.add("package"); aapt.add("-f"); aapt.add("-M"); aapt.add(join(out, "AndroidManifest.xml"));
    aapt.add("-A"); aapt.add(assets); aapt.add("-I"); aapt.add(jar); aapt.add("-F"); aapt.add(unsigned_apk);
    aapt.must(null);
    aapt.free();
    Cmd add;
    add.add(join(tools, "aapt")); add.add("add"); add.add("unsigned.apk"); add.add("classes.dex");
    add.add("lib/arm64-v8a/libeskiu_ui.so");
    add.must(out);
    add.free();
    string aligned = join(out, "aligned.apk");
    Cmd align;
    align.add(join(tools, "zipalign")); align.add("-f"); align.add("-p"); align.add("4"); align.add(unsigned_apk); align.add(aligned);
    align.must(null);
    align.free();
    string keystore = join(eskiu_home(), "ui-debug.keystore");
    if (fs_exists(keystore) != 1) {
        Cmd key;
        key.add("keytool"); key.add("-genkeypair"); key.add("-keystore"); key.add(keystore);
        key.add("-storepass"); key.add("android"); key.add("-keypass"); key.add("android"); key.add("-alias"); key.add("debug");
        key.add("-keyalg"); key.add("RSA"); key.add("-validity"); key.add("10000"); key.add("-dname"); key.add("CN=Eskiu debug");
        key.add("-noprompt");
        key.must(null);
        key.free();
    }
    String apk_name;
    String_appendf(&apk_name, "%s.apk", p.name.data);
    string apk = join(out, apk_name.data);
    Cmd sign;
    sign.add(join(tools, "apksigner")); sign.add("sign"); sign.add("--ks"); sign.add(keystore);
    sign.add("--ks-pass"); sign.add("pass:android"); sign.add("--out"); sign.add(apk); sign.add(aligned);
    sign.must(null);
    sign.free();
    return apk;
}

string adb() { return join(android_sdk(), "platform-tools/adb"); }

// A device, starting the first emulator when none is attached.
void android_device() {
    Cmd list;
    list.add(adb()); list.add("devices");
    String devices;
    list.output(&devices);
    list.free();
    List<String> lines;
    String_lines(&devices, &lines);
    for (i in 1..lines.size) {
        if (String_ends_with(&lines.data[i], "\tdevice") == 1) { return; }
    }
    string emulator = join(android_sdk(), "emulator/emulator");
    Cmd avds;
    avds.add(emulator); avds.add("-list-avds");
    String names;
    if (!avds.output(&names) || names.len == 0) { fail("ui: no Android device or emulator (create one in Android Studio)"); }
    avds.free();
    List<String> avd;
    String_lines(&names, &avd);
    printf("Starting the emulator %s\n", avd.data[0].data);
    List<string> argv;
    argv.push(emulator); argv.push("-avd"); argv.push(avd.data[0].data); argv.push("-no-snapshot-save");
    Process emulator_process;
    ProcessOptions options;
    if (process_spawn(&argv, &options, &emulator_process) != 0) { fail("ui: could not start the emulator"); }
    // Wait for it to boot.
    while (true) {
        time_sleep_ms(2000);
        Cmd prop;
        prop.add(adb()); prop.add("shell"); prop.add("getprop"); prop.add("sys.boot_completed");
        String booted;
        bool ok = prop.output(&booted);
        prop.free();
        if (ok && String_eq_cstr(&booted, "1") == 1) { return; }
    }
}

void run_android(Project* p) {
    string apk = build_android(p);
    android_device();
    Cmd install;
    install.add(adb()); install.add("install"); install.add("-r"); install.add(apk);
    install.must(null);
    install.free();
    String activity;
    String_appendf(&activity, "%s/org.eskiu.ui.prototype.UiActivity", p.id.data);
    Cmd start;
    start.add(adb()); start.add("shell"); start.add("am"); start.add("start"); start.add("-n"); start.add(activity.data);
    start.must(null);
    start.free();
}

// ---- new ----

void create(string name, string ui_path) {
    Cmd make;
    make.add(eskiuc()); make.add("new"); make.add(name);
    make.must(null);
    make.free();
    String main;
    defer String_free(&main);
    String_appendf(&main,
"import <string>;\n"
"import <ui>;\n"
"\n"
"// The root component.\n"
"void App() {\n"
"    Column(Style{grow: 1, padding: 24, gap: 16, background: rgb(245, 246, 250), justify: JustifyCenter,\n"
"                 align: AlignCenter}, void() {\n"
"        *Signal<int> count = use_signal<int>(0);\n"
"        TextWith(Style{font_size: 28, font_weight: 700, color: rgb(17, 24, 39)}, \"%s\");\n"
"        String label;\n"
"        defer String_free(&label);\n"
"        String_format(&label, \"Pressed %%d times\", count.get());\n"
"        TextWith(Style{font_size: 16, color: rgb(107, 114, 128)}, label.data);\n"
"        ButtonWith(Style{background: rgb(79, 70, 229), color: rgb(255, 255, 255), radius: 12, padding: 12,\n"
"                         font_size: 16, font_weight: 600}, \"Press me\", void() { count.set(count.get() + 1); });\n"
"    });\n"
"}\n"
"\n"
"// The hosts call these: mount the app, and free what it owns when it stops.\n"
"void ui_app_start(int which) { ui_mount(void() { App(); }); }\n"
"void ui_app_stop() {}\n", name);
    fs_write_text(join(name, "src/main.esk"), main.data);
    fs_mkdir_p(join(name, "assets"));
    Cmd add;
    add.add(eskiuc()); add.add("add"); add.add("ui");
    if (ui_path != null) { add.add("--path"); add.add(ui_path); }
    else { add.add("--git"); add.add(kUiGit); add.add("--rev"); add.add("main"); }
    add.must(name);
    add.free();
    printf("\nCreated %s. Next:\n  cd %s\n  ui run web      # or macos, ios, android\n", name, name);
}

void usage() {
    println_err("usage: ui new NAME [--ui PATH]\n       ui build web|macos|ios|android\n       ui run web|macos|ios|android");
    exit(2);
}

// The server runs on a thread while the macOS window is open.
string macos_root;
int macos_port;

int main(int argc, string* argv) {
    if (argc < 3) { usage(); }
    String command;
    String_from(&command, argv[1]);
    if (String_eq_cstr(&command, "new") == 1) {
        string ui_path = null;
        if (argc >= 5 && strcmp(argv[3], "--ui") == 0) { ui_path = argv[4]; }
        create(argv[2], ui_path);
        return 0;
    }
    bool run = String_eq_cstr(&command, "run") == 1;
    if (!run && String_eq_cstr(&command, "build") != 1) { usage(); }
    Project p;
    p.find();
    String target;
    String_from(&target, argv[2]);
    if (String_eq_cstr(&target, "web") == 1) {
        string out = build_web(&p);
        printf("Built %s\n", out);
        if (run) {
            String url;
            String_appendf(&url, "http://127.0.0.1:%d/", port());
            printf("Serving %s (Ctrl+C to stop)\n", url.data);
            open_url(url.data);
            serve(out, port());
        }
    } else if (String_eq_cstr(&target, "macos") == 1) {
        string binary = build_macos(&p);
        printf("Built %s\n", binary);
        if (run) {
            macos_root = join(p.root.data, "build/ui/web");
            macos_port = port();
            thread_create(void() { serve(macos_root, macos_port); });
            time_sleep_ms(200);
            String url;
            String_appendf(&url, "http://127.0.0.1:%d/", macos_port);
            Cmd window;
            window.add(binary); window.add(url.data);
            int code = window.run(null);
            window.free();
            exit(code);
        }
    } else if (String_eq_cstr(&target, "ios") == 1) {
        if (run) { run_ios(&p); } else { printf("Built %s\n", build_ios(&p)); }
    } else if (String_eq_cstr(&target, "android") == 1) {
        if (run) { run_android(&p); } else { printf("Built %s\n", build_android(&p)); }
    } else { usage(); }
    return 0;
}
