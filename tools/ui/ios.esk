// iOS: a simulator app bundle; booting, installing and launching it.
// Part of the ui tool (tools/ui/main.esk imports every part).

// ---- iOS (the simulator) ----

// The simulator runs this Mac's architecture, which the tool is built for.
string ios_arch() {
#ifdef __aarch64__
    return "arm64";
#else
    return "x86_64";
#endif
}

// The SDK (iphonesimulator, or iphoneos for a release) and its clang++, from xcrun once,
// then from build/ui/ios/toolchain-SDK while both still exist (xcrun takes a tenth of a
// second a call).
void ios_toolchain(Project* p, string name, String* sdk, String* clang) {
    String file;
    String_appendf(&file, "toolchain-%s", name);
    string cache = join(p.out("ios"), file.data);
    String text;
    defer String_free(&text);
    if (fs_read_text(cache, &text) == 0) {
        List<String> lines;
        String_lines(&text, &lines);
        bool ok = lines.size == 2 && fs_is_dir(lines.data[0].data) == 1 && fs_exists(lines.data[1].data) == 1;
        if (ok) { String_from(sdk, lines.data[0].data); String_from(clang, lines.data[1].data); }
        fs_list_free(&lines);
        if (ok) { return; }
    }
    Cmd find;
    find.add("xcrun"); find.add("--sdk"); find.add(name); find.add("--show-sdk-path");
    if (!find.output(sdk)) { fail("ui: no iOS SDK (install Xcode)"); }
    find.free();
    Cmd tool;
    tool.add("xcrun"); tool.add("--sdk"); tool.add(name); tool.add("--find"); tool.add("clang++");
    tool.output(clang);
    tool.free();
    String_clear(&text);
    String_appendf(&text, "%s\n%s\n", sdk.data, clang.data);
    fs_write_text(cache, text.data);
}

// Under `ui serve` (UI_DEV=1) the app's code is a dylib the running app loads again after each
// build (the host's UI_RELOAD mode), so the app is installed and launched again only when the
// host or the native code changed. build_ios says which in ios_reinstall.
bool ios_reinstall;

bool ios_dev() {
    string dev = env_get("UI_DEV");
    return !ui_release && dev != null && strcmp(dev, "1") == 0;
}

// The file the dev host polls: it holds the newest dylib's path.
string ios_reload_file(Project* p) { return join(p.out("ios"), "reload/current"); }

// A dev build's app code: a bundle linked against the executable (which exports the host's
// functions), named afresh each time since dlopen keeps a path it loaded, and its path in the
// reload file the running app polls. The previous ones go, but for the one the app runs.
void ios_core(Project* p, string out, string app, string executable, List<string>* compiler) {
    string reload = join(out, "reload");
    fs_mkdir_p(reload);
    List<String> old;
    fs_glob(join(reload, "app-*.dylib"), &old);
    String current;
    fs_read_text(ios_reload_file(p), &current);
    String_trim(&current);
    for (i in 0..old.size) {
        if (String_eq_cstr(&old.data[i], current.data == null ? "" : current.data) != 1) { fs_remove(old.data[i].data); }
    }
    fs_list_free(&old);
    String_free(&current);
    String name;
    String_appendf(&name, "app-%lld.dylib", time_now_ms());
    string library = join(reload, name.data);
    Cmd link;
    for (i in 0..compiler.size) { link.add(compiler.data[i]); }
    link.add("-bundle"); link.add("-bundle_loader"); link.add(executable); link.add(app);
    link.add("-o"); link.add(library);
    link.must(null);
    link.free();
    fs_write_text(ios_reload_file(p), library);
}

string build_ios(Project* p) {
    string out = p.out("ios");
    // `ui open ios` makes the Xcode project (Xcode builds the rest); `ui object ios` is the step
    // that project runs before each build.
    if (ui_object) { return ios_object_step(p, out); }
    if (ui_open) { return build_ios_xcode(p, out, null, null); }
    bool dev = ios_dev();
    ios_reinstall = true;
    String sdk;
    String clang;
    // A release is for devices (arm64), a build for this Mac's simulator.
    ios_toolchain(p, ui_release ? "iphoneos" : "iphonesimulator", &sdk, &clang);
    String target;
    if (ui_release) { String_from(&target, "arm64-apple-ios15.0"); }
    else { String_appendf(&target, "%s-apple-ios15.0-simulator", ios_arch()); }
    List<string> compiler;
    compiler.push(clang.data); compiler.push("-target"); compiler.push(target.data);
    compiler.push("-isysroot"); compiler.push(sdk.data); compiler.push("-O2");
    List<String> objects;
    yoga_objects(&compiler, join(eskiu_home(), ui_release ? "cache/yoga-iphoneos-arm64" : join("cache/yoga-ios", ios_arch())), &objects);
    string app = join(out, ui_release ? "app-release.o" : "app.o");
    Cmd esk;
    esk.add(eskiuc()); esk.add(p.entry()); esk.add("--target"); esk.add(target.data); esk.add(ui_release ? "-O2" : app_opt());
    esk.add("-o"); esk.add(app);
    esk.must(null);
    esk.free();
    // Swift Package Manager packages (ui.toml [ios.spm]) and Swift sources need Xcode: the
    // tool makes a project around the app's object. UI_XCODE=1 takes that path without them,
    // and a release always does (Xcode signs it with the team's certificate and profile).
    List<String> packages;
    defer fs_list_free(&packages);
    p.config.names("ios.spm.", &packages);
    List<String> swift;
    defer fs_list_free(&swift);
    p.native("ios", ".swift", &swift);
    string xcode = env_get("UI_XCODE");
    if (ui_release || packages.size > 0 || swift.size > 0 || (xcode != null && strcmp(xcode, "1") == 0)) {
        return build_ios_xcode(p, out, app, &objects);
    }
    // The host and the native code are compiled again only when they changed.
    string host = join(out, dev ? "host-dev.o" : "host.o");
    string header = join(p.ui.data, "hosts/ios/ui_native.h");
    List<string> host_sources;
    defer host_sources.free();
    host_sources.push(join(p.ui.data, "hosts/ios/host.mm")); host_sources.push(header);
    if (stale(host, &host_sources)) {
        Cmd cmd;
        for (i in 0..compiler.size) { cmd.add(compiler.data[i]); }
        cmd.add("-std=c++17"); cmd.add("-fobjc-arc"); cmd.add("-I"); cmd.add(yoga_source());
        if (dev) { cmd.add("-DUI_RELOAD"); }
        cmd.add("-c"); cmd.add(host_sources.data[0]); cmd.add("-o"); cmd.add(host);
        cmd.must(null);
        cmd.free();
        built(host, &host_sources);
    }
    // Native code: native/ios/*.m and *.mm of every package, with ui_native.h on the path.
    List<String> sources;
    defer fs_list_free(&sources);
    p.native("ios", ".m", &sources);
    p.native("ios", ".mm", &sources);
    List<String> native_objects;
    defer fs_list_free(&native_objects);
    for (i in 0..sources.size) {
        String object;
        String_appendf(&object, "%s/native-%s.o", out, native_object_name(sources.data[i].data));
        List<string> inputs;
        inputs.push(sources.data[i].data); inputs.push(header);
        if (stale(object.data, &inputs)) {
            Cmd compile;
            for (j in 0..compiler.size) { compile.add(compiler.data[j]); }
            compile.add("-fobjc-arc"); compile.add("-I"); compile.add(join(p.ui.data, "hosts/ios"));
            if (String_ends_with(&sources.data[i], ".mm") == 1) { compile.add("-std=c++17"); }
            compile.add("-c"); compile.add(sources.data[i].data); compile.add("-o"); compile.add(object.data);
            compile.must(null);
            compile.free();
            built(object.data, &inputs);
        }
        inputs.free();
        native_objects.push(object);
    }
    String bundle_name;
    String_appendf(&bundle_name, "%s.app", p.name.data);
    string bundle = join(out, bundle_name.data);
    fs_mkdir_p(bundle);
    // The bundle is installed again when anything in it changed.
    string executable = join(bundle, p.name.data);
    String plist;
    defer String_free(&plist);
    String_from(&plist, ios_plist(p, "", true));
    String before;
    defer String_free(&before);
    bool plist_changed = fs_read_text(join(bundle, "Info.plist"), &before) != 0 || String_eq_cstr(&before, plist.data) != 1;
    if (plist_changed) { fs_write_text(join(bundle, "Info.plist"), plist.data); }
    p.copy_assets(bundle);
    // The icon: actool compiles its catalog into the bundle, which is signed with the rest.
    string catalog = ios_icon_catalog(p, out);
    string compiled = join(bundle, "Assets.car");
    if (catalog != null) {
        // Its marker sits beside the bundle, so nothing but the icon goes into it.
        string marker = join(out, "icon-compiled.made");
        string image = join(catalog, "AppIcon.appiconset/icon.png");
        if (fs_exists(compiled) != 1 || icon_stale(marker, image)) {
            Cmd actool;
            ios_icon_command(&actool, catalog, bundle, "iphonesimulator", join(out, "icon-partial.plist"));
            actool.must(null);
            actool.free();
            icon_built(marker, image);
        }
    }
    // A dev build links, signs and installs the executable again only when the host, the native
    // code or the Info.plist changed; the app's code goes to its bundle either way.
    List<string> exe_inputs;
    defer exe_inputs.free();
    exe_inputs.push(host);
    for (i in 0..native_objects.size) { exe_inputs.push(native_objects.data[i].data); }
    List<String> asset_files;
    defer fs_list_free(&asset_files);
    fs_glob(join(p.root.data, "assets/**/*"), &asset_files);
    for (i in 0..asset_files.size) { exe_inputs.push(asset_files.data[i].data); }
    if (catalog != null) { exe_inputs.push(compiled); }
    if (dev && !plist_changed && !stale(executable, &exe_inputs)) {
        ios_reinstall = false;
        ios_core(p, out, app, executable, &compiler);
        return bundle;
    }
    Cmd link;
    for (i in 0..compiler.size) { link.add(compiler.data[i]); }
    link.add(host);
    // The dev host takes the app from its dylib, which looks up the host's functions in it.
    if (dev) { link.add("-Wl,-export_dynamic"); } else { link.add(app); }
    for (i in 0..native_objects.size) { link.add(native_objects.data[i].data); }
    for (i in 0..objects.size) { link.add(objects.data[i].data); }
    link.add("-framework"); link.add("UIKit"); link.add("-framework"); link.add("Foundation");
    link.add("-framework"); link.add("CoreGraphics"); link.add("-framework"); link.add("QuartzCore");
    List<string> frameworks;
    defer frameworks.free();
    p.config.all("ios.frameworks", &frameworks);
    for (i in 0..frameworks.size) { link.add("-framework"); link.add(frameworks.data[i]); }
    link.add("-o"); link.add(executable);
    link.must(null);
    link.free();
    Cmd sign;
    sign.add("codesign"); sign.add("--force"); sign.add("--sign"); sign.add("-"); sign.add(bundle);
    sign.must(null);
    sign.free();
    if (dev) {
        built(executable, &exe_inputs);
        ios_core(p, out, app, executable, &compiler);
    }
    return bundle;
}

// Info.plist: the app's id, names and scene, the ui.toml entries, and `classes`, the
// <string> elements of the classes whose +setup the host calls (Swift native code), and
// the device family unless Xcode sets it.
string ios_plist(Project* p, string classes, bool family) {
    String plist;
    String_appendf(&plist, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict>\n"
        "<key>CFBundleIdentifier</key><string>%s</string>\n<key>CFBundleName</key><string>%s</string>\n"
        "<key>CFBundleDisplayName</key><string>%s</string>\n<key>CFBundleExecutable</key><string>%s</string>\n"
        "<key>CFBundlePackageType</key><string>APPL</string>\n<key>CFBundleVersion</key><string>%s</string>\n"
        "<key>CFBundleShortVersionString</key><string>%s</string>\n<key>LSRequiresIPhoneOS</key><true/>\n"
        "<key>UILaunchScreen</key><dict/>\n<key>UIApplicationSceneManifest</key><dict>\n"
        "<key>UIApplicationSupportsMultipleScenes</key><false/>\n<key>UISceneConfigurations</key><dict>\n"
        "<key>UIWindowSceneSessionRoleApplication</key><array><dict>\n"
        "<key>UISceneConfigurationName</key><string>Default</string>\n"
        "<key>UISceneDelegateClassName</key><string>UiSceneDelegate</string>\n</dict></array></dict></dict>\n"
        "<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>\n"
        "<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string>"
        "<string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>\n"
        "<key>UISupportedInterfaceOrientations~ipad</key><array><string>UIInterfaceOrientationPortrait</string>"
        "<string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string>"
        "<string>UIInterfaceOrientationLandscapeRight</string></array>\n"
        "%s<key>UiNativeClasses</key><array>%s</array>\n%s%s</dict></plist>\n",
        p.id.data, p.name.data, xml_escape(p.display.data), p.name.data, xml_escape(app_build(p)), xml_escape(app_version(p)),
        family ? "<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>\n" : "",
        classes, ios_plist_entries(p), ios_icon_plist(p));
    return plist.data;
}

// The ui.toml [ios.plist] entries as plist keys and strings.
string ios_plist_entries(Project* p) {
    List<String> keys;
    p.config.names("ios.plist.", &keys);
    String out;
    // The app's URL scheme (ui.toml [app] scheme): links like SCHEME://route open it.
    string scheme = p.config.string("app.scheme");
    if (scheme != null) {
        String_appendf(&out, "<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key>"
            "<array><string>%s</string></array></dict></array>\n", xml_escape(scheme));
    }
    for (i in 0..keys.size) {
        String key;
        String_appendf(&key, "ios.plist.%s", keys.data[i].data);
        String_appendf(&out, "<key>%s</key><string>%s</string>\n", xml_escape(keys.data[i].data),
            xml_escape(p.config.string(key.data)));
        String_free(&key);
    }
    fs_list_free(&keys);
    return out.data == null ? "" : out.data;
}

// The dev app is running: the pid it wrote next to the reload file is alive (a simulator app
// is a process of this Mac).
bool ios_running(Project* p) {
    String text;
    defer String_free(&text);
    if (fs_read_text(join(p.out("ios"), "reload/pid"), &text) != 0) { return false; }
    int pid = atoi(text.data);
    return pid > 0 && kill(pid, 0) == 0;
}

// A booted simulator, booting the first available iPhone when none is.
void ios_simulator() {
    Cmd list;
    list.add("xcrun"); list.add("simctl"); list.add("list"); list.add("devices"); list.add("available");
    String devices;
    list.output(&devices);
    list.free();
    if (String_contains(&devices, "(Booted)") == 1) { return; }
    List<String> lines;
    String_lines(&devices, &lines);
    for (i in 0..lines.size) {
        String* line = &lines.data[i];
        if (String_contains(line, "iPhone") != 1) { continue; }
        // "    iPhone 18 Pro (UUID) (Shutdown)": the UUID is the first group of 36 characters.
        int64 open = String_index_of(line, '(');
        if (open < 0 || open + 37 > line.len) { continue; }
        String uuid;
        for (int64 j = open + 1; j < open + 37; j++) {
            char[2] one;
            one[0] = line.data[j]; one[1] = 0;
            String_append(&uuid, (string)&one[0]);
        }
        printf("Booting %s\n", line.data);
        Cmd boot;
        boot.add("xcrun"); boot.add("simctl"); boot.add("boot"); boot.add(uuid.data);
        boot.must(null);
        boot.free();
        return;
    }
    fail("ui: no iPhone simulator; add one in Xcode");
}

void run_ios(Project* p) {
    string bundle = build_ios(p);
    // A dev build the running app picks up itself.
    if (!ios_reinstall && ios_running(p)) {
        println("Restarted the app on the new build");
        return;
    }
    ios_simulator();
    // The simulator's window: Simulator.app inside Xcode, DeviceHub.app from Xcode 27.
    Cmd developer;
    developer.add("xcode-select"); developer.add("-p");
    String dir;
    developer.output(&dir);
    developer.free();
    String contents;
    path_dirname(&contents, dir.data);
    List<string> apps;
    apps.push(join(dir.data, "Applications/Simulator.app"));
    apps.push(join(contents.data, "Applications/DeviceHub.app"));
    for (i in 0..apps.size) {
        if (fs_is_dir(apps.data[i]) != 1) { continue; }
        Cmd show;
        show.add("open"); show.add("-a"); show.add(apps.data[i]);
        String ignored;
        show.output(&ignored);
        show.free();
        break;
    }
    apps.free();
    Cmd install;
    install.add("xcrun"); install.add("simctl"); install.add("install"); install.add("booted"); install.add(bundle);
    install.must(null);
    install.free();
    Cmd launch;
    launch.add("xcrun"); launch.add("simctl"); launch.add("launch"); launch.add("--terminate-running-process");
    launch.add("booted"); launch.add(p.id.data);
    if (ios_dev()) {
        // The dev host finds the reload file through its environment (simctl passes SIMCTL_CHILD_*).
        String value;
        String_appendf(&value, "SIMCTL_CHILD_UI_RELOAD_FILE=%s", ios_reload_file(p));
        List<string> env;
        env.push(value.data);
        List<string> argv;
        for (i in 0..launch.parts.size) { argv.push(launch.parts.data[i].data); }
        ProcessOptions options = ProcessOptions{env: &env, inherit_stdout: true, inherit_stderr: true};
        ProcessResult result;
        if (process_run(&argv, &options, &result) != 0 || result.exit_code != 0) { fail("ui: failed: xcrun simctl launch"); }
        ProcessResult_free(&result);
        argv.free(); env.free();
        launch.free();
        return;
    }
    launch.must(null);
    launch.free();
}
