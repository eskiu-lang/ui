// The web: the wasm build, and a static server for `ui run web`.
// Part of the ui tool (tools/ui/main.esk imports every part).

// ---- web ----

string build_web(Project* p) {
    string out = p.out("web");
    Cmd cmd;
    defer cmd.free();
    cmd.add(eskiuc()); cmd.add(p.entry()); cmd.add("--target"); cmd.add("wasm32-unknown-emscripten");
    cmd.add(app_opt()); cmd.add("-o"); cmd.add(join(out, "app.mjs"));
    String library;
    defer String_free(&library);
    String_appendf(&library, "--link-arg=%s", join(p.ui.data, "hosts/web/ui-library.js"));
    cmd.add("--link-arg=--js-library"); cmd.add(library.data);
    // Native modules: each native/web/*.js is an emscripten library (the externs it defines).
    List<String> libraries;
    defer fs_list_free(&libraries);
    p.native("web", ".js", &libraries);
    for (i in 0..libraries.size) {
        String arg;
        String_appendf(&arg, "--link-arg=%s", libraries.data[i].data);
        cmd.add("--link-arg=--js-library"); cmd.add(arg.data);
        String_free(&arg);
    }
    cmd.add("--link-arg=-sMODULARIZE=1"); cmd.add("--link-arg=-sEXPORT_ES6=1");
    cmd.add("--link-arg=-sALLOW_MEMORY_GROWTH=1"); cmd.add("--link-arg=-sINVOKE_RUN=0");
    cmd.add("--link-arg=--no-entry");
    // A dev build exports the driver's entry points too (hosts/web/driver.mjs).
    bool test = ui_test_build();
    String exported;
    defer String_free(&exported);
    String_append(&exported, "--link-arg=-sEXPORTED_FUNCTIONS=_ui_start,_ui_dispatch,_ui_dispatch_text,_ui_dispatch_focus,"
            "_ui_dispatch_toggle,_ui_dispatch_scroll,_ui_dispatch_alert,_ui_dispatch_refresh,_ui_report_back,"
            "_ui_report_link,_ui_report_window,_ui_tick,_ui_stop,_ui_conformance_log,_ui_dispatch_native,"
            "_ui_dispatch_view,_ui_dispatch_route,_ui_dispatch_layout,_ui_dispatch_timer,_ui_dispatch_frame,_ui_dispatch_hover,_ui_dispatch_long_press,_ui_dispatch_value,_ui_report_appearance,_ui_report_accessibility,_ui_report_locale,_ui_dispatch_answer,_ui_dispatch_fetch,_ui_dispatch_pan,_malloc,_free");
    if (test) { String_append(&exported, ",_ui_driver,_ui_driver_done,_ui_driver_time,_ui_reload_save,_ui_reload_restore"); }
    cmd.add(exported.data);
    cmd.add(test ? "--link-arg=-sEXPORTED_RUNTIME_METHODS=UTF8ToString,ccall,stringToUTF8,lengthBytesUTF8,HEAPU8"
                 : "--link-arg=-sEXPORTED_RUNTIME_METHODS=UTF8ToString,ccall,stringToUTF8,lengthBytesUTF8");
    cmd.must(null);
    fs_copy(join(p.ui.data, "hosts/web/renderer.mjs"), join(out, "renderer.mjs"));
    fs_copy(join(p.ui.data, "hosts/web/scheduler.mjs"), join(out, "scheduler.mjs"));
    string driver = join(out, "driver.mjs");
    if (test) { fs_copy(join(p.ui.data, "hosts/web/driver.mjs"), driver); } else { fs_remove_all(driver); }
    write_web_native(p, out);
    String page;
    defer String_free(&page);
    fs_read_text(join(p.ui.data, "hosts/web/app.html"), &page);
    String_replace_all(&page, "{{name}}", xml_escape(p.display.data));
    // Where the app is served from (ui.toml [web] base), for the routes' URLs.
    string base = p.config.string("web.base");
    String_replace_all(&page, "{{base}}", xml_escape(base != null ? base : "/"));
    String_replace_all(&page, "{{icons}}", web_icon_links(p, out));
    String_replace_all(&page, "{{splash}}", web_splash(p, out));
    // A dev build starts on the state the page had before `ui serve` reloaded it: the serve
    // script saves it in sessionStorage (src/core/reload.esk).
    String_replace_all(&page, "{{reload}}", test
        ? "  globalThis.uiReloadSave = () => app.ccall('ui_reload_save', 'string', [], []);\n"
          "  try {\n"
          "    const kept = sessionStorage.getItem('ui-reload');\n"
          "    sessionStorage.removeItem('ui-reload');\n"
          "    if (kept) app.ccall('ui_reload_restore', null, ['string'], [kept]);\n"
          "  } catch {}\n" : "");
    String_replace_all(&page, "{{driver}}", test
        ? "  // A dev build: `ui agent web` drives the page through the dev server.\n"
          "  (await import('./driver.mjs')).startDriver({app, host});\n" : "");
    fs_write_text(join(out, "index.html"), page.data);
    p.copy_assets(out);
    return out;
}

// native.mjs: imports each native/web/*.mjs and calls its setup(ui), where ui is
// {registerView(type, factory), emit(channel, payload)}. The modules of each native/web
// directory (the app's, each package's) are copied together to native/N/ under their own
// names, so one can import another (`import {f} from './helpers.mjs'`).
void write_web_native(Project* p, string out) {
    List<String> modules;
    defer fs_list_free(&modules);
    p.native("web", ".mjs", &modules);
    string dir = join(out, "native");
    fs_remove_all(dir);
    List<String> dirs;
    defer fs_list_free(&dirs);
    String text;
    defer String_free(&text);
    String_append(&text, "// Made by ui: the app's native web modules.\n");
    for (i in 0..modules.size) {
        String name;
        String parent;
        path_basename(&name, modules.data[i].data);
        path_dirname(&parent, modules.data[i].data);
        int at = -1;
        for (j in 0..dirs.size) { if (String_eq(&dirs.data[j], &parent) == 1) { at = j; } }
        if (at < 0) { at = dirs.size; String kept; String_from(&kept, parent.data); dirs.push(kept); }
        String into;
        String_format(&into, "%d", at);
        fs_mkdir_p(join(dir, into.data));
        String_appendf(&into, "/%s", name.data);
        fs_copy(modules.data[i].data, join(dir, into.data));
        String_appendf(&text, "import * as m%d from './native/%s';\n", i, into.data);
        String_free(&name); String_free(&parent); String_free(&into);
    }
    String_append(&text, "export function setupNative(ui) {\n");
    for (i in 0..modules.size) { String_appendf(&text, "  m%d.setup?.(ui);\n", i); }
    String_append(&text, "}\n");
    fs_write_text(join(out, "native.mjs"), text.data);
}

#ifndef _WIN32
// fcntl(fd, F_SETFD, FD_CLOEXEC) marks a descriptor close-on-exec.
extern int fcntl(int fd, int command, ...);
#endif

// A static file server for build/ui/web: one connection at a time is plenty for a page.
string serve_root;

// Under `ui serve`: the page's requests and its waits for the next build (/__ui/).
bool serve_dev;

int serve_port;

int serve_listener;


string content_type(string path) {
    String name;
    defer String_free(&name);
    String_from(&name, path);
    if (String_ends_with(&name, ".html") == 1) { return "text/html; charset=utf-8"; }
    if (String_ends_with(&name, ".mjs") == 1 || String_ends_with(&name, ".js") == 1) { return "text/javascript"; }
    if (String_ends_with(&name, ".wasm") == 1) { return "application/wasm"; }
    if (String_ends_with(&name, ".png") == 1) { return "image/png"; }
    if (String_ends_with(&name, ".jpg") == 1 || String_ends_with(&name, ".jpeg") == 1) { return "image/jpeg"; }
    if (String_ends_with(&name, ".svg") == 1) { return "image/svg+xml"; }
    if (String_ends_with(&name, ".css") == 1) { return "text/css"; }
    if (String_ends_with(&name, ".json") == 1) { return "application/json"; }
    return "application/octet-stream";
}

void serve_one(int client) {
    // The request line and headers, and a body as long as its Content-Length (the driver's
    // requests and answers are posted).
    String request;
    defer String_free(&request);
    char[8192] chunk;
    int64 header_end = -1;
    while (header_end < 0 && request.len < 65536) {
        int64 n = net_recv(client, &chunk[0], 8191);
        if (n <= 0) { break; }
        chunk[n] = 0;
        for (int64 i = 0; i < n; i++) { String_push(&request, chunk[i]); }
        header_end = String_find(&request, "\r\n\r\n", 0);
    }
    String body_in;
    defer String_free(&body_in);
    if (header_end >= 0) {
        int64 length = 0;
        String lower;
        String_substring(&request, &lower, 0, header_end);
        String_lower(&lower);
        int64 at_length = String_find(&lower, "\r\ncontent-length:", 0);
        if (at_length >= 0) { length = (int64)atoi(&lower.data[at_length + 17]); }
        String_free(&lower);
        String_substring(&request, &body_in, header_end + 4, request.len - header_end - 4);
        while (body_in.len < length && length < 64 * 1024 * 1024) {
            int64 n = net_recv(client, &chunk[0], 8191);
            if (n <= 0) { break; }
            for (int64 i = 0; i < n; i++) { String_push(&body_in, chunk[i]); }
        }
    }
    int64 got = request.len;
    string raw = request.data == null ? "" : request.data;
    // "GET /path?query HTTP/1.1"
    String path;
    defer String_free(&path);
    String query;
    defer String_free(&query);
    int at = 0;
    while (at < got && raw[at] != ' ') { at++; }
    at++;
    while (at < got && raw[at] != ' ' && raw[at] != '?') { String_push(&path, raw[at]); at++; }
    if (at < got && raw[at] == '?') {
        at++;
        while (at < got && raw[at] != ' ') { String_push(&query, raw[at]); at++; }
    }
    if (serve_dev && String_starts_with(&path, "/__ui/") == 1) {
        serve_dev_request(client, &path, &query, &body_in);
        net_close(client);
        return;
    }
    if (path.len == 0 || String_eq_cstr(&path, "/") == 1) { String_from(&path, "/index.html"); }
    String header;
    defer String_free(&header);
    int64 size = 0;
    *uint8 body = null;
    if (String_contains(&path, "..") != 1) { body = fs_read_all(join(serve_root, &path.data[1]), &size); }
    // A route the app shows (/tasks/42) is the page itself, as on any host set up for one.
    String last;
    path_basename(&last, path.data);
    if (body == null && String_contains(&last, ".") != 1) {
        body = fs_read_all(join(serve_root, "index.html"), &size);
        String_from(&path, "/index.html");
    }
    String_free(&last);
    // Under `ui serve`, the page waits for the next build.
    String page;
    defer String_free(&page);
    if (serve_dev && String_eq_cstr(&path, "/index.html") == 1) {
        if (body != null) { free(body); }
        serve_page(join(serve_root, "index.html"), &page);
        body = (*uint8)page.data;
        size = page.len;
    }
    if (body == null) {
        net_send_str(client, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
    } else {
        String_appendf(&header, "HTTP/1.1 200 OK\r\nContent-Type: %s\r\nContent-Length: %lld\r\n"
            "Cache-Control: no-store\r\nConnection: close\r\n\r\n", content_type(path.data), size);
        net_send_str(client, header.data);
        int64 sent = 0;
        while (sent < size) {
            int64 n = net_send(client, &body[sent], size - sent);
            if (n <= 0) { break; }
            sent += n;
        }
        if (body != (*uint8)page.data) { free(body); }
    }
    net_close(client);
}

void serve(string root, int port) {
    serve_root = root;
    int listener = net_tcp_listen((uint16)port);
    if (listener < 0) { fail("ui: cannot listen on the port (set UI_PORT to another one)"); }
    while (true) {
        int client = net_accept(listener);
        if (client >= 0) { serve_one(client); }
    }
}

// serve_root on serve_port from threads that each take one connection at a time, so a page
// waiting for a build does not hold the others up; returns once it listens.
void serve_listen() {
    serve_listener = net_tcp_listen((uint16)serve_port);
    if (serve_listener < 0) { fail("ui: cannot listen on the port (set UI_PORT to another one)"); }
#ifndef _WIN32
    // Not inherited by the builds it runs: a build still running when ui serve stops would
    // keep the port, and the next ui serve could not listen.
    fcntl(serve_listener, 2, 1);
#endif
    for (i in 0..8) {
        thread_create(void() {
            while (true) {
                int client = net_accept(serve_listener);
                if (client >= 0) { serve_one(client); }
            }
        });
    }
}

int port() {
    string value = env_get("UI_PORT");
    return value != null && value[0] != 0 ? atoi(value) : 8765;
}

void open_url(string url) {
    // UI_NO_OPEN=1: no browser (`ui agent` opens its own).
    string no_open = env_get("UI_NO_OPEN");
    if (no_open != null && strcmp(no_open, "1") == 0) { return; }
    Cmd cmd;
    defer cmd.free();
    cmd.add("open"); cmd.add(url);
    if (cmd.run(null) != 0) { printf("Open %s\n", url); }
}
