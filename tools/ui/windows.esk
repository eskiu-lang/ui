// Windows: the web build in a WebView2 window.
// Part of the ui tool (tools/ui/main.esk imports every part).

// ---- Windows ----

// The WebView2 SDK (its NuGet package): the header the host compiles with and the loader
// DLL that goes next to the executable.
const string kWebView2Version = "1.0.4258.31";
const string kWebView2Sha256 = "56f7f4b8bf9aee4b8efefbbdd4f67d5f74ebd1b100ed0806da71bf76af481aa9";

string webview2_sdk() {
    String dir;
    String_appendf(&dir, "%s/cache/webview2-%s", eskiu_home(), kWebView2Version);
    String url;
    String_appendf(&url, "https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/%s/microsoft.web.webview2.%s.nupkg",
        kWebView2Version, kWebView2Version);
    fetch_archive("the WebView2 SDK", url.data, kWebView2Sha256, dir.data);
    return dir.data;
}

// The C++ compiler for the host: $CXX, else MSVC's cl.exe when it is on PATH, else MinGW's.
// `msvc` says whether it takes cl's options (cl.exe and clang-cl, by the file's name).
string windows_cxx(bool* msvc) {
    string cxx = env_get("CXX");
    if (cxx == null || cxx[0] == 0) {
        Cmd where;
        where.add("where"); where.add("cl.exe");
        String found;
        if (where.output(&found)) { cxx = "cl"; }
        else {
            Cmd which;
            which.add("x86_64-w64-mingw32-g++"); which.add("--version");
            String said;
            cxx = which.output(&said) ? "x86_64-w64-mingw32-g++" : "g++";
            which.free();
        }
        where.free();
    }
    String base;
    path_basename(&base, cxx);
    String_lower(&base);
    *msvc = String_eq_cstr(&base, "cl") == 1 || String_eq_cstr(&base, "cl.exe") == 1
        || String_eq_cstr(&base, "clang-cl") == 1 || String_eq_cstr(&base, "clang-cl.exe") == 1;
    return cxx;
}

string build_windows(Project* p) {
    build_web(p);
    string out = p.out("windows");
    String exe_name;
    defer String_free(&exe_name);
    String_appendf(&exe_name, "%s.exe", p.name.data);
    string binary = join(out, exe_name.data);
    string sdk = webview2_sdk();
    string include = join(sdk, "build/native/include");
    bool msvc = false;
    string cxx = windows_cxx(&msvc);
    Cmd cmd;
    defer cmd.free();
    cmd.add(cxx);
    // A windowed program (no console) with its C++ runtime inside, for machines without MinGW.
    if (msvc) {
        cmd.add("/nologo"); cmd.add("/EHsc"); cmd.add("/std:c++17"); cmd.add("/O2"); cmd.add("/utf-8");
        if (ui_release) { cmd.add("/DUI_RELEASE"); }
        String inc;
        String_appendf(&inc, "/I%s", include);
        cmd.add(inc.data);
        String obj;
        String_appendf(&obj, "/Fo%s\\", out);
        cmd.add(obj.data);
        cmd.add(join(p.ui.data, "hosts/windows/host.cpp"));
        cmd.add("/link"); cmd.add("/SUBSYSTEM:WINDOWS");
        cmd.add("user32.lib"); cmd.add("ole32.lib"); cmd.add("shell32.lib"); cmd.add("shlwapi.lib"); cmd.add("uuid.lib");
        String out_flag;
        String_appendf(&out_flag, "/OUT:%s", binary);
        cmd.add(out_flag.data);
    } else {
        cmd.add("-std=c++17"); cmd.add("-O2"); cmd.add("-mwindows");
        if (ui_release) { cmd.add("-DUI_RELEASE"); }
        cmd.add("-I"); cmd.add(include);
        cmd.add(join(p.ui.data, "hosts/windows/host.cpp"));
        cmd.add("-static"); cmd.add("-static-libgcc"); cmd.add("-static-libstdc++");
        cmd.add("-lole32"); cmd.add("-luser32"); cmd.add("-lshell32"); cmd.add("-lshlwapi"); cmd.add("-luuid");
        cmd.add("-o"); cmd.add(binary);
    }
    if (cmd.run(null) != 0) {
        fail("ui build windows: the host did not compile. It needs MSVC (cl.exe, from a Developer prompt) or MinGW-w64 "
             "(g++, or x86_64-w64-mingw32-g++ to build from macOS or Linux); set CXX to choose one.");
    }
    // The loader the host opens, for the machine's architecture.
    fs_copy(join(sdk, "build/native/x64/WebView2Loader.dll"), join(out, "WebView2Loader.dll"));
    string web_out = join(p.root.data, "build/ui/web");
    fs_remove_all(join(out, "web"));
    copy_dir_all(web_out, join(out, "web"));
    windows_icon(p, out);
    return binary;
}
