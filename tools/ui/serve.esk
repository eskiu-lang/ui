// `ui serve`: build, then build again after each change to the sources and reload the app. A
// page (the web, the macOS window) waits on the server for the next build and reloads, or
// shows a failed build's errors over the app; a simulator or device gets the app installed
// and launched again.
// Part of the ui tool (tools/ui/main.esk imports every part).


// The builds so far, and the last one's output when it failed ("" when it built). The pages'
// requests read them on the server's threads.
int serve_version;
Mutex serve_lock;
String serve_error;

// Whether a build is running, and the project being served (for `ui agent`).
bool serve_building;
string serve_project_root;

// What the sources were when the last build started (serve_signature), for `ui agent`.
uint64 serve_built_source;

// `ui agent` finds a running `ui serve` and its last build in build/ui/serve-TARGET.json:
// {"pid", "port", "version", "building", "error"}.
string serve_status_path;
int serve_status_port;

void serve_write_status() {
    if (serve_status_path == null) { return; }
    String text;
    defer String_free(&text);
    Mutex_lock(&serve_lock);
    String_appendf(&text, "{\"pid\": %d, \"port\": %d, \"version\": %d, \"building\": %s, \"source\": \"%016llx\", \"error\": ",
        process_pid(), serve_status_port, atomic_load(&serve_version), serve_building ? "true" : "false", serve_built_source);
    serve_json_string(&text, serve_error.data == null ? "" : serve_error.data);
    String_append(&text, "}\n");
    Mutex_unlock(&serve_lock);
    String tmp;
    defer String_free(&tmp);
    String_appendf(&tmp, "%s.tmp", serve_status_path);
    fs_write_text(tmp.data, text.data);
    fs_rename(tmp.data, serve_status_path);
}

// A hash of what a build reads, mixed into serve_sum by serve_signature.
uint64 serve_sum;
int64 serve_now;

void serve_mix(*uint8 data, int64 size) {
    for (int64 i = 0; i < size; i++) {
        serve_sum = (serve_sum ^ (uint64)data[i]) * 1099511628211;
    }
}

void serve_mix_text(string text) { serve_mix((*uint8)text, (int64)strlen(text)); }

// Each file's size, mtime and content hash at the last look.
struct ServeFile { int64 size; int64 mtime; uint64 hash; }

Map<ServeFile> serve_files;

bool serve_files_ready;

// A file by its path and content: its content is read again when its size or mtime changed,
// or when it changed in the last few seconds (mtime has whole seconds, so a second save within
// the same second has the same one).
void serve_mix_file(string path) {
    FileStat st;
    if (fs_stat(path, &st) != 0 || !st.is_file) { return; }
    if (!serve_files_ready) { Map_init<ServeFile>(&serve_files, 64); serve_files_ready = true; }
    int created = 0;
    *ServeFile known = Map_at<ServeFile>(&serve_files, path, &created);
    if (created == 1 || known.size != st.size || known.mtime != st.mtime || st.mtime >= serve_now - 3) {
        uint64 sum = serve_sum;
        serve_sum = 1469598103934665603;
        int64 size = 0;
        *uint8 body = fs_read_all(path, &size);
        if (body != null) { serve_mix(body, size); free(body); }
        *known = ServeFile{st.size, st.mtime, serve_sum};
        serve_sum = sum;
    }
    serve_mix_text(path);
    serve_mix((*uint8)&known.hash, 8);
}

// The file `name` in `dir`, as serve_mix_file.
void serve_mix_named(string dir, string name) {
    string path = join(dir, name);
    serve_mix_file(path);
    free(path);
}

// Every package's src, native, hosts and assets, and the app's ui.toml, eskiu.toml and lock.
uint64 serve_signature(Project* p) {
    serve_sum = 1469598103934665603;
    serve_now = time_now_ms() / 1000;
    for (i in 0..p.roots.size) {
        string root = p.roots.data[i].data;
        List<string> dirs;
        dirs.push("src"); dirs.push("native"); dirs.push("hosts"); dirs.push("assets");
        for (j in 0..dirs.size) {
            string dir = join(root, dirs.data[j]);
            if (fs_is_dir(dir) == 1) {
                fs_walk(dir, void(string path, bool is_dir) { if (!is_dir) { serve_mix_file(path); } });
            }
            free(dir);
        }
        dirs.free();
        serve_mix_named(root, "ui.toml");
        serve_mix_named(root, "eskiu.toml");
    }
    serve_mix_named(p.root.data, "eskiu.lock");
    return serve_sum;
}

// A line on standard output now: under `ui serve` it is often a pipe or a file.
void serve_say(string line) {
    println(line);
    fflush(null);
}

// One build in a child (`ui build web`, `ui run ios`...), its output on ours; true if it built.
bool serve_build(string command, string target) {
    int64 start = time_monotonic_ms();
    serve_building = true;
    serve_write_status();
    List<string> argv;
    defer argv.free();
    argv.push(serve_self); argv.push(command); argv.push(target);
    // --json: the build's diagnostics come back as JSON lines, passed on as they are.
    if (ui_json) { argv.push("--json"); }
    // UI_DEV=1: the app's code at -O0, which builds about four times faster.
    List<string> env;
    defer env.free();
    env.push("UI_DEV=1");
    // Android: the device's ABI, asked once (after the first build, which may start the
    // emulator) instead of once per build.
    String abi;
    defer String_free(&abi);
    if (strcmp(target, "android") == 0 && android_abi_name != null) {
        String_appendf(&abi, "UI_ANDROID_ABI=%s", android_abi_name);
        env.push(abi.data);
    }
    ProcessOptions options = ProcessOptions{env: &env, merge_stderr: true};
    ProcessResult result;
    defer ProcessResult_free(&result);
    bool ok = process_run(&argv, &options, &result) == 0 && result.exit_code == 0;
    string output = result.stdout.data == null ? "" : result.stdout.data;
    String shown;
    defer String_free(&shown);
    if (ui_json) {
        // The JSON lines on our standard output, the rest on standard error; the page and
        // `ui agent` get the text form.
        serve_pass_json(output);
        if (!ok) { diag_json_to_text(output, &shown); }
    } else { print(output); }
    // The page shows the compiler's output, without the tool's line naming the command.
    if (!ok && !ui_json) {
        List<String> lines;
        String_lines(&result.stdout, &lines);
        for (i in 0..lines.size) {
            if (String_starts_with(&lines.data[i], "ui: failed: ") == 1) { continue; }
            String_appendf(&shown, "%s\n", lines.data[i].data);
        }
        fs_list_free(&lines);
    }
    if (!ok && shown.len == 0) { String_from(&shown, "ui: the build failed"); }
    Mutex_lock(&serve_lock);
    String_from(&serve_error, ok ? "" : shown.data);
    Mutex_unlock(&serve_lock);
    atomic_fetch_add(&serve_version, 1);
    serve_building = false;
    serve_write_status();
    double seconds = (double)(time_monotonic_ms() - start) / 1000.0;
    if (ok && strcmp(target, "android") == 0) { android_abi(); }
    if (ui_json) { printf("{\"event\": \"%s\", \"seconds\": %.3f}\n", ok ? "built" : "failed", seconds); fflush(null); }
    else if (ok) { printf("ui: built in %.1f s\n", seconds); fflush(null); }
    else { println_err("ui: the build failed; waiting for a change"); }
    return ok;
}

// A child build's output under --json: its JSON lines to standard output, as they are, and
// any other line to standard error.
void serve_pass_json(string output) {
    String all;
    defer String_free(&all);
    String_from(&all, output);
    List<String> lines;
    defer fs_list_free(&lines);
    String_lines(&all, &lines);
    for (i in 0..lines.size) {
        if (lines.data[i].len == 0) { continue; }
        if (lines.data[i].data[0] == '{') { println(lines.data[i].data); } else { println_err(lines.data[i].data); }
    }
    fflush(null);
}

// A line on standard output: the text, or under --json an event {"event": NAME, "message":
// TEXT}.
void serve_note(string event, string text) {
    if (!ui_json) { serve_say(text); return; }
    String line;
    defer String_free(&line);
    String_appendf(&line, "{\"event\": \"%s\", \"message\": ", event);
    diag_json_string(&line, text);
    String_append(&line, "}");
    serve_say(line.data);
}

// Build again whenever the sources differ from `seen` (taken before the first build, so a
// change made during it is not missed), until the tool is stopped.
void serve_watch(Project* p, string command, string target, uint64 seen) {
    while (true) {
        // A look costs a stat of each source (and a read of the few changed in the last
        // seconds), so it can be often: a change is seen within 50 ms.
        time_sleep_ms(50);
        uint64 now = serve_signature(p);
        if (now == seen) { continue; }
        // An editor may write a file in steps: build once it holds still for 50 ms.
        while (true) {
            time_sleep_ms(50);
            uint64 settled = serve_signature(p);
            if (settled == now) { break; }
            now = settled;
        }
        seen = now;
        serve_built_source = now;
        serve_note("building", "ui: changed, building");
        serve_build(command, target);
    }
}

// `text` as a JSON string, appended to `out`.
void serve_json_string(String* out, string text) {
    String_append(out, "\"");
    for (int64 i = 0; text[i] != 0; i++) {
        uint8 c = (uint8)text[i];
        if (c == '"') { String_append(out, "\\\""); }
        else if (c == '\\') { String_append(out, "\\\\"); }
        else if (c == '\n') { String_append(out, "\\n"); }
        else if (c == '\t') { String_append(out, "\\t"); }
        else if (c < 32) { String_appendf(out, "\\u%04x", (int)c); }
        else { String_push(out, (char)c); }
    }
    String_append(out, "\"");
}

// GET /__ui/wait?v=N: the build after N, once there is one (or the current one after 25 s, so
// the request never outlives a proxy's patience): {"version": V, "error": "..."}.
void serve_wait(int client, int after) {
    int64 until = time_monotonic_ms() + 25000;
    while (atomic_load(&serve_version) == after && time_monotonic_ms() < until) { time_sleep_ms(10); }
    String body;
    defer String_free(&body);
    Mutex_lock(&serve_lock);
    String_appendf(&body, "{\"version\": %d, \"error\": ", atomic_load(&serve_version));
    serve_json_string(&body, serve_error.data == null ? "" : serve_error.data);
    Mutex_unlock(&serve_lock);
    String_append(&body, "}");
    String header;
    defer String_free(&header);
    String_appendf(&header, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %lld\r\n"
        "Cache-Control: no-store\r\nConnection: close\r\n\r\n", body.len);
    net_send_str(client, header.data);
    net_send_str(client, body.data);
}

// The script `ui serve` adds to the page: it waits for each build, reloads after one that
// built (keeping the app's routes and signals for the new page, src/core/reload.esk), and
// shows one that failed over the app until the next. An error the running app
// reports (the runtime's "ui: error in ..." lines on the console) shows the same way, until
// a click: the app goes on behind it.
const string kServeScript = "// Made by ui serve: reload after each build, a failed build's output over the app.\n"
    "let version = -1;\n"
    "let panel = null;\n"
    "const show = (text, title = 'ui serve: the build failed') => {\n"
    "  if (!text) { panel?.remove(); panel = null; return; }\n"
    "  if (!panel) {\n"
    "    panel = document.createElement('pre');\n"
    "    Object.assign(panel.style, {position: 'fixed', inset: '0', margin: '0', padding: '24px', overflow: 'auto',\n"
    "      background: 'rgba(17, 24, 39, 0.94)', color: '#fca5a5', font: '13px/1.5 ui-monospace, Menlo, monospace',\n"
    "      whiteSpace: 'pre-wrap', zIndex: '2147483647'});\n"
    "    document.body.append(panel);\n"
    "  }\n"
    "  panel.textContent = title + '\\n\\n' + text;\n"
    "  panel.dataset.build = title.includes('build') ? '1' : '';\n"
    "  panel.onclick = panel.dataset.build ? null : () => show('');\n"
    "};\n"
    "let report = null;\n"
    "const printError = console.error;\n"
    "console.error = (...parts) => {\n"
    "  printError(...parts);\n"
    "  const line = parts.join(' ');\n"
    "  if (line.startsWith('ui: error in ')) report = line.slice(4);\n"
    "  else if (report && line.startsWith('  in ')) report += '\\n' + line;\n"
    "  else return;\n"
    "  show(report, 'ui serve: an error in the app (click to dismiss)');\n"
    "};\n"
    "for (;;) {\n"
    "  try {\n"
    "    const state = await (await fetch('/__ui/wait?v=' + version, {cache: 'no-store'})).json();\n"
    "    if (version >= 0 && state.version !== version && !state.error) {\n"
    "      try { const kept = globalThis.uiReloadSave?.(); if (kept) sessionStorage.setItem('ui-reload', kept); } catch {}\n"
    "      location.reload();\n"
    "      break;\n"
    "    }\n"
    "    version = state.version;\n"
    "    if (state.error || panel?.dataset.build) show(state.error);\n"
    "  } catch {\n"
    "    await new Promise(resolve => setTimeout(resolve, 1000));\n"
    "  }\n"
    "}\n";

const string kServeTag = "<script type=\"module\" src=\"/__ui/serve.mjs\"></script>\n";

// The driver channel on the web (docs/agents.md): `ui agent web` posts a request to
// /__ui/agent and waits; the page asks /__ui/agent/next for it, carries it out and posts the
// answer to /__ui/agent/reply. One request at a time; the page that takes them is the newest
// one opened with #ui-agent (the browser `ui agent` starts), else the newest page.
String agent_pending_request;
bool agent_waiting;
bool agent_taken;
String agent_reply;
bool agent_answered;
String agent_page;
bool agent_page_flag;
int64 agent_page_seen;
// Bumped by /__ui/agent/forget (`ui agent` starting the browser again): a page's wait from
// before it takes nothing, so no request goes to a page that is gone.
int agent_epoch;

// The value of `name` in a query string ("a=1&b=2"), or "".
void query_value(String* query, string name, String* out) {
    String_clear(out);
    if (query.data == null) { return; }
    int64 n = (int64)strlen(name);
    int64 at = 0;
    while (at < query.len) {
        if (strncmp(&query.data[at], name, (size_t)n) == 0 && query.data[at + n] == '=') {
            for (int64 i = at + n + 1; i < query.len && query.data[i] != '&'; i++) { String_push(out, query.data[i]); }
            return;
        }
        while (at < query.len && query.data[at] != '&') { at++; }
        at++;
    }
}

void serve_reply(int client, string status, string type, String* body) {
    String header;
    defer String_free(&header);
    String_appendf(&header, "HTTP/1.1 %s\r\nContent-Type: %s\r\nContent-Length: %lld\r\n"
        "Cache-Control: no-store\r\nConnection: close\r\n\r\n", status, type, body.len);
    net_send_str(client, header.data);
    int64 sent = 0;
    while (sent < body.len) {
        int64 n = net_send(client, &body.data[sent], body.len - sent);
        if (n <= 0) { break; }
        sent += n;
    }
}

// POST /__ui/agent: hands the request to the page and answers with the page's answer.
void serve_agent_post(int client, String* request) {
    String body;
    defer String_free(&body);
    int64 until = time_monotonic_ms() + 60000;
    Mutex_lock(&serve_lock);
    while (agent_waiting && time_monotonic_ms() < until) {
        Mutex_unlock(&serve_lock); time_sleep_ms(10); Mutex_lock(&serve_lock);
    }
    if (agent_waiting) {
        Mutex_unlock(&serve_lock);
        String_from(&body, "{\"ok\": false, \"error\": \"another request is still waiting for the page\"}");
        serve_reply(client, "200 OK", "application/json", &body);
        return;
    }
    String_clear(&agent_pending_request); String_append(&agent_pending_request, request.data == null ? "" : request.data);
    agent_waiting = true; agent_taken = false; agent_answered = false;
    // A page takes it within 10 s, and answers within 60 s (a clock settle can take a while).
    int64 take_by = time_monotonic_ms() + 10000;
    int64 answer_by = time_monotonic_ms() + 60000;
    while (!agent_answered) {
        int64 now = time_monotonic_ms();
        if ((!agent_taken && now > take_by) || now > answer_by) { break; }
        Mutex_unlock(&serve_lock); time_sleep_ms(5); Mutex_lock(&serve_lock);
    }
    if (agent_answered) { String_from(&body, agent_reply.data == null ? "" : agent_reply.data); }
    else if (!agent_taken) { String_from(&body, "{\"ok\": false, \"error\": \"no page took the request: no page of the app is open\"}"); }
    else { String_from(&body, "{\"ok\": false, \"error\": \"the page did not answer within 60 s\"}"); }
    agent_waiting = false; agent_taken = false; agent_answered = false;
    Mutex_unlock(&serve_lock);
    serve_reply(client, "200 OK", "application/json", &body);
}

// GET /__ui/agent/next?page=P&agent=A&first=F: the waiting request for this page, within
// 20 s, else 204. A page opened with #ui-agent (A=1) is preferred; among equals the newest
// (F=1 on its first ask) takes over.
void serve_agent_next(int client, String* query) {
    String page;
    defer String_free(&page);
    String flag;
    defer String_free(&flag);
    String first;
    defer String_free(&first);
    query_value(query, "page", &page);
    query_value(query, "agent", &flag);
    query_value(query, "first", &first);
    bool agent = String_eq_cstr(&flag, "1") == 1;
    // A page of an older build is about to reload: it takes nothing.
    String version;
    defer String_free(&version);
    query_value(query, "version", &version);
    int page_version = version.len > 0 ? atoi(version.data) : -1;
    String body;
    defer String_free(&body);
    int64 until = time_monotonic_ms() + 20000;
    bool took = false;
    Mutex_lock(&serve_lock);
    int epoch = agent_epoch;
    while (time_monotonic_ms() < until && epoch == agent_epoch) {
        int64 now = time_monotonic_ms();
        bool mine = String_eq(&agent_page, &page) == 1;
        bool stale = agent_page.len == 0 || now - agent_page_seen > 30000;
        if (!mine && (stale || (agent && !agent_page_flag) || (agent == agent_page_flag && String_eq_cstr(&first, "1") == 1))) {
            String_clear(&agent_page); String_append(&agent_page, page.data == null ? "" : page.data);
            agent_page_flag = agent;
            mine = true;
        }
        String_clear(&first);
        if (mine) { agent_page_seen = now; }
        bool current = !serve_building && page_version == atomic_load(&serve_version);
        if (mine && current && agent_waiting && !agent_taken) {
            agent_taken = true;
            String_from(&body, agent_pending_request.data);
            took = true;
            break;
        }
        Mutex_unlock(&serve_lock); time_sleep_ms(5); Mutex_lock(&serve_lock);
    }
    Mutex_unlock(&serve_lock);
    if (took) { serve_reply(client, "200 OK", "application/json", &body); }
    else { net_send_str(client, "HTTP/1.1 204 No Content\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"); }
}

// A request under /__ui/: the script, a wait for the next build, or the driver channel.
void serve_dev_request(int client, String* path, String* query, String* body_in) {
    String body;
    defer String_free(&body);
    string type = "text/javascript";
    if (String_eq_cstr(path, "/__ui/wait") == 1) {
        int after = -1;
        if (String_starts_with(query, "v=") == 1) { after = atoi(&query.data[2]); }
        serve_wait(client, after);
        return;
    }
    if (String_eq_cstr(path, "/__ui/agent") == 1) { serve_agent_post(client, body_in); return; }
    if (String_eq_cstr(path, "/__ui/agent/next") == 1) { serve_agent_next(client, query); return; }
    if (String_eq_cstr(path, "/__ui/agent/forget") == 1) {
        Mutex_lock(&serve_lock);
        agent_epoch++;
        String_clear(&agent_page);
        Mutex_unlock(&serve_lock);
        String_from(&body, "{}");
        serve_reply(client, "200 OK", "application/json", &body);
        return;
    }
    if (String_eq_cstr(path, "/__ui/agent/reply") == 1) {
        Mutex_lock(&serve_lock);
        String_clear(&agent_reply); String_append(&agent_reply, body_in.data == null ? "" : body_in.data);
        agent_answered = true;
        Mutex_unlock(&serve_lock);
        String_from(&body, "{}");
        serve_reply(client, "200 OK", "application/json", &body);
        return;
    }
    if (String_eq_cstr(path, "/__ui/agent/status") == 1) {
        Mutex_lock(&serve_lock);
        bool page = agent_page.len > 0 && time_monotonic_ms() - agent_page_seen < 25000;
        String_appendf(&body, "{\"version\": %d, \"building\": %s, \"page\": %s, \"root\": ", atomic_load(&serve_version),
            serve_building ? "true" : "false", page ? "true" : "false");
        serve_json_string(&body, serve_project_root == null ? "" : serve_project_root);
        String_append(&body, ", \"error\": ");
        serve_json_string(&body, serve_error.data == null ? "" : serve_error.data);
        String_append(&body, "}");
        Mutex_unlock(&serve_lock);
        serve_reply(client, "200 OK", "application/json", &body);
        return;
    }
    if (String_eq_cstr(path, "/__ui/serve.mjs") == 1) { String_from(&body, kServeScript); }
    else {
        net_send_str(client, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
        return;
    }
    serve_reply(client, "200 OK", type, &body);
}

// The page at `path` with the script added; a bare page with it when there is none yet (the
// first build failed).
void serve_page(string path, String* out) {
    if (fs_read_text(path, out) != 0) {
        String_from(out, "<!doctype html>\n<meta charset=\"utf-8\">\n<title>ui serve</title>\n<body>\n");
    }
    // The build the page is, so the driver channel serves only a page of the latest one.
    String_appendf(out, "<script>globalThis.uiServeVersion = %d;</script>\n", serve_building ? -1 : atomic_load(&serve_version));
    String_append(out, kServeTag);
}

// The project the desktop window's watcher builds.
Project* desktop_project;

uint64 desktop_seen;

void serve_command(Project* p, string target) {
    Mutex_init(&serve_lock);
    serve_project_root = p.root.data;
    // A native app (iOS, Android, macOS's AppKit host, Linux's GTK host) reloads its code
    // itself; the web and the webview windows reload the page.
    bool native = strcmp(target, "ios") == 0 || strcmp(target, "android") == 0 || (strcmp(target, "macos") == 0 && !macos_webview(p))
        || (strcmp(target, "linux") == 0 && !linux_webview(p));
    String status;
    String_appendf(&status, "%s/build/ui/serve-%s.json", p.root.data, native ? target : "web");
    fs_mkdir_p(join(p.root.data, "build/ui"));
    serve_status_path = status.data;
    serve_status_port = native ? 0 : port();
    if (strcmp(target, "web") == 0) {
        // Listening first: a page opened during the first build waits for it.
        serve_dev = true;
        serve_root = join(p.root.data, "build/ui/web");
        serve_port = port();
        serve_listen();
        uint64 seen = serve_signature(p);
        serve_built_source = seen;
        serve_build("build", "web");
        String url;
        String_appendf(&url, "http://127.0.0.1:%d/", serve_port);
        String serving;
        String_appendf(&serving, "Serving %s, building again on each change (Ctrl+C to stop)", url.data);
        serve_note("serving", serving.data);
        String_free(&serving);
        open_url(url.data);
        serve_watch(p, "build", "web", seen);
    } else if (native) {
        uint64 seen = serve_signature(p);
        serve_built_source = seen;
        serve_build("run", target);
        serve_note("watching", strcmp(target, "macos") == 0 || strcmp(target, "linux") == 0
            ? "Watching for changes: each one reloads the app's code in its window (Ctrl+C to stop)"
            : "Watching for changes: each one installs and launches the app again (Ctrl+C to stop)");
        serve_watch(p, "run", target, seen);
    } else if (strcmp(target, "macos") == 0 || strcmp(target, "linux") == 0 || strcmp(target, "windows") == 0) {
        desktop_seen = serve_signature(p);
        serve_built_source = desktop_seen;
        if (!serve_build("build", target)) { exit(1); }
        serve_dev = true;
        serve_root = join(p.root.data, "build/ui/web");
        serve_port = port();
        serve_listen();
        desktop_project = p;
        thread_create(void() { serve_watch(desktop_project, "build", "web", desktop_seen); });
        String url;
        String_appendf(&url, "http://127.0.0.1:%d/", serve_port);
        String serving;
        String_appendf(&serving, "Serving %s in a window, building again on each change", url.data);
        serve_note("serving", serving.data);
        String_free(&serving);
        Cmd window;
        string exe = p.name.data;
        String win_exe;
        defer String_free(&win_exe);
        if (strcmp(target, "windows") == 0) {
            String_appendf(&win_exe, "%s.exe", p.name.data);
            exe = win_exe.data;
        }
        window.add(join(join(p.root.data, join("build/ui", target)), exe)); window.add(url.data);
        int code = window.run(null);
        window.free();
        exit(code);
    } else { usage(); }
}
