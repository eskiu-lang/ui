import "serve.esk";
import "release.esk";
import "../../src/apis/ed25519.esk";
import "publish.esk";
import "agent.esk";
import "uitest.esk";

void usage() {
    println_err("usage: ui new NAME [--ui PATH]\n       ui build web|macos|linux|windows|ios|android [--json] [--webview]\n       ui run web|macos|linux|windows|ios|android [--webview]\n"
                "       ui serve [web|macos|linux|windows|ios|android] [--json] [--webview]\n       ui agent web|macos|linux|windows|ios|android [--json] OP...\n       ui test [web|macos|linux|windows|ios|android ...] [--json] [FILE ...]\n       ui open ios|android\n       ui release [web|macos|linux|windows|ios|android] [--upload]\n       ui publish");
    exit(2);
}

// The project `ui open` made, in Xcode or Android Studio (or where it is, without them).
void open_project(string path, bool ios) {
    printf("Made %s\n", path);
    printf("Each Run there builds the Eskiu code first; open it again with ui open after changing ui.toml.\n");
    // UI_NO_OPEN=1 only makes it (CI, scripts).
    string no_open = env_get("UI_NO_OPEN");
    if (no_open != null && strcmp(no_open, "1") == 0) { return; }
    Cmd cmd;
    defer cmd.free();
#ifdef __APPLE__
    cmd.add("open"); cmd.add("-a"); cmd.add(ios ? "Xcode" : "Android Studio"); cmd.add(path);
    if (cmd.run(null) != 0) { printf("Open it in %s.\n", ios ? "Xcode" : "Android Studio"); }
#else
    cmd.add("studio.sh"); cmd.add(path);
    if (ios || cmd.run(null) != 0) { printf("Open it in Android Studio.\n"); }
#endif
}

// The server runs on a thread while a desktop window is open.
string desktop_root;

int desktop_port;

int main(int argc, string* argv) {
    if (argc < 2) { usage(); }
    serve_self = argv[0];
    // --json (build, run, serve, test): JSON lines on standard output (tools/ui/diagnostics.esk).
    if (strcmp(argv[1], "build") == 0 || strcmp(argv[1], "run") == 0 || strcmp(argv[1], "serve") == 0 || strcmp(argv[1], "test") == 0
        || strcmp(argv[1], "release") == 0) {
        int kept = 2;
        for (int i = 2; i < argc; i++) {
            if (strcmp(argv[i], "--json") == 0 && strcmp(argv[1], "release") != 0) { ui_json = true; }
            // macOS: the WKWebView host instead of AppKit (the builds `ui serve` runs inherit it).
            else if (strcmp(argv[i], "--webview") == 0) { env_set("UI_MACOS_RENDERER", "web"); env_set("UI_LINUX_RENDERER", "web"); env_set("UI_WINDOWS_RENDERER", "web"); }
            else { argv[kept++] = argv[i]; }
        }
        argc = kept;
    }
    String command;
    String_from(&command, argv[1]);
    if (String_eq_cstr(&command, "serve") == 1) {
        Project p;
        p.find();
        serve_command(&p, argc >= 3 ? argv[2] : "web");
        return 0;
    }
    if (String_eq_cstr(&command, "agent") == 1) {
        Project p;
        p.find();
        agent_command(&p, argc, argv);
        return 0;
    }
    if (String_eq_cstr(&command, "test") == 1) {
        Project p;
        p.find();
        uitest_command(&p, argc, argv);
        return 0;
    }
    if (String_eq_cstr(&command, "publish") == 1) {
        Project p;
        p.find();
        publish_command(&p, argc, argv);
        return 0;
    }
    if (String_eq_cstr(&command, "release") == 1) {
        Project p;
        p.find();
        release_command(&p, argc, argv);
        return 0;
    }
    if (String_eq_cstr(&command, "open") == 1 || String_eq_cstr(&command, "object") == 1) {
        if (argc < 3) { usage(); }
        Project p;
        p.find();
        bool ios = strcmp(argv[2], "ios") == 0;
        if (!ios && strcmp(argv[2], "android") != 0) { usage(); }
        if (String_eq_cstr(&command, "object") == 1) {
            ui_object = true;
            if (ios) { build_ios(&p); } else { build_android(&p); }
            return 0;
        }
        ui_open = true;
        open_project(ios ? build_ios(&p) : build_android(&p), ios);
        return 0;
    }
    if (String_eq_cstr(&command, "new") == 1) {
        if (argc < 3) { usage(); }
        string ui_path = null;
        if (argc >= 5 && strcmp(argv[3], "--ui") == 0) { ui_path = argv[4]; }
        create(argv[2], ui_path);
        return 0;
    }
    bool run = String_eq_cstr(&command, "run") == 1;
    bool build = String_eq_cstr(&command, "build") == 1;
    if (run || build) {
        Project p;
        p.find();
        string target_name = argc >= 3 ? argv[2] : "web";
        String target;
        String_from(&target, target_name);
        if (String_eq_cstr(&target, "web") == 1) {
        string out = build_web(&p);
        if (ui_json) { json_result("built", out); } else { printf("Built %s\n", out); }
        if (run) {
            String url;
            String_appendf(&url, "http://127.0.0.1:%d/", port());
            printf("Serving %s (Ctrl+C to stop)\n", url.data);
            open_url(url.data);
            serve(out, port());
        }
    } else if (String_eq_cstr(&target, "macos") == 1) {
        if (run && !macos_webview(&p)) { run_macos(&p); return 0; }
        string binary = build_macos(&p);
        if (ui_json) { json_result("built", binary); } else { printf("Built %s\n", binary); }
        if (run) {
            desktop_root = join(p.root.data, "build/ui/web");
            desktop_port = port();
            thread_create(void() { serve(desktop_root, desktop_port); });
            time_sleep_ms(200);
            String url;
            String_appendf(&url, "http://127.0.0.1:%d/", desktop_port);
            Cmd window;
            window.add(binary); window.add(url.data);
            int code = window.run(null);
            window.free();
            exit(code);
        }
    } else if (String_eq_cstr(&target, "linux") == 1) {
        if (run && !linux_webview(&p)) { run_linux(&p); return 0; }
        string binary = build_linux(&p);
        if (ui_json) { json_result("built", binary); } else { printf("Built %s\n", binary); }
        if (run) {
            desktop_root = join(p.root.data, "build/ui/web");
            desktop_port = port();
            thread_create(void() { serve(desktop_root, desktop_port); });
            time_sleep_ms(200);
            String url;
            String_appendf(&url, "http://127.0.0.1:%d/", desktop_port);
            Cmd window;
            window.add(binary); window.add(url.data);
            int code = window.run(null);
            window.free();
            exit(code);
        }
    } else if (String_eq_cstr(&target, "windows") == 1) {
        if (run && !windows_webview(&p)) { run_windows(&p); return 0; }
        string binary = build_windows(&p);
        if (ui_json) { json_result("built", binary); } else { printf("Built %s\n", binary); }
        if (run) {
            desktop_root = join(p.root.data, "build/ui/web");
            desktop_port = port();
            thread_create(void() { serve(desktop_root, desktop_port); });
            time_sleep_ms(200);
            String url;
            String_appendf(&url, "http://127.0.0.1:%d/", desktop_port);
            Cmd window;
            window.add(binary); window.add(url.data);
            int code = window.run(null);
            window.free();
            exit(code);
        }
    } else if (String_eq_cstr(&target, "ios") == 1) {
        if (run) { run_ios(&p); } else { string built = build_ios(&p); if (ui_json) { json_result("built", built); } else { printf("Built %s\n", built); } }
    } else if (String_eq_cstr(&target, "android") == 1) {
        if (run) { run_android(&p); } else { string built = build_android(&p); if (ui_json) { json_result("built", built); } else { printf("Built %s\n", built); } }
    } else { usage(); }
        return 0;
    }
    usage();
    return 0;
}
