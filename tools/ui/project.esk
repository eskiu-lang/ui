// The project: its root, name, app id, the ui package from eskiu.lock, the entry file.
// Part of the ui tool (tools/ui/main.esk imports every part).

// The project: its root (where eskiu.toml is), its name, the ui package's root, and the
// root of every package in the build (the project first), where native code is looked for.
// `display` is the name people see and `config` the merged ui.toml files (config.esk).
struct Project { String root; String name; String ui; String id; List<String> roots; String display; Config config; }

// The value of `key = "..."` on its own line in a TOML file, or "".
void toml_value(string text, string key, String* out) {
    List<String> lines;
    defer fs_list_free(&lines);
    String all;
    defer String_free(&all);
    String_from(&all, text);
    String_lines(&all, &lines);
    for (i in 0..lines.size) {
        String* line = &lines.data[i];
        String_trim(line);
        if (String_starts_with(line, key) != 1) { continue; }
        int64 quote = String_index_of(line, '"');
        if (quote < 0) { continue; }
        String_clear(out);
        for (int64 j = quote + 1; j < line.len && line.data[j] != '"'; j++) {
            char[2] one;
            one[0] = line.data[j]; one[1] = 0;
            String_append(out, (string)&one[0]);
        }
        return;
    }
}

void Project_find(Project* self) {
    String dir;
    fs_cwd(&dir);
    while (true) {
        string toml = join(dir.data, "eskiu.toml");
        if (fs_exists(toml) == 1) { free(toml); break; }
        free(toml);
        String parent;
        path_dirname(&parent, dir.data);
        if (String_eq_cstr(&parent, dir.data) == 1) { fail("ui: no eskiu.toml here or above; run ui new NAME first"); }
        String_free(&dir);
        dir = parent;
    }
    self.root = dir;
    String text;
    defer String_free(&text);
    fs_read_text(join(dir.data, "eskiu.toml"), &text);
    toml_value(text.data, "name", &self.name);
    if (self.name.len == 0) { String_from(&self.name, "app"); }
    // org.eskiu.app.NAME: lowercase letters and digits only, valid as a bundle id and as a
    // Java package (not a keyword, not starting with a digit).
    String segment;
    for (i in 0..self.name.len) {
        char c = self.name.data[i];
        if (c >= 'A' && c <= 'Z') { c = (char)(c + 32); }
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) { continue; }
        char[2] one;
        one[0] = c; one[1] = 0;
        String_append(&segment, (string)&one[0]);
    }
    string keywords = " abstract assert boolean break byte case catch char class const continue default do double "
        "else enum extends final finally float for goto if implements import instanceof int interface long native new "
        "package private protected public return short static strictfp super switch synchronized this throw throws "
        "transient try void volatile while true false null ";
    String padded;
    String_appendf(&padded, " %s ", segment.data == null ? "" : segment.data);
    if (segment.len == 0) { String_from(&self.id, "org.eskiu.app.app"); }
    else if (segment.data[0] >= '0' && segment.data[0] <= '9') { String_appendf(&self.id, "org.eskiu.app.app%s", segment.data); }
    else if (strstr(keywords, padded.data) != null) { String_appendf(&self.id, "org.eskiu.app.%sapp", segment.data); }
    else { String_appendf(&self.id, "org.eskiu.app.%s", segment.data); }
    String_free(&segment); String_free(&padded);
    // The ui package: the lock's entry (NAME git URL REV COMMIT, or NAME path DIR).
    String lock;
    defer String_free(&lock);
    if (fs_read_text(join(dir.data, "eskiu.lock"), &lock) != 0) {
        fail("ui: no eskiu.lock: run eskiuc build or eskiuc fetch once");
    }
    List<String> lines;
    defer fs_list_free(&lines);
    String_lines(&lock, &lines);
    String project_root;
    String_from(&project_root, dir.data);
    self.roots.push(project_root);
    for (i in 0..lines.size) {
        List<String> fields;
        String_split(&lines.data[i], '\t', &fields);
        String root;
        if (fields.size >= 5 && String_eq_cstr(&fields.data[1], "git") == 1) {
            string pkgs = join(eskiu_home(), "pkgs");
            String_from(&root, join(join(pkgs, fields.data[0].data), fields.data[4].data));
        } else if (fields.size >= 3 && String_eq_cstr(&fields.data[1], "path") == 1) {
            if (fields.data[2].data[0] == '/') { String_from(&root, fields.data[2].data); }
            else { String_from(&root, join(dir.data, fields.data[2].data)); }
        }
        if (root.len > 0) {
            if (String_eq_cstr(&fields.data[0], "ui") == 1) { String_from(&self.ui, root.data); }
            self.roots.push(root);
        }
        fs_list_free(&fields);
    }
    for (i in 0..self.roots.size) { self.config.load(join(self.roots.data[i].data, "ui.toml"), i == 0); }
    string display = self.config.string("app.name");
    String_from(&self.display, display != null ? display : self.name.data);
    string id = self.config.string("app.id");
    if (id != null) { String_from(&self.id, id); }
    if (self.ui.len == 0) { fail("ui: eskiu.lock has no ui package: eskiuc add ui --git https://github.com/eskiu-lang/ui"); }
}

// build/ui/TARGET, created.
string Project_out(Project* self, string target) {
    string out = join(join(self.root.data, "build/ui"), target);
    fs_mkdir_p(out);
    return out;
}

// The file every host build compiles: the app and the bridge to the hosts.
string Project_entry(Project* self) {
    string build = join(self.root.data, "build/ui");
    fs_mkdir_p(build);
    String text;
    defer String_free(&text);
    String_appendf(&text, "// Made by ui: the app and the bridge to the hosts.\nimport \"%s\";\nimport \"%s\";\n",
        join(self.root.data, "src/main.esk"), join(self.ui.data, "hosts/bridge.esk"));
    string entry = join(build, "entry.esk");
    fs_write_text(entry, text.data);
    return entry;
}

// The project's assets (images and other files the app loads by name) into `dir`.
void Project_copy_assets(Project* self, string dir) {
    string assets = join(self.root.data, "assets");
    if (fs_is_dir(assets) != 1) { return; }
    List<String> names;
    defer fs_list_free(&names);
    fs_list_dir(assets, &names);
    for (i in 0..names.size) { fs_copy(join(assets, names.data[i].data), join(dir, names.data[i].data)); }
}

// The native code for `platform` with extension `ext` (".m", ".java"...) in every package:
// ROOT/native/PLATFORM/*EXT, sorted within each package.
void Project_native(Project* self, string platform, string ext, List<String>* out) {
    for (i in 0..self.roots.size) {
        string dir = join(join(self.roots.data[i].data, "native"), platform);
        if (fs_is_dir(dir) != 1) { continue; }
        List<String> names;
        fs_list_dir(dir, &names);
        for (j in 0..names.size) {
            if (String_ends_with(&names.data[j], ext) == 1) {
                String path;
                String_from(&path, join(dir, names.data[j].data));
                out.push(path);
            }
        }
        fs_list_free(&names);
    }
}

// The value of `key = "..."` inside an inline table line, or "".
void toml_inline_value(String* line, string key, String* out) {
    String_clear(out);
    int64 at = String_find(line, key, 0);
    if (at < 0) { return; }
    int64 eq = -1;
    for (int64 i = at + (int64)strlen(key); i < line.len; i++) {
        char c = line.data[i];
        if (c == ' ' || c == '\t') { continue; }
        if (c == '=') { eq = i; }
        break;
    }
    if (eq < 0) { return; }
    int64 quote = -1;
    for (int64 i = eq + 1; i < line.len; i++) {
        char c = line.data[i];
        if (c == ' ' || c == '\t') { continue; }
        if (c == '"') { quote = i; }
        break;
    }
    if (quote < 0) { return; }
    for (int64 j = quote + 1; j < line.len && line.data[j] != '"'; j++) {
        char[2] one;
        one[0] = line.data[j]; one[1] = 0;
        String_append(out, (string)&one[0]);
    }
}

// The prebuilt static archives (`libNAME.a`) from `[native.NAME]` in every package's
// eskiu.toml for `platform` ("ios-arm64", "ios-arm64-simulator", "ios-x86_64-simulator",
// "android-arm64"), downloaded and unpacked into $ESKIU_HOME/native/SHA256 when missing.
void Project_native_archives(Project* self, string platform, List<String>* out) {
    for (i in 0..self.roots.size) {
        string toml = join(self.roots.data[i].data, "eskiu.toml");
        if (fs_exists(toml) != 1) { continue; }
        String text;
        if (fs_read_text(toml, &text) != 0) { continue; }
        List<String> lines;
        String_lines(&text, &lines);
        String lib_name;
        for (j in 0..lines.size) {
            String* line = &lines.data[j];
            String_trim(line);
            if (line.len == 0 || line.data[0] == '#') { continue; }
            if (line.data[0] == '[') {
                String_clear(&lib_name);
                if (String_starts_with(line, "[native.") == 1 && String_ends_with(line, "]") == 1) {
                    for (int64 k = 8; k < line.len - 1; k++) {
                        char[2] one;
                        one[0] = line.data[k]; one[1] = 0;
                        String_append(&lib_name, (string)&one[0]);
                    }
                }
                continue;
            }
            if (lib_name.len == 0 || String_starts_with(line, platform) != 1) { continue; }
            int64 plen = (int64)strlen(platform);
            if (line.len <= plen || (line.data[plen] != ' ' && line.data[plen] != '\t' && line.data[plen] != '=')) {
                continue;
            }
            String url;
            String sha256;
            String sub;
            toml_inline_value(line, "url", &url);
            toml_inline_value(line, "sha256", &sha256);
            toml_inline_value(line, "lib", &sub);
            if (sub.len == 0) { String_from(&sub, "lib"); }
            if (url.len > 0 && sha256.len == 64) {
                string base = join(eskiu_home(), "native");
                string dir = join(base, sha256.data);
                string lib_dir = join(dir, sub.data);
                // Downloaded once into the cache eskiuc shares, checked against its sha256.
                if (fs_is_dir(lib_dir) != 1) { fetch_archive(lib_name.data, url.data, sha256.data, dir); }
                String archive;
                String_appendf(&archive, "%s/lib%s.a", lib_dir, lib_name.data);
                if (fs_exists(archive.data) == 1) { out.push(archive); }
                else { String_free(&archive); }
            }
            String_free(&url);
            String_free(&sha256);
            String_free(&sub);
        }
        String_free(&lib_name);
        fs_list_free(&lines);
        String_free(&text);
    }
}
