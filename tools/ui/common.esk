// Running commands, paths, the compiler and ESKIU_HOME.
// Part of the ui tool (tools/ui/main.esk imports every part).

const string kUiGit = "https://github.com/eskiu-lang/ui";
// The release `ui new` depends on.
const string kUiRev = "v0.1.1";

const string kYogaGit = "https://github.com/react/yoga.git";

const string kYogaTag = "v3.2.1";

// The tool itself (argv[0]): `ui serve` runs each build as a child of it (a failed build stops
// the child, not the server), and the IDE projects of `ui open` run its object step.
string serve_self;

// `ui release`: builds for the stores (an iOS archive and IPA, an Android App Bundle and APK,
// signed for release), never reload builds.
bool ui_release;

// `ui release --upload`: the iOS export goes to App Store Connect with Xcode's account.
bool ui_upload;

// `ui open`: the project is made for Xcode or Android Studio, with a step that builds the
// Eskiu side on each Run there (`ui object`), and opened in it.
bool ui_open;

// `ui object`: what that step runs: only the Eskiu side, for the build the IDE is making.
bool ui_object;

// `name` as an absolute path, for commands an IDE runs with its own PATH: a path with a slash
// made absolute, else the first match on PATH.
string tool_path(string name) {
    if (name[0] == '/') { return name; }
    if (strchr(name, '/') != null) {
        String cwd;
        fs_cwd(&cwd);
        return join(cwd.data, name);
    }
    string path = env_get("PATH");
    if (path == null) { return name; }
    String text;
    String_from(&text, path);
    List<String> dirs;
    String_split(&text, ':', &dirs);
    string found = name;
    for (i in 0..dirs.size) {
        string candidate = join(dirs.data[i].data, name);
        if (fs_exists(candidate) == 1) { found = candidate; break; }
    }
    return found;
}

void fail(string message) {
    println_err(message);
    exit(1);
}

// A command line: its parts are copies, so temporaries can be passed.
struct Cmd { List<String> parts; }

void Cmd_add(Cmd* self, string part) {
    String copy;
    String_from(&copy, part);
    self.parts.push(copy);
}

void Cmd_free(Cmd* self) {
    for (i in 0..self.parts.size) { String_free(&self.parts.data[i]); }
    self.parts.free();
}

// Run it in `cwd` (null: here) with its output on ours; the exit code.
int Cmd_run(Cmd* self, string cwd) {
    List<string> argv;
    defer argv.free();
    for (i in 0..self.parts.size) { argv.push(self.parts.data[i].data); }
    ProcessOptions options = ProcessOptions{cwd: cwd, inherit_stdout: true, inherit_stderr: true};
    ProcessResult result;
    defer ProcessResult_free(&result);
    if (process_run(&argv, &options, &result) != 0) { return -1; }
    return result.exit_code;
}

// Run it and stop the tool if it fails.
void Cmd_must(Cmd* self, string cwd) {
    if (self.run(cwd) != 0) {
        String line;
        for (i in 0..self.parts.size) {
            if (i > 0) { String_append(&line, " "); }
            String_append(&line, self.parts.data[i].data);
        }
        print_err("ui: failed: ");
        fail(line.data);
    }
}

// Run it and keep its standard output, trimmed; false if it failed.
bool Cmd_output(Cmd* self, String* out) {
    List<string> argv;
    defer argv.free();
    for (i in 0..self.parts.size) { argv.push(self.parts.data[i].data); }
    ProcessResult result;
    defer ProcessResult_free(&result);
    if (process_run(&argv, null, &result) != 0 || result.exit_code != 0) { return false; }
    String_from(out, result.stdout.data == null ? "" : result.stdout.data);
    String_trim(out);
    return true;
}

// `a/b` into a fresh string the caller frees.
string join(string a, string b) {
    String out;
    path_join(&out, a, b);
    return out.data;
}

string eskiu_home() {
    string home = env_get("ESKIU_HOME");
    if (home != null && home[0] != 0) { return home; }
    return join(env_get("HOME"), ".eskiu");
}

string eskiuc() {
    string path = env_get("ESKIUC");
    return path != null && path[0] != 0 ? path : "eskiuc";
}

// A name for a native source's object, unique per path (two packages may both have clock.m).
string native_object_name(string path) {
    String name;
    String_from(&name, path);
    String_replace_all(&name, "/", "_");
    String_replace_all(&name, ".", "_");
    return name.data;
}

// What `target` and its `sources` are now (path, size and mtime of each), as a stamp for stale
// and built: the target's own line catches another build (a release one, Gradle) that
// replaced it.
string stamp_line(String* text, string path) {
    FileStat st;
    if (fs_stat(path, &st) != 0) { st.size = -1; st.mtime = -1; }
    String_appendf(text, "%s %lld %lld\n", path, st.size, st.mtime);
    return text.data;
}

string stamp_text(string target, List<string>* sources) {
    String text;
    String_from(&text, "");
    stamp_line(&text, target);
    for (i in 0..sources.size) { stamp_line(&text, sources.data[i]); }
    return text.data;
}

// `target` must be made again: it is missing, or `sources` are not what they were when it was
// last made (built wrote them to TARGET.stamp).
bool stale(string target, List<string>* sources) {
    if (fs_exists(target) != 1) { return true; }
    String stamp;
    defer String_free(&stamp);
    String path;
    defer String_free(&path);
    String_appendf(&path, "%s.stamp", target);
    if (fs_read_text(path.data, &stamp) != 0) { return true; }
    return String_eq_cstr(&stamp, stamp_text(target, sources)) != 1;
}

// `target` was made from `sources` as they are now.
void built(string target, List<string>* sources) {
    String path;
    defer String_free(&path);
    String_appendf(&path, "%s.stamp", target);
    fs_write_text(path.data, stamp_text(target, sources));
}

// The optimization level for the app's own code: -O0 under `ui serve` (UI_DEV=1), where a
// build's speed matters more than the app's, -O2 otherwise.
string app_opt() {
    string dev = env_get("UI_DEV");
    return dev != null && strcmp(dev, "1") == 0 ? "-O0" : "-O2";
}

bool newer(string source, string target) {
    FileStat a;
    FileStat b;
    if (fs_stat(target, &b) != 0) { return true; }
    if (fs_stat(source, &a) != 0) { return true; }
    return a.mtime > b.mtime;
}

// `text` with & < > " escaped for XML, in a fresh string.
string xml_escape(string text) {
    String out;
    String_from(&out, text == null ? "" : text);
    String_replace_all(&out, "&", "&amp;");
    String_replace_all(&out, "<", "&lt;");
    String_replace_all(&out, ">", "&gt;");
    String_replace_all(&out, "\"", "&quot;");
    return out.data;
}

// Recursively copy a directory into `dst`.
// `dst` made a copy of `src` afresh, so a file removed from `src` leaves `dst` too.
void replace_dir(string src, string dst) {
    fs_remove_all(dst);
    copy_dir_all(src, dst);
}

void copy_dir_all(string src, string dst) {
    if (fs_is_dir(src) != 1) { return; }
    fs_mkdir_p(dst);
    List<String> entries;
    defer fs_list_free(&entries);
    fs_list_dir(src, &entries);
    for (i in 0..entries.size) {
        string s = join(src, entries.data[i].data);
        string d = join(dst, entries.data[i].data);
        if (fs_is_dir(s) == 1) {
            copy_dir_all(s, d);
        } else {
            fs_copy(s, d);
        }
    }
}

// Whether `text` ends with `suffix`.
bool ends_with(string text, string suffix) {
    int64 n = (int64)strlen(text);
    int64 m = (int64)strlen(suffix);
    return n >= m && strcmp(&text[n - m], suffix) == 0;
}

// The SHA-256 of the file at `path` as 64 lowercase hex digits ("" when it cannot be read).
void file_sha256(string path, String* out) {
    int64 size = 0;
    *uint8 data = fs_read_all(path, &size);
    if (data == null) { return; }
    hash_sha256_hex(data, size, out);
    free(data);
}

// Windows' own tar.exe (bsdtar, which reads and writes zip), not a GNU tar found first on PATH
// in a Git or MSYS shell.
string windows_tar() {
    string root = env_get("SystemRoot");
    if (root != null && root[0] != 0) {
        string tar = join(root, "System32\\tar.exe");
        if (fs_exists(tar) == 1) { return tar; }
    }
    return "tar";
}

// `archive` unpacked into `dir`: unzip for a .zip or .nupkg (GNU tar reads no zip; on Windows
// its own tar does), tar for the rest.
void extract_archive(string archive, string dir) {
    Cmd cmd;
    defer cmd.free();
#ifdef _WIN32
    if (true) {
        cmd.add(windows_tar()); cmd.add("-xf"); cmd.add(archive); cmd.add("-C"); cmd.add(dir);
    } else
#endif
    if (ends_with(archive, ".zip") || ends_with(archive, ".nupkg")) {
        cmd.add("unzip"); cmd.add("-q"); cmd.add("-o"); cmd.add(archive); cmd.add("-d"); cmd.add(dir);
    } else {
        cmd.add("tar"); cmd.add("-xf"); cmd.add(archive); cmd.add("-C"); cmd.add(dir);
    }
    if (cmd.run(null) != 0) {
        String message;
        String_appendf(&message, "ui: could not unpack %s (it needs %s)", archive, cmd.parts.data[0].data);
        fail(message.data);
    }
}

// The archive at `url` unpacked into `dir`, once: downloaded beside it, checked against
// `sha256` (64 hex digits) before anything is unpacked, then moved into place whole, so a
// failed or altered download never leaves a `dir` behind. `name` is for the messages.
void fetch_archive(string name, string url, string sha256, string dir) {
    if (fs_is_dir(dir) == 1) { return; }
    String download;
    String_appendf(&download, "%s.download%s", dir, ends_with(url, ".zip") || ends_with(url, ".nupkg") ? ".zip" : "");
    String tmp;
    String_appendf(&tmp, "%s.tmp", dir);
    fs_remove_all(download.data);
    fs_remove_all(tmp.data);
    String parent;
    path_dirname(&parent, dir);
    fs_mkdir_p(parent.data);
    printf("ui: fetching %s from %s\n", name, url);
    Cmd curl;
    curl.add("curl"); curl.add("-fsSL"); curl.add("--retry"); curl.add("2"); curl.add("-o"); curl.add(download.data); curl.add(url);
    if (curl.run(null) != 0) {
        String message;
        String_appendf(&message, "ui: could not download %s from %s", name, url);
        fail(message.data);
    }
    curl.free();
    String got;
    file_sha256(download.data, &got);
    if (String_eq_cstr(&got, sha256) != 1) {
        fs_remove_all(download.data);
        String message;
        String_appendf(&message, "ui: %s from %s has sha256 %s, not %s", name, url, got.data == null ? "?" : got.data, sha256);
        fail(message.data);
    }
    fs_mkdir_p(tmp.data);
    extract_archive(download.data, tmp.data);
    fs_remove_all(download.data);
    if (fs_rename(tmp.data, dir) != 0) {
        String message;
        String_appendf(&message, "ui: could not move %s into %s", tmp.data, dir);
        fail(message.data);
    }
}

