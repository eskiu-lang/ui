// Text in the theme's type scale: Title, Heading, Body, Secondary, Caption.
// Part of <ui/kit> (src/kit.esk imports every part). The sizes are the theme's (smaller when
// kit.dense). For another size or color, use TextWith.

// A screen's title.
void Title(string text) { TextWith(Style{font_size: kit.title_size, font_weight: 800, color: kit.ink}, text); }

// A section's heading.
void Heading(string text) { TextWith(Style{font_size: kit.heading_size, font_weight: 700, color: kit.ink}, text); }

// Running text.
void Body(string text) { TextWith(Style{font_size: kit.body_size, color: kit.ink}, text); }

// Text that explains or qualifies, in the muted color.
void Secondary(string text) { TextWith(Style{font_size: kit.secondary_size, color: kit.muted}, text); }

// A small note: a version, a timestamp, a hint under a field.
void Caption(string text) { TextWith(Style{font_size: kit.caption_size, color: kit.muted}, text); }
