// Choosing a value: Calendar, DatePicker, ColorPicker.
// Part of <ui/kit> (src/kit.esk imports every part).

// A day of the Gregorian calendar.
struct Date { int year; int month; int day; }

// Frees a fn(Date)->void closure (internal).
void _kit_release_date(escaping fn(Date)->void callback) { free_closure(callback); }

// Whether `year` is a leap year (Gregorian).
bool kit_leap(int year) { return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0; }

// The days in `month` (1 to 12) of `year`.
int kit_days_in_month(int year, int month) {
    if (month == 2) { return kit_leap(year) ? 29 : 28; }
    return month == 4 || month == 6 || month == 9 || month == 11 ? 30 : 31;
}

// 0 for Sunday through 6 for Saturday (Sakamoto's method).
int kit_weekday(int year, int month, int day) {
    int[12] offsets = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
    int y = month < 3 ? year - 1 : year;
    return (y + y / 4 - y / 100 + y / 400 + offsets[month - 1] + day) % 7;
}

// The name of `month` (1 to 12) in the kit's words (kit_text.months), into `out`.
void kit_month_name(int month, String* out) { kit_text_item(kit_text.months, month - 1, out); }

// A month's days, weeks from the kit's first weekday (kit_text), with arrows to the months
// around it; `selected` is circled and read as selected, and on_select gets the day pressed. The seven columns share the width it gets, at
// least 280 points.
void Calendar(Date selected, escaping fn(Date)->void on_select UI_LOC) {
    KIT_HERE
    ui_own(void() { _kit_release_date(on_select); });
    Scope("Calendar", Key{}) {
        // The month shown, as year * 12 + month - 1.
        *Signal<int> shown = use_signal<int>(selected.year * 12 + selected.month - 1);
        int year = shown.get() / 12;
        int month = shown.get() % 12 + 1;
        Column(Style{gap: 8, min_width: 280}) {
            Row(Style{align: AlignCenter, gap: 4}) {
                String title;
                defer String_free(&title);
                kit_text_fill(kit_text.month_year, year, month, 1, &title);
                TextWith(Style{grow: 1, font_size: 16, font_weight: 700, color: kit.ink, role: RoleHeader}, title.data);
                Pressable(Style{width: 44, height: 44, radius: 22, align: AlignCenter, justify: JustifyCenter,
                                label: kit_text.previous_month, role: RoleButton}, void() { shown.set(shown.get() - 1); }) {
                    TextWith(Style{font_size: 20, color: kit.ink}, "‹");
                }
                Pressable(Style{width: 44, height: 44, radius: 22, align: AlignCenter, justify: JustifyCenter,
                                label: kit_text.next_month, role: RoleButton}, void() { shown.set(shown.get() + 1); }) {
                    TextWith(Style{font_size: 20, color: kit.ink}, "›");
                }
            }
            Row(Style{gap: 0}) {
                for (i in 0..7) {
                    String letter;
                    defer String_free(&letter);
                    String name;
                    defer String_free(&name);
                    int day = (i + kit_text.first_weekday) % 7;
                    kit_text_item(kit_text.weekdays, day, &letter);
                    kit_text_item(kit_text.weekday_names, day, &name);
                    string text = letter.data;
                    // The initial on screen, the day's name to a screen reader.
                    Row(Style{width: 1, grow: 1, justify: JustifyCenter, label: name.data}) {
                        TextWith(Style{font_size: 12, font_weight: 600, color: kit.muted}, text);
                    }
                }
            }
            int first = (kit_weekday(year, month, 1) - kit_text.first_weekday + 7) % 7;
            int days = kit_days_in_month(year, month);
            int cells = (first + days + 6) / 7 * 7;
            for (int week = 0; week < cells / 7; week++) {
                Row(Style{key: key(week), gap: 0}) {
                    for (i in 0..7) {
                        int day = week * 7 + i - first + 1;
                        if (day < 1 || day > days) {
                            Row(Style{key: key(i), width: 1, grow: 1, height: 44}) {}
                            continue;
                        }
                        bool on = selected.year == year && selected.month == month && selected.day == day;
                        String number;
                        defer String_free(&number);
                        String_format(&number, "%d", day);
                        // Read as the whole date, and as selected when it is.
                        String spoken;
                        defer String_free(&spoken);
                        kit_text_fill(kit_text.date, year, month, day, &spoken);
                        Row(Style{key: key(i), width: 1, grow: 1, justify: JustifyCenter}) {
                            Pressable(Style{width: 44, height: 44, radius: 22, align: AlignCenter, justify: JustifyCenter,
                                            background: on ? kit.primary : -1, label: spoken.data, role: RoleButton, selected: on},
                                void() { on_select(Date{year, month, day}); }) {
                                TextWith(Style{font_size: 15, font_weight: on ? 700 : 400, color: on ? kit.on_primary : kit.ink},
                                    number.data);
                            }
                        }
                    }
                }
            }
        }
    }
}

// A field showing `value` that opens a Calendar.
void DatePicker(Date value, escaping fn(Date)->void on_change UI_LOC) {
    KIT_HERE
    ui_own(void() { _kit_release_date(on_change); });
    Scope("DatePicker", Key{}) {
        *Signal<bool> open = use_signal<bool>(false);
        String text;
        defer String_free(&text);
        kit_text_fill(kit_text.date, value.year, value.month, value.day, &text);
        string shown = text.data;
        Popover(open.get(), void() { open.set(false); }, void() {
            Pressable(Style{padding: 12, radius: kit.radius, background: kit.surface, border_width: 1, border_color: kit.control,
                            label: shown, role: RoleButton, expanded: open.get() ? DisclosureExpanded : DisclosureCollapsed},
                void() { open.set(true); }) {
                Body(shown);
            }
        }) {
            Calendar(value, void(Date d) { open.set(false); on_change(d); });
        }
    }
}

// The swatches ColorPicker offers.
int64 kit_swatch(int i) {
    int64[12] colors = {0xEF4444FF, 0xF97316FF, 0xF59E0BFF, 0x84CC16FF, 0x10B981FF, 0x06B6D4FF,
                        0x3B82F6FF, 0x6366F1FF, 0x8B5CF6FF, 0xEC4899FF, 0x6B7280FF, 0x111827FF};
    return colors[i];
}

// A swatch showing `color` that opens a grid of colors to choose from.
void ColorPicker(int64 color, escaping fn(int64)->void on_change UI_LOC) {
    KIT_HERE
    ui_own(void() { _kit_release_int64(on_change); });
    Scope("ColorPicker", Key{}) {
        *Signal<bool> open = use_signal<bool>(false);
        Popover(open.get(), void() { open.set(false); }, void() {
            // Read as the kit's word for a color and the swatch's name (or nothing for another color).
            String current;
            defer String_free(&current);
            for (i in 0..12) { if (kit_swatch(i) == color) { kit_text_item(kit_text.colors, i, &current); } }
            Pressable(Style{width: 44, height: 44, radius: 22, background: color, border_width: 2, border_color: kit.line,
                            label: kit_text.color, value: current.data, role: RoleButton,
                            expanded: open.get() ? DisclosureExpanded : DisclosureCollapsed}, void() { open.set(true); }) {}
        }) {
            Row(Style{wrap: true, gap: 8, padding: 4}) {
                for (i in 0..12) {
                    int64 swatch = kit_swatch(i);
                    bool on = swatch == color;
                    String name;
                    defer String_free(&name);
                    kit_text_item(kit_text.colors, i, &name);
                    Pressable(Style{key: key(i), width: 44, height: 44, radius: 22, background: swatch,
                                    border_width: on ? 3 : 0, border_color: kit.ink, label: name.data, role: RoleButton, selected: on},
                        void() { open.set(false); on_change(swatch); }) {}
                }
            }
        }
    }
}
