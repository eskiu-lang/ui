// Moving around: SegmentedControl, TabBar, Toolbar, NavBar, ListItem.
// Part of <ui/kit> (src/kit.esk imports every part).

// Options side by side in a track, the selected one raised (a toggle group).
void SegmentedControl(string options, int selected, escaping fn(int)->void on_change UI_LOC) {
    UI_HERE
    ui_own_fn(on_change);
    Row(Style{background: kit.track, radius: kit.radius, padding: 2, gap: 2, role: RoleTabList}) {
        List<String> items;
        kit_options(options, &items);
        for (i in 0..items.size) {
            int index = i;
            bool on = index == selected;
            string name = items.data[i].data;
            Pressable(Style{grow: 1, padding: 8, min_height: 44, radius: kit.radius - 2, background: on ? kit.surface : -1,
                            align: AlignCenter, justify: JustifyCenter, label: name, role: RoleTab, selected: on},
                void() { on_change(index); }) {
                // Both in ink (muted on the track falls under 4.5:1); the raised one is bolder.
                TextWith(Style{font_size: kit.body_size - 2, font_weight: on ? 600 : 500, color: kit.ink}, name);
            }
        }
        kit_free_options(&items);
    }
}

// Tabs over content the caller shows for `selected`: the selected one underlined.
void TabBar(string tabs, int selected, escaping fn(int)->void on_change UI_LOC) {
    UI_HERE
    ui_own_fn(on_change);
    Row(Style{gap: 20, role: RoleTabList}) {
        List<String> items;
        kit_options(tabs, &items);
        for (i in 0..items.size) {
            int index = i;
            bool on = index == selected;
            string name = items.data[i].data;
            Pressable(Style{gap: 6, min_height: 44, justify: JustifyEnd, label: name, role: RoleTab, selected: on}, void() { on_change(index); }) {
                TextWith(Style{font_size: kit.secondary_size, font_weight: 600, color: on ? kit.primary : kit.muted}, name);
                Row(Style{height: 2, radius: 1, background: on ? kit.primary : -1}) {}
            }
        }
        kit_free_options(&items);
    }
}

// A bar of controls.
void Toolbar(escaping fn()->void block UI_LOC) {
    UI_HERE
    Row(Style{padding: 8, gap: 8, background: kit.surface, border_width: 1, border_color: kit.line,
              radius: kit.radius, align: AlignCenter}, block);
}

// A title bar; `actions` puts controls at its end.
void NavBar(string title, escaping fn()->void actions UI_LOC) {
    UI_HERE
    ui_own_fn(actions);
    Row(Style{padding: 16, gap: 12, align: AlignCenter, background: kit.surface}) {
        TextWith(Style{grow: 1, font_size: kit.heading_size + 2, font_weight: 700, color: kit.ink, role: RoleHeader}, title);
        actions();
    }
}

// A pressable row with a title and an optional subtitle; it lights up under a pointer.
void ListItem(string title, string subtitle, escaping fn()->void on_press UI_LOC) {
    UI_HERE
    ui_own_fn(on_press);
    Scope("ListItem", Key{}) {
        *Signal<bool> over = use_signal<bool>(false);
        ui_on_hover(void(bool inside) { over.set(inside); });
        Pressable(Style{padding: kit.control_padding + 2, radius: kit.radius, background: over.get() ? kit.track : kit.surface, border_width: 1,
                        border_color: kit.line, gap: 2, label: title}, void() { on_press(); }) {
            TextWith(Style{font_size: kit.body_size, font_weight: 500, color: kit.ink}, title);
            if (subtitle != null && subtitle[0] != 0) { TextWith(Style{font_size: kit.body_size - 2, color: kit.muted}, subtitle); }
        }
    }
}
