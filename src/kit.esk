// <ui/kit>: styled components built on ui's elements, with one theme. Each is an ordinary
// function: call it in a block like any element. Options (RadioGroup, SegmentedControl,
// TabBar) are one string with a line per option.
import "ui.esk";
import <string>;

// The theme: change its fields before mounting (colors are rgb()/rgba() values).
struct Theme {
    int64 primary = 0x4F46E5FF;
    int64 on_primary = 0xFFFFFFFF;
    int64 primary_soft = 0xE0E7FFFF;
    int64 ink = 0x111827FF;
    int64 muted = 0x6B7280FF;
    int64 page = 0xF5F6FAFF;
    int64 surface = 0xFFFFFFFF;
    int64 line = 0xE5E7EBFF;
    int64 control = 0xCBD5E1FF;
    int64 track = 0xF1F2F6FF;
    int64 danger = 0xDC2626FF;
    int radius = 12;
}
Theme kit;

enum Tone { ToneNeutral, TonePrimary, ToneSuccess, ToneWarning, ToneDanger }
enum Variant { VariantPrimary, VariantSecondary, VariantGhost, VariantDanger }

int64 kit_tone_text(int tone) {
    if (tone == TonePrimary) { return 0x4338CAFF; }
    if (tone == ToneSuccess) { return 0x047857FF; }
    if (tone == ToneWarning) { return 0xB45309FF; }
    if (tone == ToneDanger) { return 0xB91C1CFF; }
    return 0x374151FF;
}

int64 kit_tone_background(int tone) {
    if (tone == TonePrimary) { return 0xE0E7FFFF; }
    if (tone == ToneSuccess) { return 0xD1FAE5FF; }
    if (tone == ToneWarning) { return 0xFEF3C7FF; }
    if (tone == ToneDanger) { return 0xFEE2E2FF; }
    return 0xF3F4F6FF;
}

// The lines of `options`, as copies the caller frees with fs_list_free-style loops.
void kit_options(string options, List<String>* out) {
    String all;
    defer String_free(&all);
    String_from(&all, options == null ? "" : options);
    String_split(&all, '\n', out);
}

void kit_free_options(List<String>* options) {
    for (i in 0..options.size) { String_free(&options.data[i]); }
    options.free();
}

// A surface with the theme's border and radius; the block is its content.
void Card(escaping fn()->void block) {
    Column(Style{background: kit.surface, radius: kit.radius + 4, padding: 16, gap: 12, border_width: 1,
                 border_color: kit.line}, block);
}

// A small label in a tone's colors.
void Badge(string text, int tone) {
    Row(Style{padding: 6, radius: 8, background: kit_tone_background(tone), label: text}, void() {
        TextWith(Style{font_size: 12, font_weight: 600, color: kit_tone_text(tone)}, text);
    });
}

// Initials in a circle of `size` points.
void Avatar(string initials, int size) {
    Row(Style{width: size, height: size, radius: size / 2, background: kit.primary_soft, align: AlignCenter,
              justify: JustifyCenter, label: initials}, void() {
        TextWith(Style{font_size: size * 2 / 5, font_weight: 700, color: kit.primary}, initials);
    });
}

// An image (a bundled file or a URL) in a circle of `size` points.
void AvatarImage(string source, int size, string label) {
    Image(Style{width: size, height: size, radius: size / 2, label: label}, source);
}

// A hairline across a column (Separator) or down a row (VSeparator).
void Separator() { Row(Style{height: 1, background: kit.line}, void() {}); }
void VSeparator() { Row(Style{width: 1, background: kit.line}, void() {}); }

// A button in one of the Variant styles.
void KitButton(string text, int variant, escaping fn()->void on_press) {
    int64 background = variant == VariantPrimary ? kit.primary : variant == VariantDanger ? kit.danger
                     : variant == VariantSecondary ? kit.surface : 0xFFFFFF00;  // ghost: transparent
    int64 color = variant == VariantPrimary || variant == VariantDanger ? kit.on_primary
                : variant == VariantGhost ? kit.primary : kit.ink;
    ButtonWith(Style{background: background, color: color, radius: kit.radius, padding: 12, font_size: 16,
                     font_weight: 600, border_width: variant == VariantSecondary ? 1 : 0, border_color: kit.line,
                     label: text},
        text, on_press);
}

// A text field in the theme's style; `placeholder` is also its accessible name.
void TextField(string value, string placeholder, escaping fn(string)->void on_change) {
    TextInput(Input{value: value, placeholder: placeholder, label: placeholder,
                    style: Style{padding: 12, radius: kit.radius, background: kit.surface, border_width: 1,
                                 border_color: kit.line, font_size: 16}}, on_change);
}

// A checkbox with its label; on_change gets the new state.
void Checkbox(string label, bool checked, escaping fn(bool)->void on_change) {
    ui_own(void() { ui_release_bool(on_change); });
    Pressable(Style{label: label}, void() { on_change(!checked); }, void() {
        Row(Style{gap: 10, align: AlignCenter}, void() {
            Row(Style{width: 22, height: 22, radius: 6, border_width: 2,
                      border_color: checked ? kit.primary : kit.control, background: checked ? kit.primary : kit.surface,
                      align: AlignCenter, justify: JustifyCenter}, void() {
                if (checked) { TextWith(Style{font_size: 13, font_weight: 700, color: kit.on_primary}, "✓"); }
            });
            TextWith(Style{font_size: 16, color: kit.ink}, label);
        });
    });
}

// One choice among `options` (a line each); on_change gets the index chosen.
void RadioGroup(string options, int selected, escaping fn(int)->void on_change) {
    ui_own(void() { ui_release_int(on_change); });
    Column(Style{gap: 10}, void() {
        List<String> items;
        kit_options(options, &items);
        for (i in 0..items.size) {
            int index = i;
            bool on = index == selected;
            string name = items.data[i].data;
            Pressable(Style{label: name}, void() { on_change(index); }, void() {
                Row(Style{gap: 10, align: AlignCenter}, void() {
                    Row(Style{width: 22, height: 22, radius: 11, border_width: 2,
                              border_color: on ? kit.primary : kit.control, background: kit.surface,
                              align: AlignCenter, justify: JustifyCenter}, void() {
                        if (on) { Row(Style{width: 10, height: 10, radius: 5, background: kit.primary}, void() {}); }
                    });
                    TextWith(Style{font_size: 16, color: kit.ink}, name);
                });
            });
        }
        kit_free_options(&items);
    });
}

// Options side by side in a track, the selected one raised (a toggle group).
void SegmentedControl(string options, int selected, escaping fn(int)->void on_change) {
    ui_own(void() { ui_release_int(on_change); });
    Row(Style{background: kit.track, radius: kit.radius, padding: 4, gap: 4}, void() {
        List<String> items;
        kit_options(options, &items);
        for (i in 0..items.size) {
            int index = i;
            bool on = index == selected;
            string name = items.data[i].data;
            Pressable(Style{grow: 1, padding: 8, radius: kit.radius - 4, background: on ? kit.surface : -1,
                            align: AlignCenter, label: name},
                void() { on_change(index); }, void() {
                    TextWith(Style{font_size: 14, font_weight: 600, color: on ? kit.ink : kit.muted}, name);
                });
        }
        kit_free_options(&items);
    });
}

// Tabs over content the caller shows for `selected`: the selected one underlined.
void TabBar(string tabs, int selected, escaping fn(int)->void on_change) {
    ui_own(void() { ui_release_int(on_change); });
    Row(Style{gap: 20}, void() {
        List<String> items;
        kit_options(tabs, &items);
        for (i in 0..items.size) {
            int index = i;
            bool on = index == selected;
            string name = items.data[i].data;
            Pressable(Style{gap: 6, label: name}, void() { on_change(index); }, void() {
                TextWith(Style{font_size: 15, font_weight: 600, color: on ? kit.primary : kit.muted}, name);
                Row(Style{height: 2, radius: 1, background: on ? kit.primary : -1}, void() {});
            });
        }
        kit_free_options(&items);
    });
}

// `value` of `max` as a filled track.
void ProgressBar(int value, int max) {
    int done = value < 0 ? 0 : value > max ? max : value;
    Row(Style{height: 8, radius: 4, gap: 0, background: kit.track, label: "Progress"}, void() {
        if (done > 0) { Row(Style{grow: done, background: kit.primary, radius: 4}, void() {}); }
        if (max - done > 0) { Row(Style{grow: max - done}, void() {}); }
    });
}

// A header that shows or hides its content (one section of an Accordion).
void Collapsible(string title, escaping fn()->void content) {
    ui_own(void() { ui_release_closure(content); });
    Scope("Collapsible", Key{}, void() {
        *Signal<bool> open = use_signal<bool>(false);
        Pressable(Style{padding: 14, label: title}, void() { open.set(!open.get()); }, void() {
            Row(Style{align: AlignCenter}, void() {
                TextWith(Style{grow: 1, font_size: 16, font_weight: 600, color: kit.ink}, title);
                TextWith(Style{font_size: 18, color: kit.muted}, open.get() ? "−" : "+");
            });
        });
        if (open.get()) { Column(Style{padding: 14, gap: 8}, void() { content(); }); }
    });
}

// Sections (Collapsibles) in one card.
void Accordion(escaping fn()->void sections) {
    Column(Style{background: kit.surface, radius: kit.radius + 4, border_width: 1, border_color: kit.line, gap: 0},
        sections);
}

// A bar of controls.
void Toolbar(escaping fn()->void block) {
    Row(Style{padding: 8, gap: 8, background: kit.surface, border_width: 1, border_color: kit.line,
              radius: kit.radius, align: AlignCenter}, block);
}

// A title bar; `actions` puts controls at its end.
void NavBar(string title, escaping fn()->void actions) {
    ui_own(void() { ui_release_closure(actions); });
    Row(Style{padding: 16, gap: 12, align: AlignCenter, background: kit.surface, label: title}, void() {
        TextWith(Style{grow: 1, font_size: 20, font_weight: 700, color: kit.ink}, title);
        actions();
    });
}

// A pressable row with a title and an optional subtitle.
void ListItem(string title, string subtitle, escaping fn()->void on_press) {
    Pressable(Style{padding: 14, radius: kit.radius, background: kit.surface, border_width: 1, border_color: kit.line,
                    gap: 2, label: title}, on_press, void() {
        TextWith(Style{font_size: 16, font_weight: 500, color: kit.ink}, title);
        if (subtitle != null && subtitle[0] != 0) { TextWith(Style{font_size: 14, color: kit.muted}, subtitle); }
    });
}
