// <ui/kit>: styled components built on <ui>'s elements, with one theme (kit). Each is an
// ordinary function: call it in a block like any element. Options (RadioGroup,
// SegmentedControl, TabBar) are one string with a line per option. Its parts:
//
//   theme        Theme and the global `kit`, Tone and Variant
//   display      Card, Badge, Avatar, AvatarImage, Separator, VSeparator, ProgressBar
//   buttons      KitButton
//   forms        TextField, Checkbox, RadioGroup
//   navigation   SegmentedControl, TabBar, Toolbar, NavBar, ListItem
//   disclosure   Collapsible, Accordion
import "ui.esk";

import "kit/theme.esk";
import "kit/display.esk";
import "kit/buttons.esk";
import "kit/forms.esk";
import "kit/navigation.esk";
import "kit/disclosure.esk";
