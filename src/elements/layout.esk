// Containers: Column, Row, Scope, Scroll, Pressable; the frames the host lays them out at.
// Part of <ui> (src/ui.esk imports every part; they are not imported alone).

// An element's frame, in points: x and y relative to its parent, window_x and window_y from
// the window's top left (where an overlay places something next to it).
struct Frame { int x; int y; int width; int height; int window_x; int window_y; }

// For the element right after it: `handler` gets its frame after each layout that changes
// it (React Native's onLayout).
void ui_on_layout(escaping fn(Frame)->void handler) {
    if (ui.has_next_layout) { ui_release_frame(ui.next_layout); }
    ui.next_layout = handler;
    ui.has_next_layout = true;
}

// For the element right after it: `handler` gets true when a pointer (a mouse, a trackpad,
// an iPad's pointer, a stylus) moves over it and false when it leaves. Touch screens have
// no hover.
void ui_on_hover(escaping fn(bool)->void handler) {
    if (ui.has_next_hover) { ui_release_bool(ui.next_hover); }
    ui.next_hover = handler;
    ui.has_next_hover = true;
}

// For the element right after it: `handler` runs when it is held for about half a second
// (a long press; a right click or a held mouse button on the web). A long press is not also
// a press.
void ui_on_long_press(escaping fn()->void handler) {
    if (ui.has_next_long_press) { ui_release_closure(ui.next_long_press); }
    ui.next_long_press = handler;
    ui.has_next_long_press = true;
}

// Children laid out top to bottom.
void Column(Style style, escaping fn()->void block UI_LOC) { UI_HERE ui_element(1, style, null, block, void() {}, void() {}); }

// Children laid out left to right.
void Row(Style style, escaping fn()->void block UI_LOC) { UI_HERE ui_element(2, style, null, block, void() {}, void() {}); }

// A column whose content scrolls when it is taller than the space it gets.
void Scroll(Style style, escaping fn()->void block UI_LOC) { UI_HERE ui_element(6, style, null, block, void() {}, void() {}); }

// A component's own scope: state, identity and its name in diagnostics.
void Scope(string name, Key k, escaping fn()->void block UI_LOC) {
    UI_HERE
    ui.next_name = name;
    ui_element(0, Style{key: k}, null, block, void() {}) {}
}

// A container that reacts to a press anywhere in it (the children are its content).
void Pressable(Style style, escaping fn()->void on_press, escaping fn()->void block UI_LOC) {
    UI_HERE
    ui_element(8, style, null, block, on_press) {}
}
