// Stopping with a message that says where: the scope path.
// Part of <ui> (src/ui.esk imports every part; they are not imported alone).

extern void abort();

// An element kind's name ("Column", "Text", ...), "Scope" for any other.
string ui_kind_name(int kind) {
    if (kind == 15) { return "Slider"; }
    if (kind == 14) { return "Screen"; }
    if (kind == 13) { return "NativeView"; }
    if (kind == 12) { return "Modal"; }
    if (kind == 11) { return "StatusBar"; }
    if (kind == 10) { return "ActivityIndicator"; }
    if (kind == 9) { return "Switch"; }
    if (kind == 8) { return "Pressable"; }
    if (kind == 7) { return "Image"; }
    if (kind == 6) { return "Scroll"; }
    if (kind == 5) { return "TextInput"; }
    if (kind == 1) { return "Column"; }
    if (kind == 2) { return "Row"; }
    if (kind == 3) { return "Text"; }
    if (kind == 4) { return "Button"; }
    return "Scope";
}

// Where the running block is, from the root down: `Column[0] > Row[key 3]`, each step
// the component name or element kind with its key or its index among its siblings.
void ui_scope_path(*String out) { ui_node_path(ui == null ? null : ui.builder, out); }

// Appends the scope path of `node` to `out` (as ui_scope_path).
void ui_node_path(*Node node, *String out) {
    List<*Node> steps;
    while (node != null && node.parent != null) { steps.push(node); node = node.parent; }
    if (steps.size == 0) { String_append(out, "the root block"); }
    for (int i = steps.size - 1; i >= 0; i--) {
        *Node step = steps.data[i];
        String_append(out, step.name != null ? step.name : ui_kind_name(step.kind));
        if (step.key.set) {
            String_appendf(out, "[key %lld]", step.key.value);
        } else {
            *Node parent = step.parent;
            int index = -1;
            List<*Node>* siblings = parent.emitted.size > 0 ? &parent.emitted : &parent.children;
            for (j in 0..siblings.size) { if (siblings.data[j] == step) { index = j; break; } }
            String_appendf(out, "[%d]", index);
        }
        if (i > 0) { String_append(out, " > "); }
    }
    steps.free();
}

// Prints `message` and the running block's scope path to stderr, then aborts.
void ui_fail(string message) { ui_fail_node(message, ui == null ? null : ui.builder); }

// Prints `message` with `node`'s scope path (and, in a UI_SRCLOC build, where its element was
// called from) to stderr, then aborts.
void ui_fail_node(string message, *Node node) {
#ifdef UI_SRCLOC
    ui_fail_where(message, node, node == null ? UiSourceLoc{} : node.at);
#else
    // stderr is unbuffered: the message survives the abort when output goes to a file.
    String text;
    String_appendf(&text, "ui: %s\n  in ", message);
    ui_node_path(node, &text);
    println_err(text.data);
    abort();
#endif
}

#ifdef UI_SRCLOC
// The root of the app's sources (UI_SOURCE_ROOT, from the ui tool): a position in a file under
// it is shown from there (src/main.esk:12:5).
#ifndef UI_SOURCE_ROOT
#define UI_SOURCE_ROOT ""
#endif

// A position's file as shown: under the app's root, from there (internal).
string ui_source_file(string file) {
    string root = UI_SOURCE_ROOT;
    int64 n = (int64)strlen(root);
    if (file != null && n > 0 && strncmp(file, root, (size_t)n) == 0) { return (string)((*char)file + n); }
    return file;
}

// "\n  at FILE:LINE:COL" for a known position, appended to `out` (internal).
void ui_source_at(*String out, UiSourceLoc at) {
    if (at.file == null) { return; }
    String_appendf(out, "\n  at %s:%d:%d", ui_source_file(at.file), at.line, at.col);
}

// For the element the running block makes next: `at` is its call (UI_HERE). The first one
// given wins, so a component's position goes to the element it makes first.
void ui_here(UiSourceLoc at) {
    if (ui != null && ui.next_at.file == null) { ui.next_at = at; }
}

// ui_fail_node with the position `at` (internal).
void ui_fail_where(string message, *Node node, UiSourceLoc at) {
    String text;
    String_appendf(&text, "ui: %s\n  in ", message);
    ui_node_path(node, &text);
    ui_source_at(&text, at);
    println_err(text.data);
    abort();
}
#endif

// ui_fail(message) unless `ok`.
void ui_require(bool ok, string message) {
    if (!ok) { ui_fail(message); }
}

// A throw out of a block, handler or effect is caught by the runtime (src/core/boundary.esk).
// One that still escapes is an internal error: a caller that catches it leaves the runtime
// mid-phase, and the next entry point stops here instead of running on it.
void ui_require_consistent() {
    ui_require(ui.phase == 0 && ui.builder == null && ui.tracking == null,
        "runtime left mid-phase (an exception escaped a block, handler or effect)");
}
