// The runtime's globals, first because Eskiu declares a global where it is defined (as C).
// Part of <ui> (src/ui.esk imports every part; they are not imported alone).

// The runtime the hosts and the element calls use (one UI thread).
*Ui ui;

// Unique per observer run across all observers, so a freed observer's subscription mark
// never matches a new one at the same address.
int64 ui_epochs;

// Up to kSmall children are matched by scanning; more get the key tables.
const int kSmall = 8;

// Room for the element kinds (0 to 15 today); kind_start and kind_emitted are sized by it.
const int kKinds = 16;

// Room for the int props (codes 1 to 41 today).
const int kProps = 48;

// An edge offset (Style's left, top, right, bottom) that is not set.
const int kUnset = -1000000;

// Host policy: 0 puts the root inside the safe area and above the keyboard; 1 gives it the
// whole screen and leaves the insets to the app (ui_insets). An app sets it in
// ui_app_start.
int ui_edge_policy;

// The app's data directory (ui_data_dir), set by the host before the app starts.
string ui_data_path;
