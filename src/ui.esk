// <ui>: components written once, drawn by native views on iOS and Android, by the DOM on the
// web and in a webview on the desktop. Import this module; its parts are:
//
//   style            Style, colors, Align and Justify, keys
//   core/            the runtime: state, tree, reactivity, frames and commits, the wire format
//   elements/        what apps build with: layout, text, input, media, lists, overlays,
//                    the platform, native modules and views, navigation, timers, display frames, gestures, animated values
//   state/strings    owned strings (use_string)
//   core/driver      what `ui agent` asks (UI_TEST builds only) and the clock it owns
//   core/reload      the state a reload under `ui serve` keeps (UI_TEST builds only)
//   apis/            the system: environment (platform, dark mode, accessibility, language),
//                    actions (keyboard, share, clipboard, haptics, announcements), storage, network,
//                    and updates of the assets (with Ed25519), in a build with [updates] only
//
// One UI thread; hosts deliver events and frames on it.
import <io>;
import <list>;
import <mem>;
import <string>;
#ifndef __wasm__
import <fs>;
#endif

import "core/state.esk";
import "style.esk";
import "core/diagnostics.esk";
import "core/keys.esk";
import "core/wire.esk";
import "core/reactive.esk";
import "core/closures.esk";
import "core/tree.esk";
import "core/runtime.esk";
import "core/boundary.esk";
import "elements/layout.esk";
import "elements/text.esk";
import "elements/input.esk";
import "elements/media.esk";
import "elements/lists.esk";
import "elements/overlay.esk";
import "elements/system.esk";
import "elements/native.esk";
import "elements/navigation.esk";
import "elements/timers.esk";
import "elements/frames.esk";
import "elements/gestures.esk";
import "elements/animated.esk";
import "state/strings.esk";
import "apis/environment.esk";
import "apis/actions.esk";
import "apis/storage.esk";
import "apis/network.esk";
// Updates of the assets without a store release, in a build with [updates] only (the ui tool
// defines UI_UPDATES and the bundle's URL and key).
#ifdef UI_UPDATES
import <hash>;
import "apis/ed25519.esk";
import "apis/updates.esk";
#endif
// The driver `ui agent` talks to, in dev and test builds only (the ui tool defines UI_TEST
// for `ui serve` builds).
#ifdef UI_TEST
import <json>;
import <time>;
import "core/driver.esk";
import "core/reload.esk";
#endif
