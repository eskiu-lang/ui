// Phase-0 executable model. Single UI thread; synchronous recording/web hosts.
import <io>;
import <list>;
import <mem>;
import <string>;

extern void abort();

struct Key { bool set; int64 value; }
Key key(int64 value) { return Key{true, value}; }
struct Style { Key key; int gap = 8; int padding = 0; }

// A subscription is one entry on each side, each holding the other's index, so either
// side removes it in O(1) by swapping in its last entry.
struct Reader { *Observer observer; int at; }
struct Edge { *Source source; int at; }
struct Source {
    List<Reader> readers;
    *Observer memo;
    // The observer run that last subscribed: a second read in the same run is not a new edge.
    *Observer marked;
    int64 marked_epoch;
}
struct Observer {
    int kind;
    *Node owner;
    List<Edge> deps;
    // Unique per run across all observers (ui_epochs), so a freed observer's mark never
    // matches a new one at the same address.
    int64 epoch;
    bool dirty;
    bool evaluating;
    bool queued;
    fn()->void compute;
    fn()->void cleanup;
    bool has_cleanup;
    *Source output;
}
// int64 key -> node, open addressing. Built per run, only for children that have keys.
struct KeyTable { List<int64> keys; List<*Node> nodes; int mask; int count; }

void KeyTable_init(*KeyTable self, int expected) {
    int cap = 8;
    while (cap < expected * 2) { cap = cap * 2; }
    self.mask = cap - 1;
    for (i in 0..cap) { self.keys.push(0); self.nodes.push(null); }
}

int KeyTable_slot(*KeyTable self, int64 key) {
    int64 h = key * 0x9E3779B97F4A7C15;
    int at = (int)((h ^ (h >> 31)) & (int64)self.mask);
    while (self.nodes.data[at] != null && self.keys.data[at] != key) { at = (at + 1) & self.mask; }
    return at;
}

*Node KeyTable_get(*KeyTable self, int64 key) { return self.nodes.data[self.slot(key)]; }

void KeyTable_free(*KeyTable self) {
    self.keys.free(); self.nodes.free(); self.mask = 0; self.count = 0;
}

void KeyTable_put(*KeyTable self, int64 key, *Node node) {
    if ((self.count + 1) * 2 > self.mask + 1) {
        // Keep it at most half full: rehash into twice the room.
        KeyTable old = *self;
        *self = KeyTable{};
        KeyTable_init(self, old.mask + 1);
        for (i in 0..old.mask + 1) {
            if (old.nodes.data[i] != null) { self.put(old.keys.data[i], old.nodes.data[i]); }
        }
        old.free();
    }
    int at = self.slot(key);
    if (self.nodes.data[at] == null) { self.count++; }
    self.keys.data[at] = key;
    self.nodes.data[at] = node;
}

struct Slot { int kind; *void tag; *void data; fn()->void dispose; *Observer observer; }
struct Node {
    int id;
    int generation;
    int kind;
    int depth;
    Key key;
    // A component's name for diagnostics (Scope); a literal, not copied.
    string name;
    int gap;
    int padding;
    *Node parent;
    List<*Node> children;
    List<*Node> emitted;
    // Matching state while this node's block runs. Up to kSmall children are matched by
    // scanning; more get the tables.
    bool indexed;
    int old_index;
    List<*Node> old_unkeyed;
    int unkeyed_emitted;
    KeyTable old_keys;
    KeyTable new_keys;
    List<Slot> slots;
    int cursor;
    bool mounted;
    bool seen;
    bool fresh;
    bool next;
    bool current;
    int runs;
    int loop_frames;
    bool render_write;
    *Observer observer;
    fn()->void block;
    fn()->void handler;
    fn()->void handler_cleanup;
    string text;
}
struct Mutation { int op; int id; int generation; int parent; int before; int kind; string text; }
struct Event { int id; int generation; }
struct Ui {
    *Node root;
    *Node builder;
    *Observer tracking;
    // Index = node id; null once the node is unmounted. An id is reused only after the
    // commit that removed its node completes, with the next generation.
    List<*Node> by_id;
    List<int> generations;
    List<int> retired_ids;
    List<int> free_ids;
    // Work lists, so a frame touches only what changed.
    List<*Node> next_nodes;
    List<*Node> render_writes;
    List<*Node> looping;
    List<*Observer> dirty_memos;
    List<*Observer> dirty_effects;
    List<Mutation> mutations;
    List<fn()->void> writes;
    List<fn()->void> retired;
    List<fn()->void> finalizers;
    List<Event> events;
    fn(*Mutation, int)->void apply;
    int phase;
    int sequence;
    // Release behavior: a duplicate key warns and is treated as unkeyed instead of
    // stopping the program.
    bool lenient;
    // The name the next element takes (Scope), cleared as soon as it is taken.
    string next_name;
    bool in_flight;
}
*Ui ui;
int64 ui_epochs;
const int kSmall = 8;

string ui_kind_name(int kind) {
    if (kind == 1) { return "Column"; }
    if (kind == 2) { return "Row"; }
    if (kind == 3) { return "Text"; }
    if (kind == 4) { return "Button"; }
    return "Scope";
}

// Where the running block is, from the root down: `Column[0] > Row[key 3]`, each step
// the component name or element kind with its key or its index among its siblings.
void ui_scope_path(*String out) {
    List<*Node> steps;
    *Node node = ui == null ? null : ui.builder;
    while (node != null && node.parent != null) { steps.push(node); node = node.parent; }
    if (steps.size == 0) { String_append(out, "the root block"); }
    for (int i = steps.size - 1; i >= 0; i--) {
        *Node step = steps.data[i];
        String_append(out, step.name != null ? step.name : ui_kind_name(step.kind));
        if (step.key.set) {
            String_appendf(out, "[key %lld]", step.key.value);
        } else {
            *Node parent = step.parent;
            int index = -1;
            List<*Node>* siblings = parent.emitted.size > 0 ? &parent.emitted : &parent.children;
            for (j in 0..siblings.size) { if (siblings.data[j] == step) { index = j; break; } }
            String_appendf(out, "[%d]", index);
        }
        if (i > 0) { String_append(out, " > "); }
    }
    steps.free();
}

void ui_fail(string message) {
    // stderr is unbuffered: the message survives the abort when output goes to a file.
    String text;
    String_appendf(&text, "ui: %s\n  in ", message);
    ui_scope_path(&text);
    println_err(text.data);
    abort();
}

void ui_require(bool ok, string message) {
    if (!ok) { ui_fail(message); }
}

string ui_copy(string text) {
    int64 n = strlen(text);
    *char copy = alloc<char>(n + 1);
    memcpy(copy, text, (size_t)(n + 1));
    return (string)copy;
}

void ui_release_closure(escaping fn()->void callback) { free_closure(callback); }

void ui_retire(escaping fn()->void dispose) { ui.retired.push(dispose); }
void ui_emit(int op, *Node node, int before) {
    ui.mutations.push(Mutation{op, node.id, node.generation,
        node.parent == null ? 0 : node.parent.id, before, node.kind, node.text});
}

void ui_remove_reader(*Source source, int at) {
    int last = source.readers.size - 1;
    if (at != last) {
        Reader moved = source.readers.data[last];
        source.readers.data[at] = moved;
        moved.observer.deps.data[moved.at].at = at;
    }
    source.readers.size = last;
}

void ui_remove_edge(*Observer observer, int at) {
    int last = observer.deps.size - 1;
    if (at != last) {
        Edge moved = observer.deps.data[last];
        observer.deps.data[at] = moved;
        moved.source.readers.data[moved.at].at = at;
    }
    observer.deps.size = last;
}

// Drop every subscription of the observer; a new run subscribes again.
void ui_untrack(*Observer observer) {
    for (int i = observer.deps.size - 1; i >= 0; i--) {
        Edge edge = observer.deps.data[i];
        ui_remove_reader(edge.source, edge.at);
    }
    observer.deps.size = 0;
    observer.epoch = ++ui_epochs;
}

void ui_track(*Source source) {
    if (ui == null) { return; }
    *Observer observer = ui.tracking;
    if (observer == null) { return; }
    if (source.marked == observer && source.marked_epoch == observer.epoch) { return; }
    // A memo validated between two reads moves the mark; a short dependency list is
    // checked directly. A longer one may get a duplicate edge, which only costs a visit.
    if (observer.deps.size <= kSmall) {
        for (i in 0..observer.deps.size) {
            if (observer.deps.data[i].source == source) { return; }
        }
    }
    source.marked = observer;
    source.marked_epoch = observer.epoch;
    observer.deps.push(Edge{source, source.readers.size});
    source.readers.push(Reader{observer, observer.deps.size - 1});
}

void ui_drop_from(List<*Node>* list, *Node node) {
    for (int i = list.size - 1; i >= 0; i--) {
        if (list.data[i] == node) { list.remove(i); return; }
    }
}

void ui_schedule(*Node node) {
    if (node.next) { return; }
    node.next = true;
    ui.next_nodes.push(node);
}

void ui_queue(List<*Observer>* list, *Observer observer) {
    if (observer.queued) { return; }
    observer.queued = true;
    list.push(observer);
}

void ui_unqueue(List<*Observer>* list, *Observer observer) {
    if (!observer.queued) { return; }
    observer.queued = false;
    for (int i = list.size - 1; i >= 0; i--) {
        if (list.data[i] == observer) { list.remove(i); return; }
    }
}

void ui_changed(*Source source) {
    if (ui == null) { return; }
    for (i in 0..source.readers.size) {
        *Observer observer = source.readers.data[i].observer;
        observer.dirty = true;
        if (observer.kind == 1) {
            ui_queue(&ui.dirty_memos, observer);
            ui_stale_memos(observer.output);
        } else if (observer.kind == 2) {
            ui_queue(&ui.dirty_effects, observer);
        } else {
            ui_schedule(observer.owner);
            if (ui.phase == 1 && !observer.owner.render_write) {
                observer.owner.render_write = true;
                ui.render_writes.push(observer.owner);
            }
        }
    }
}

void ui_stale_memos(*Source source) {
    for (i in 0..source.readers.size) {
        *Observer reader = source.readers.data[i].observer;
        if (reader.kind == 1 && !reader.dirty) {
            reader.dirty = true;
            ui_queue(&ui.dirty_memos, reader);
            ui_stale_memos(reader.output);
        }
    }
}

// Forget a source that is being freed: no observer keeps it as a dependency.
void ui_detach_source(*Source source) {
    for (int i = source.readers.size - 1; i >= 0; i--) {
        Reader reader = source.readers.data[i];
        ui_remove_edge(reader.observer, reader.at);
    }
    source.readers.free();
    source.marked = null;
}

void ui_validate(*Observer observer) {
    ui_require(!observer.evaluating, "memo cycle");
    if (!observer.dirty) { return; }
    observer.evaluating = true;
    *Observer previous = ui.tracking;
    ui_untrack(observer);
    ui.tracking = observer;
    observer.dirty = false;
    observer.compute();
    ui.tracking = previous;
    observer.evaluating = false;
}

*Observer ui_observer(int kind, *Node owner) {
    *Observer observer = alloc<Observer>(1);
    observer.kind = kind;
    observer.owner = owner;
    observer.epoch = ++ui_epochs;
    return observer;
}

void ui_drop_observer(*Observer observer) {
    ui_untrack(observer);
    ui_unqueue(observer.kind == 1 ? &ui.dirty_memos : &ui.dirty_effects, observer);
    if (observer.has_cleanup) { observer.cleanup(); ui_release_closure(observer.cleanup); }
    if (observer.kind != 0) { ui_release_closure(observer.compute); }
    observer.deps.free();
    free(observer);
}

string ui_hook_name(int kind) {
    if (kind == 0) { return "use_signal"; }
    if (kind == 1) { return "use_memo"; }
    if (kind == 2) { return "use_effect"; }
    return "use_string";
}

*Slot ui_slot(int kind, *void tag) {
    *Node node = ui.builder;
    ui_require(node != null && ui.phase == 1, "hook outside render");
    int index = node.cursor++;
    if (index == node.slots.size) {
        ui_require(!node.mounted, "hook count increased");
        node.slots.push(Slot{kind: kind, tag: tag});
    }
    *Slot slot = &node.slots.data[index];
    if (slot.kind != kind || slot.tag != tag) {
        String message;
        if (slot.kind != kind) {
            String_appendf(&message, "hook kind/type changed at slot %d: expected %s, found %s",
                index, ui_hook_name(slot.kind), ui_hook_name(kind));
        } else {
            String_appendf(&message, "hook kind/type changed at slot %d: %s with another type",
                index, ui_hook_name(kind));
        }
        ui_fail(message.data);
    }
    return slot;
}

struct Signal<T> { T value; Source source; }
*Signal<T> use_signal<T>(T initial) {
    static int tag;
    *Slot slot = ui_slot(0, &tag);
    if (slot.data == null) {
        *Signal<T> signal = alloc<Signal<T>>(1);
        signal.value = initial;
        slot.data = signal;
        slot.dispose = void() { ui_detach_source(&signal.source); free(signal); };
    }
    return (*Signal<T>)slot.data;
}

// A signal owned by the app's model rather than by a scope: it outlives any mount, works
// with no runtime, and is freed by its owner (after the UI that reads it is shut down).
*Signal<T> signal_new<T>(T initial) {
    *Signal<T> signal = alloc<Signal<T>>(1);
    signal.value = initial;
    return signal;
}

void Signal_free<T>(Signal<T>* self) {
    ui_detach_source(&self.source);
    free(self);
}

T Signal_get<T>(Signal<T>* self) {
    if (self.source.memo != null) { ui_validate(self.source.memo); }
    ui_track(&self.source);
    return self.value;
}

void Signal_apply<T>(Signal<T>* self, T value) {
    if (self.value == value) { return; }
    self.value = value;
    ui_changed(&self.source);
}

void Signal_set<T>(Signal<T>* self, T value) {
    ui_require(ui == null || ui.tracking == null || ui.tracking.kind != 1, "memo must be pure");
    if (ui != null && ui.phase == 1) {
        ui.writes.push(void() { self.apply(value); });
    } else { self.apply(value); }
}

struct Memo<T> { Signal<T> signal; fn()->T callback; bool initialized; }
*Signal<T> use_memo<T>(escaping fn()->T callback) {
    static int tag;
    *Slot slot = ui_slot(1, &tag);
    *Memo<T> memo = (*Memo<T>)slot.data;
    if (memo == null) {
        memo = alloc<Memo<T>>(1);
        slot.data = memo;
        *Observer observer = ui_observer(1, ui.builder);
        slot.observer = observer;
        observer.output = &memo.signal.source;
        memo.signal.source.memo = observer;
        observer.compute = void() {
            T value = memo.callback();
            bool changed = !memo.initialized || memo.signal.value != value;
            memo.signal.value = value;
            memo.initialized = true;
            if (changed) { ui_changed(&memo.signal.source); }
        };
        slot.dispose = void() {
            ui_drop_observer(memo.signal.source.memo);
            ui_detach_source(&memo.signal.source);
            free_closure(memo.callback);
            free(memo);
        };
    } else { free_closure(memo.callback); }
    memo.callback = callback;
    memo.signal.source.memo.dirty = true;
    ui_queue(&ui.dirty_memos, memo.signal.source.memo);
    return &memo.signal;
}

void use_effect(escaping fn()->void callback) {
    static int tag;
    *Slot slot = ui_slot(2, &tag);
    *Observer effect = (*Observer)slot.data;
    if (effect == null) {
        effect = ui_observer(2, ui.builder);
        slot.data = effect;
        slot.observer = effect;
        slot.dispose = void() { ui_drop_observer(effect); };
    } else { ui_release_closure(effect.compute); }
    effect.compute = callback;
    effect.dirty = true;
    ui_queue(&ui.dirty_effects, effect);
}

void on_cleanup(escaping fn()->void callback) {
    ui_require(ui.tracking != null && ui.tracking.kind == 2, "on_cleanup outside effect");
    ui_require(!ui.tracking.has_cleanup, "only one cleanup per effect");
    ui.tracking.cleanup = callback;
    ui.tracking.has_cleanup = true;
}

// Which entries of `seq` (old positions, -1 for new nodes) form a longest increasing
// subsequence: those children keep their place, every other one moves.
List<bool> ui_kept(List<int>* seq) {
    List<bool> kept;
    List<int> previous;
    List<int> tails;
    for (i in 0..seq.size) { kept.push(false); previous.push(-1); }
    for (i in 0..seq.size) {
        int value = seq.data[i];
        if (value < 0) { continue; }
        int lo = 0;
        int hi = tails.size;
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (seq.data[tails.data[mid]] < value) { lo = mid + 1; } else { hi = mid; }
        }
        if (lo > 0) { previous.data[i] = tails.data[lo - 1]; }
        if (lo == tails.size) { tails.push(i); } else { tails.data[lo] = i; }
    }
    int at = tails.size > 0 ? tails.data[tails.size - 1] : -1;
    while (at >= 0) { kept.data[at] = true; at = previous.data[at]; }
    previous.free(); tails.free();
    return kept;
}

void ui_run(*Node node) {
    node.current = false;
    node.runs++;
    node.cursor = 0;
    node.indexed = node.children.size > kSmall;
    int keyed = 0;
    for (i in 0..node.children.size) {
        *Node child = node.children.data[i];
        child.seen = false;
        child.old_index = i;
        if (child.key.set) { keyed++; } else if (node.indexed) { node.old_unkeyed.push(child); }
    }
    if (keyed > 0 && node.indexed) {
        KeyTable_init(&node.old_keys, keyed);
        for (i in 0..node.children.size) {
            *Node child = node.children.data[i];
            if (child.key.set) { node.old_keys.put(child.key.value, child); }
        }
    }
    node.unkeyed_emitted = 0;
    *Node previous_builder = ui.builder;
    *Observer previous_tracking = ui.tracking;
    ui.builder = node;
    ui_untrack(node.observer);
    ui.tracking = node.observer;
    node.block();
    ui_require(node.cursor == node.slots.size, "hook count decreased");
    ui.builder = previous_builder;
    ui.tracking = previous_tracking;
    node.old_unkeyed.free();
    if (node.old_keys.mask != 0) { node.old_keys.free(); }
    if (node.new_keys.mask != 0) { node.new_keys.free(); }
    for (int i = node.children.size - 1; i >= 0; i--) {
        if (!node.children.data[i].seen) { ui_unmount(node.children.data[i]); }
    }
    // Back to front, each child goes before the one after it, which is already placed.
    // The kept children keep their place; when the old ones kept their order, all do.
    bool ordered = true;
    int last = -1;
    for (i in 0..node.emitted.size) {
        *Node child = node.emitted.data[i];
        if (!child.fresh) {
            if (child.old_index < last) { ordered = false; break; }
            last = child.old_index;
        }
    }
    List<bool> kept;
    if (!ordered) {
        List<int> seq;
        for (i in 0..node.emitted.size) {
            *Node child = node.emitted.data[i];
            seq.push(child.fresh ? -1 : child.old_index);
        }
        kept = ui_kept(&seq);
        seq.free();
    }
    int before = 0;
    for (int i = node.emitted.size - 1; i >= 0; i--) {
        *Node child = node.emitted.data[i];
        if (child.fresh) { ui_emit(4, child, before); }
        else if (!ordered && !kept.data[i]) { ui_emit(5, child, before); }
        child.fresh = false;
        before = child.id;
    }
    kept.free();
    node.children.free();
    node.children = node.emitted;
    node.emitted = List<*Node>{};
    node.mounted = true;
}

void ui_unmount(*Node node) {
    for (int i = node.children.size - 1; i >= 0; i--) { ui_unmount(node.children.data[i]); }
    ui_emit(6, node, 0);
    if (node.next) { ui_drop_from(&ui.next_nodes, node); node.next = false; }
    if (node.render_write) { ui_drop_from(&ui.render_writes, node); node.render_write = false; }
    if (node.loop_frames > 0) { ui_drop_from(&ui.looping, node); node.loop_frames = 0; }
    node.current = false;
    node.seen = false;
    // Detach dependencies immediately, destroy resources after renderer completion.
    ui_untrack(node.observer);
    for (i in 0..node.slots.size) {
        *Observer hook = node.slots.data[i].observer;
        if (hook != null) {
            ui_untrack(hook);
            ui_unqueue(hook.kind == 1 ? &ui.dirty_memos : &ui.dirty_effects, hook);
        }
    }
    ui.by_id.data[node.id] = null;
    ui.retired_ids.push(node.id);
    // Every unmount cleanup runs while ALL retired state is still alive. A cleanup
    // may read a signal registered after its own hook, or state in a sibling scope.
    ui.finalizers.push(void() {
        for (i in 0..node.slots.size) {
            Slot slot = node.slots.data[i];
            if (slot.kind == 2) {
                *Observer effect = (*Observer)slot.data;
                if (effect.has_cleanup) {
                    effect.cleanup(); ui_release_closure(effect.cleanup);
                    effect.has_cleanup = false;
                }
            }
        }
        node.handler_cleanup();
    });
    ui_retire(void() {
        for (int i = node.slots.size - 1; i >= 0; i--) {
            Slot slot = node.slots.data[i];
            slot.dispose(); ui_release_closure(slot.dispose);
        }
        ui_drop_observer(node.observer);
        ui_release_closure(node.block);
        ui_release_closure(node.handler);
        ui_release_closure(node.handler_cleanup);
        free(node.text);
        node.slots.free(); node.children.free(); node.emitted.free();
        free(node);
    });
}

*Node ui_element(int kind, Style style, string text,
    escaping fn()->void block, escaping fn()->void handler, escaping fn()->void handler_cleanup) {
    *Node parent = ui.builder;
    ui_require(parent != null, "element outside render");
    // A keyed child matches the old child with its key, an unkeyed one the old unkeyed
    // child at its position; either only if the kind is the same.
    *Node node = null;
    *Node candidate = null;
    if (style.key.set) {
        int64 k = style.key.value;
        if (parent.new_keys.mask == 0 && parent.emitted.size >= kSmall) {
            KeyTable_init(&parent.new_keys, parent.emitted.size * 2);
            for (i in 0..parent.emitted.size) {
                *Node sibling = parent.emitted.data[i];
                if (sibling.key.set) { parent.new_keys.put(sibling.key.value, sibling); }
            }
        }
        bool duplicate = false;
        if (parent.new_keys.mask != 0) {
            duplicate = parent.new_keys.get(k) != null;
        } else {
            for (i in 0..parent.emitted.size) {
                *Node sibling = parent.emitted.data[i];
                if (sibling.key.set && sibling.key.value == k) { duplicate = true; }
            }
        }
        if (duplicate) {
            String message;
            String_appendf(&message, "duplicate key %lld at child %d", k, parent.emitted.size);
            if (!ui.lenient) { ui_fail(message.data); }
            String_append(&message, ", treated as unkeyed\n  in ");
            ui_scope_path(&message);
            print_err("ui: warning: "); println_err(message.data);
            String_free(&message);
            style.key = Key{};
        }
    }
    if (style.key.set) {
        int64 k = style.key.value;
        if (parent.indexed) {
            if (parent.old_keys.mask != 0) { candidate = parent.old_keys.get(k); }
        } else {
            for (i in 0..parent.children.size) {
                *Node old = parent.children.data[i];
                if (old.key.set && old.key.value == k) { candidate = old; break; }
            }
        }
    } else {
        int position = parent.unkeyed_emitted++;
        if (parent.indexed) {
            if (position < parent.old_unkeyed.size) { candidate = parent.old_unkeyed.data[position]; }
        } else {
            for (i in 0..parent.children.size) {
                *Node old = parent.children.data[i];
                if (!old.key.set) {
                    if (position == 0) { candidate = old; break; }
                    position--;
                }
            }
        }
    }
    if (candidate != null && !candidate.seen && candidate.kind == kind) { node = candidate; }
    bool fresh = node == null;
    if (fresh) {
        node = alloc<Node>(1);
        ui_assign_id(node);
        node.kind = kind; node.key = style.key; node.parent = parent;
        node.depth = parent.depth + 1;
        node.fresh = true;
        node.observer = ui_observer(0, node);
        ui_emit(1, node, 0);
    } else {
        fn()->void old_block = node.block;
        fn()->void old_handler = node.handler;
        fn()->void old_cleanup = node.handler_cleanup;
        ui_retire(void() { ui_release_closure(old_block); });
        ui_retire(void() { ui_release_closure(old_handler); old_cleanup(); ui_release_closure(old_cleanup); });
    }
    node.seen = true;
    node.name = ui.next_name;
    ui.next_name = null;
    if (style.key.set && parent.new_keys.mask != 0) { parent.new_keys.put(style.key.value, node); }
    if (fresh || node.gap != style.gap || node.padding != style.padding) {
        node.gap = style.gap; node.padding = style.padding;
        ui.mutations.push(Mutation{2, node.id, node.generation, parent.id,
            style.padding, style.gap, null});
    }
    node.block = block;
    node.handler = handler;
    node.handler_cleanup = handler_cleanup;
    if (kind == 4) { ui_emit(7, node, 0); }
    if (text != null && (node.text == null || strcmp(text, node.text) != 0)) {
        string previous = node.text;
        if (previous != null) { ui_retire(void() { free(previous); }); }
        node.text = ui_copy(text);
        ui_emit(3, node, 0);
    }
    parent.emitted.push(node);
    ui_run(node);
    return node;
}

void Column(Style style, escaping fn()->void block) { ui_element(1, style, null, block, void() {}, void() {}); }
void Row(Style style, escaping fn()->void block) { ui_element(2, style, null, block, void() {}, void() {}); }
// A component's own scope: state, identity and its name in diagnostics.
void Scope(string name, Key k, escaping fn()->void block) {
    ui.next_name = name;
    ui_element(0, Style{key: k}, null, block, void() {}, void() {});
}
void Text(string text) { ui_element(3, Style{}, text, void() {}, void() {}, void() {}); }
void Button(string text, escaping fn()->void handler) { ui_element(4, Style{}, text, void() {}, handler, void() {}); }
void Button_owned(string text, escaping fn()->void handler, escaping fn()->void cleanup) {
    ui_element(4, Style{}, text, void() {}, handler, cleanup);
}

void ui_assign_id(*Node node) {
    if (ui.free_ids.size > 0) {
        node.id = ui.free_ids.data[--ui.free_ids.size];
    } else {
        node.id = ui.by_id.size;
        ui.by_id.push(null);
        ui.generations.push(0);
    }
    node.generation = ++ui.generations.data[node.id];
    ui.by_id.data[node.id] = node;
}

void ui_init(*Ui runtime, escaping fn(*Mutation, int)->void apply) {
    ui = runtime;
    ui.apply = apply;
    ui.by_id.push(null);
    ui.generations.push(0);
    *Node root = alloc<Node>(1);
    ui_assign_id(root);
    root.block = void() {}; root.handler = void() {}; root.handler_cleanup = void() {};
    root.observer = ui_observer(0, root);
    ui.root = root;
}

void ui_mount(escaping fn()->void block) {
    ui_require(!ui.root.next && !ui.root.mounted, "already mounted");
    ui.root.block = block;
    ui_schedule(ui.root);
}

// The indices of `depths` ordered by depth, ties in their order (a counting sort: stable
// and linear). Parents come before children.
List<int> ui_by_depth(List<int>* depths) {
    int deepest = 0;
    for (i in 0..depths.size) { if (depths.data[i] > deepest) { deepest = depths.data[i]; } }
    List<int> starts;
    for (i in 0..deepest + 2) { starts.push(0); }
    for (i in 0..depths.size) { starts.data[depths.data[i] + 1]++; }
    for (i in 1..deepest + 2) { starts.data[i] += starts.data[i - 1]; }
    List<int> order;
    for (i in 0..depths.size) { order.push(0); }
    for (i in 0..depths.size) { order.data[starts.data[depths.data[i]]++] = i; }
    starts.free();
    return order;
}

// One pass over the effects dirty at completion, parents first and, within a depth, in
// the order they were scheduled. An effect dirtied again after it ran waits for the next
// commit.
void ui_run_effects() {
    List<*Observer> due = ui.dirty_effects;
    ui.dirty_effects = List<*Observer>{};
    List<int> depths;
    for (i in 0..due.size) { depths.push(due.data[i].owner.depth); }
    List<int> order = ui_by_depth(&depths);
    for (i in 0..order.size) {
        *Observer effect = due.data[order.data[i]];
        effect.queued = false;
        if (!effect.dirty) { continue; }
        if (effect.has_cleanup) {
            effect.cleanup(); ui_release_closure(effect.cleanup); effect.has_cleanup = false;
        }
        ui_validate(effect);
    }
    order.free();
    depths.free();
    due.free();
}

void ui_complete(int sequence) {
    ui_require(ui.in_flight && sequence == ui.sequence, "invalid commit completion");
    ui.in_flight = false;
    for (i in 0..ui.finalizers.size) {
        fn()->void finalize = ui.finalizers.data[i];
        finalize(); ui_release_closure(finalize);
    }
    ui.finalizers.size = 0;
    for (i in 0..ui.retired.size) {
        fn()->void dispose = ui.retired.data[i];
        dispose(); ui_release_closure(dispose);
    }
    ui.retired.size = 0;
    // The renderer has applied the removals: their ids are free again.
    for (i in 0..ui.retired_ids.size) { ui.free_ids.push(ui.retired_ids.data[i]); }
    ui.retired_ids.size = 0;
    ui.mutations.size = 0;
    ui.phase = 2;
    ui_run_effects();
    ui.phase = 0;
    // Events that arrived while the commit was in flight, in arrival order.
    for (i in 0..ui.events.size) {
        Event event = ui.events.data[i];
        ui_dispatch_now(event.id, event.generation);
    }
    ui.events.size = 0;
}

// A throw out of a block, handler or effect is not caught by the runtime: the program
// stops through the uncaught-exception reporter. A caller that catches it anyway leaves
// the runtime mid-phase, and the next entry point stops here instead of running on it.
void ui_require_consistent() {
    ui_require(ui.phase == 0 && ui.builder == null && ui.tracking == null,
        "runtime left mid-phase (an exception escaped a block, handler or effect)");
}

bool ui_memo_work() {
    for (i in 0..ui.dirty_memos.size) {
        *Observer memo = ui.dirty_memos.data[i];
        if (memo.dirty && memo.output.readers.size > 0) { return true; }
    }
    return false;
}

bool ui_frame() {
    ui_require_consistent();
    ui_require(!ui.in_flight, "frame while commit in flight");
    // Validate observed memos even when their consumers have not been scheduled yet.
    // Validation can queue more memos; the loop reaches them too.
    for (int i = 0; i < ui.dirty_memos.size; i++) {
        *Observer memo = ui.dirty_memos.data[i];
        memo.queued = false;
        if (memo.dirty && memo.output.readers.size > 0) { ui_validate(memo); }
    }
    ui.dirty_memos.size = 0;
    if (ui.next_nodes.size == 0 && ui.dirty_effects.size == 0) { return false; }
    List<*Node> due = ui.next_nodes;
    ui.next_nodes = List<*Node>{};
    List<int> depths;
    for (i in 0..due.size) {
        due.data[i].next = false; due.data[i].current = true;
        depths.push(due.data[i].depth);
    }
    // Parents before children: a parent's run re-runs a dirty child and clears it.
    List<int> order = ui_by_depth(&depths);
    ui.phase = 1;
    for (i in 0..order.size) {
        *Node node = due.data[order.data[i]];
        if (node.current) { ui_run(node); }
    }
    order.free();
    depths.free();
    due.free();
    for (i in 0..ui.writes.size) {
        fn()->void write = ui.writes.data[i];
        write(); ui_release_closure(write);
    }
    ui.writes.size = 0;
    for (i in 0..ui.looping.size) {
        if (!ui.looping.data[i].render_write) { ui.looping.data[i].loop_frames = 0; }
    }
    ui.looping.size = 0;
    for (i in 0..ui.render_writes.size) {
        *Node node = ui.render_writes.data[i];
        node.render_write = false;
        node.loop_frames++;
        ui_require(node.loop_frames < 100, "render loop (100 frames)");
        ui.looping.push(node);
    }
    ui.render_writes.size = 0;
    ui.phase = 0;
    ui.sequence++;
    ui.in_flight = true;
    ui.apply(ui.mutations.data, ui.mutations.size);
    return true;
}

// Dispatch now, or queue until the commit in flight completes. Returns false only for an
// event dispatched now whose node is gone or stale; a queued one is checked when it runs.
bool ui_event(int id, int generation) {
    if (ui.in_flight || ui.phase != 0) {
        ui.events.push(Event{id, generation});
        return true;
    }
    ui_require_consistent();
    return ui_dispatch_now(id, generation);
}

bool ui_dispatch_now(int id, int generation) {
    if (id <= 0 || id >= ui.by_id.size) { return false; }
    *Node node = ui.by_id.data[id];
    if (node == null || node.generation != generation || node.kind != 4) { return false; }
    node.handler();
    return true;
}

bool ui_needs_frame() {
    if (ui == null || ui.in_flight) { return false; }
    return ui.next_nodes.size > 0 || ui.dirty_effects.size > 0 || ui_memo_work();
}

void ui_shutdown() {
    ui_require(!ui.in_flight, "shutdown while commit in flight");
    ui_unmount(ui.root);
    ui.root = null;
    ui.sequence++; ui.in_flight = true;
    ui.apply(ui.mutations.data, ui.mutations.size);
    ui_require(!ui.in_flight, "prototype shutdown requires synchronous renderer");
    free_closure(ui.apply);
    ui.by_id.free(); ui.generations.free(); ui.retired_ids.free(); ui.free_ids.free();
    ui.next_nodes.free(); ui.render_writes.free(); ui.looping.free();
    ui.dirty_memos.free(); ui.dirty_effects.free();
    ui.mutations.free(); ui.writes.free(); ui.retired.free();
    ui.finalizers.free(); ui.events.free();
    ui = null;
}
