// Phase-0 executable model. Single UI thread; synchronous recording/web hosts.
import <io>;
import <list>;
import <mem>;
import <string>;

extern void abort();

struct Key { bool set; int64 value; }
Key key(int64 value) { return Key{true, value}; }
// `label` is the accessible name (ARIA label, accessibilityLabel, contentDescription).
// width and height are points (0: sized by content and parent); grow shares the free
// space along the parent's direction (flex-grow); wrap lets a row's children flow onto
// more lines (flex-wrap). The visual props: colors from rgb()/rgba() (-1: the platform's
// default), font_size in points and font_weight 100 to 900 (0: default), border_width and
// radius in points, opacity in percent, align (children across the axis) and justify
// (children along it) from the Align and Justify members (0: default).
struct Style {
    Key key; int gap = 8; int padding = 0; string label;
    int width; int height; int grow; bool wrap;
    int64 background = -1; int64 color = -1; int font_size; int font_weight;
    int border_width; int64 border_color = -1; int radius; int opacity = 100;
    int align; int justify;
}

enum Align { AlignDefault, AlignStart, AlignCenter, AlignEnd, AlignStretch }
enum Justify { JustifyDefault, JustifyStart, JustifyCenter, JustifyEnd, JustifyBetween, JustifyAround }

// An opaque color, each channel 0 to 255; rgba adds the alpha.
int64 rgb(int r, int g, int b) { return rgba(r, g, b, 255); }
int64 rgba(int r, int g, int b, int a) {
    return ((int64)(r & 255) << 24) | ((int64)(g & 255) << 16) | ((int64)(b & 255) << 8) | (int64)(a & 255);
}

// A subscription is one entry on each side, each holding the other's index, so either
// side removes it in O(1) by swapping in its last entry.
struct Reader { *Observer observer; int at; }
struct Edge { *Source source; int at; }
struct Source {
    List<Reader> readers;
    *Observer memo;
    // The observer run that last subscribed: a second read in the same run is not a new edge.
    *Observer marked;
    int64 marked_epoch;
}
struct Observer {
    int kind;
    *Node owner;
    List<Edge> deps;
    // Unique per run across all observers (ui_epochs), so a freed observer's mark never
    // matches a new one at the same address.
    int64 epoch;
    bool dirty;
    bool evaluating;
    bool queued;
    fn()->void compute;
    fn()->void cleanup;
    bool has_cleanup;
    *Source output;
}
// int64 key -> node, open addressing. Built per run, only for children that have keys.
struct KeyTable { List<int64> keys; List<*Node> nodes; int mask; int count; }

void KeyTable_init(*KeyTable self, int expected) {
    int cap = 8;
    while (cap < expected * 2) { cap = cap * 2; }
    self.mask = cap - 1;
    for (i in 0..cap) { self.keys.push(0); self.nodes.push(null); }
}

int KeyTable_slot(*KeyTable self, int64 key) {
    int64 h = key * 0x9E3779B97F4A7C15;
    int at = (int)((h ^ (h >> 31)) & (int64)self.mask);
    while (self.nodes.data[at] != null && self.keys.data[at] != key) { at = (at + 1) & self.mask; }
    return at;
}

*Node KeyTable_get(*KeyTable self, int64 key) { return self.nodes.data[self.slot(key)]; }

void KeyTable_free(*KeyTable self) {
    self.keys.free(); self.nodes.free(); self.mask = 0; self.count = 0;
}

void KeyTable_put(*KeyTable self, int64 key, *Node node) {
    if ((self.count + 1) * 2 > self.mask + 1) {
        // Keep it at most half full: rehash into twice the room.
        KeyTable old = *self;
        *self = KeyTable{};
        KeyTable_init(self, old.mask + 1);
        for (i in 0..old.mask + 1) {
            if (old.nodes.data[i] != null) { self.put(old.keys.data[i], old.nodes.data[i]); }
        }
        old.free();
    }
    int at = self.slot(key);
    if (self.nodes.data[at] == null) { self.count++; }
    self.keys.data[at] = key;
    self.nodes.data[at] = node;
}

struct Slot { int kind; *void tag; *void data; fn()->void dispose; *Observer observer; }
struct Node {
    int id;
    int generation;
    int kind;
    int depth;
    Key key;
    // A component's name for diagnostics (Scope); a literal, not copied.
    string name;
    int gap;
    int padding;
    // The value last sent for each int prop (by code), so only a change is sent again.
    int64[24] props;
    *Node parent;
    List<*Node> children;
    List<*Node> emitted;
    // Matching state while this node's block runs. Up to kSmall children are matched by
    // scanning; more get the tables.
    bool indexed;
    int old_index;
    List<*Node> old_unkeyed;
    int unkeyed_emitted;
    KeyTable old_keys;
    KeyTable new_keys;
    List<Slot> slots;
    int cursor;
    bool mounted;
    bool seen;
    bool fresh;
    bool next;
    bool current;
    int runs;
    int loop_frames;
    bool render_write;
    *Observer observer;
    fn()->void block;
    fn()->void handler;
    fn()->void handler_cleanup;
    // TextInput: the new text (borrowed for the call) and focus changes.
    fn(string)->void on_text;
    // TextInput focus changes and Switch toggles.
    fn(bool)->void on_bool;
    // A virtual list (FlatList, SectionList): a scroll that mounts only the rows near its
    // viewport. on_item renders a FlatList row, on_cell a SectionList header (item -1) or row.
    bool virtual;
    int row_count;
    int row_height;
    int header_height;
    *List<int> section_sizes;
    fn(int)->void on_item;
    fn(int, int)->void on_cell;
    int scroll_offset;
    int viewport;
    int rendered_offset;
    int rendered_viewport;
    bool has_on_bool;
    string label;
    string placeholder;
    string source;
    int focused;
    string text;
}
// A commit is one byte buffer, little-endian. Each record is an op byte and the node id
// (u32), then:
//   1 create   generation u32, kind u8
//   2 prop     prop u8, value i32
//   3 text     length u32, the bytes, a NUL
//   4 insert   parent u32, before u32 (0: at the end)
//   5 move     parent u32, before u32
//   6 remove   (nothing)
//   7 listen, 8 unlisten
//   9 string prop  prop u8 (1 label, 2 placeholder, 3 image source), length u32, the bytes, a NUL
// Int props: 1 gap, 2 padding, 3 focused (1 focus, 0 blur), 4 width, 5 height, 6 grow,
// 7 wrap (1 or 0), 8 background and 9 text color (RGBA, 0: platform default), 10 font size,
// 11 font weight, 12 border width, 13 border color, 14 radius, 15 opacity (percent),
// 16 align and 17 justify (Align / Justify), 18 switch on (1 or 0), 19 spinning (1 or 0).
// An input's value is its text. Kinds: 0 scope, 1 column, 2 row, 3 text, 4 button,
// 5 text input, 6 scroll (a column whose content scrolls), 7 image, 8 pressable (a column
// that takes presses), 9 switch, 10 activity indicator.
// The renderer reads it during apply and copies what it keeps.
struct Commit { *uint8 data; int len; int cap; }

void Commit_room(*Commit self, int n) {
    if (self.len + n <= self.cap) { return; }
    int cap = self.cap < 256 ? 256 : self.cap;
    while (self.len + n > cap) { cap = cap * 2; }
    *uint8 grown = alloc<uint8>(cap);
    if (self.len > 0) { memcpy(grown, self.data, (size_t)self.len); }
    free(self.data);
    self.data = grown;
    self.cap = cap;
}

void Commit_u8(*Commit self, int value) {
    self.room(1);
    self.data[self.len++] = (uint8)value;
}

void Commit_u32(*Commit self, int value) {
    self.room(4);
    uint32 v = (uint32)value;
    self.data[self.len] = (uint8)(v & 255);
    self.data[self.len + 1] = (uint8)((v >> 8) & 255);
    self.data[self.len + 2] = (uint8)((v >> 16) & 255);
    self.data[self.len + 3] = (uint8)((v >> 24) & 255);
    self.len += 4;
}

void Commit_free(*Commit self) { free(self.data); *self = Commit{}; }

// A decoded record, for tests and tools; `text` points into the buffer.
struct Mutation { int op; int id; int generation; int parent; int before; int kind; string text; }

int ui_read_u32(*uint8 p) {
    return (int)((uint32)p[0] | ((uint32)p[1] << 8) | ((uint32)p[2] << 16) | ((uint32)p[3] << 24));
}

void ui_decode(*uint8 data, int len, List<Mutation>* out) {
    int at = 0;
    while (at < len) {
        Mutation m = Mutation{op: (int)data[at], id: ui_read_u32(&data[at + 1])};
        at += 5;
        if (m.op == 1) { m.generation = ui_read_u32(&data[at]); m.kind = (int)data[at + 4]; at += 5; }
        else if (m.op == 2) { m.kind = (int)data[at]; m.before = ui_read_u32(&data[at + 1]); at += 5; }
        else if (m.op == 3) {
            int n = ui_read_u32(&data[at]);
            m.text = (string)&data[at + 4];
            at += 4 + n + 1;
        } else if (m.op == 9) {
            m.kind = (int)data[at];
            int n = ui_read_u32(&data[at + 1]);
            m.text = (string)&data[at + 5];
            at += 5 + n + 1;
        } else if (m.op == 4 || m.op == 5) {
            m.parent = ui_read_u32(&data[at]); m.before = ui_read_u32(&data[at + 4]); at += 8;
        }
        out.push(m);
    }
}
// Event kinds: 1 press, 2 change (text), 3 focus (value 1 focused, 0 blurred), 4 toggle
// (value 1 on, 0 off), 5 scroll (value the offset, extra the viewport height).
struct Event { int id; int generation; int kind; int value; string text; int extra; }
// What the host reports about the screen, in points: the system bars and display cutouts
// on each side, and the software keyboard over the bottom.
struct Insets { int top; int right; int bottom; int left; int keyboard; }
struct Window { int width; int height; int scale; }

struct Ui {
    *Node root;
    // The host's environment, read through ui_insets and ui_is_active: a change of either
    // bumps `environment`, which those reads subscribe to.
    Insets insets;
    bool inactive;
    *Signal<int> environment;
    *Node builder;
    *Observer tracking;
    // Index = node id; null once the node is unmounted. An id is reused only after the
    // commit that removed its node completes, with the next generation.
    List<*Node> by_id;
    List<int> generations;
    List<int> retired_ids;
    List<int> free_ids;
    // Work lists, so a frame touches only what changed.
    List<*Node> next_nodes;
    List<*Node> render_writes;
    List<*Node> looping;
    List<*Observer> dirty_memos;
    List<*Observer> dirty_effects;
    Commit commit;
    List<fn()->void> writes;
    List<fn()->void> retired;
    List<fn()->void> finalizers;
    List<Event> events;
    fn(*uint8, int)->void apply;
    int phase;
    int sequence;
    // Release behavior: a duplicate key warns and is treated as unkeyed instead of
    // stopping the program.
    bool lenient;
    // The name the next element takes (Scope), cleared as soon as it is taken.
    string next_name;
    // The input parts of the next element (TextInput), likewise.
    *InputExtra next_input;
    // The source of the next element (Image), likewise.
    string next_source;
    // The value and handler of the next Switch, and whether the next ActivityIndicator spins.
    *SwitchExtra next_switch;
    bool next_animating;
    // The rows and renderer of the next virtual list, likewise.
    *ListExtra next_list;
    // The window the root is in, in points, and its scale (pixels per point, times 100).
    Window window;
    bool in_flight;
}
*Ui ui;
int64 ui_epochs;
const int kSmall = 8;

string ui_kind_name(int kind) {
    if (kind == 10) { return "ActivityIndicator"; }
    if (kind == 9) { return "Switch"; }
    if (kind == 8) { return "Pressable"; }
    if (kind == 7) { return "Image"; }
    if (kind == 6) { return "Scroll"; }
    if (kind == 5) { return "TextInput"; }
    if (kind == 1) { return "Column"; }
    if (kind == 2) { return "Row"; }
    if (kind == 3) { return "Text"; }
    if (kind == 4) { return "Button"; }
    return "Scope";
}

// Where the running block is, from the root down: `Column[0] > Row[key 3]`, each step
// the component name or element kind with its key or its index among its siblings.
void ui_scope_path(*String out) {
    List<*Node> steps;
    *Node node = ui == null ? null : ui.builder;
    while (node != null && node.parent != null) { steps.push(node); node = node.parent; }
    if (steps.size == 0) { String_append(out, "the root block"); }
    for (int i = steps.size - 1; i >= 0; i--) {
        *Node step = steps.data[i];
        String_append(out, step.name != null ? step.name : ui_kind_name(step.kind));
        if (step.key.set) {
            String_appendf(out, "[key %lld]", step.key.value);
        } else {
            *Node parent = step.parent;
            int index = -1;
            List<*Node>* siblings = parent.emitted.size > 0 ? &parent.emitted : &parent.children;
            for (j in 0..siblings.size) { if (siblings.data[j] == step) { index = j; break; } }
            String_appendf(out, "[%d]", index);
        }
        if (i > 0) { String_append(out, " > "); }
    }
    steps.free();
}

void ui_fail(string message) {
    // stderr is unbuffered: the message survives the abort when output goes to a file.
    String text;
    String_appendf(&text, "ui: %s\n  in ", message);
    ui_scope_path(&text);
    println_err(text.data);
    abort();
}

void ui_require(bool ok, string message) {
    if (!ok) { ui_fail(message); }
}

string ui_copy(string text) {
    int64 n = strlen(text);
    *char copy = alloc<char>(n + 1);
    memcpy(copy, text, (size_t)(n + 1));
    return (string)copy;
}

void ui_release_closure(escaping fn()->void callback) { free_closure(callback); }
// Through a parameter: the self-hosted compiler miscompiles free_closure of a captured
// variable inside a lambda.
void ui_release_text(escaping fn(string)->void callback) { free_closure(callback); }
void ui_release_focus(escaping fn(bool)->void callback) { free_closure(callback); }
void ui_release_item(escaping fn(int)->void callback) { free_closure(callback); }
void ui_release_cell(escaping fn(int, int)->void callback) { free_closure(callback); }

void ui_retire(escaping fn()->void dispose) { ui.retired.push(dispose); }
void ui_emit(int op, *Node node, int before) {
    *Commit c = &ui.commit;
    c.u8(op);
    c.u32(node.id);
    if (op == 1) { c.u32(node.generation); c.u8(node.kind); }
    else if (op == 3) {
        int n = (int)strlen(node.text);
        c.u32(n);
        c.room(n + 1);
        memcpy(&c.data[c.len], node.text, (size_t)(n + 1));
        c.len += n + 1;
    } else if (op == 4 || op == 5) {
        c.u32(node.parent == null ? 0 : node.parent.id);
        c.u32(before);
    }
}

void ui_emit_prop(*Node node, int prop, int value) {
    ui.commit.u8(2); ui.commit.u32(node.id); ui.commit.u8(prop); ui.commit.u32(value);
}

// Send int prop `code` when it differs from what was sent; a fresh node starts at the
// default, `unset`. A color's default (-1) goes out as 0, which renderers read as "the
// platform's own".
void ui_prop(*Node node, bool fresh, int code, int64 value, int64 unset) {
    if (fresh) { node.props[code] = unset; }
    if (node.props[code] == value) { return; }
    node.props[code] = value;
    ui_emit_prop(node, code, value == -1 && unset == -1 ? 0 : (int)value);
}

void ui_emit_string_prop(*Node node, int prop, string value) {
    *Commit c = &ui.commit;
    c.u8(9); c.u32(node.id); c.u8(prop);
    if (value == null) { value = ""; }
    int n = (int)strlen(value);
    c.u32(n);
    c.room(n + 1);
    memcpy(&c.data[c.len], value, (size_t)(n + 1));
    c.len += n + 1;
}

// Keep a copy of `value` in `*slot` when it changed, retiring the old one after the
// commit; true when the renderer must hear about it. Null and "" are the same and stored
// as null, so an element without the prop allocates nothing.
bool ui_update_string(*string slot, string value) {
    string current = *slot;
    bool empty = value == null || value[0] == 0;
    if (current == null) {
        if (empty) { return false; }
        *slot = ui_copy(value);
        return true;
    }
    if (!empty && strcmp(current, value) == 0) { return false; }
    ui_retire(void() { free(current); });
    *slot = empty ? null : ui_copy(value);
    return true;
}

void ui_remove_reader(*Source source, int at) {
    int last = source.readers.size - 1;
    if (at != last) {
        Reader moved = source.readers.data[last];
        source.readers.data[at] = moved;
        moved.observer.deps.data[moved.at].at = at;
    }
    source.readers.size = last;
}

void ui_remove_edge(*Observer observer, int at) {
    int last = observer.deps.size - 1;
    if (at != last) {
        Edge moved = observer.deps.data[last];
        observer.deps.data[at] = moved;
        moved.source.readers.data[moved.at].at = at;
    }
    observer.deps.size = last;
}

// Drop every subscription of the observer; a new run subscribes again.
void ui_untrack(*Observer observer) {
    for (int i = observer.deps.size - 1; i >= 0; i--) {
        Edge edge = observer.deps.data[i];
        ui_remove_reader(edge.source, edge.at);
    }
    observer.deps.size = 0;
    observer.epoch = ++ui_epochs;
}

void ui_track(*Source source) {
    if (ui == null) { return; }
    *Observer observer = ui.tracking;
    if (observer == null) { return; }
    if (source.marked == observer && source.marked_epoch == observer.epoch) { return; }
    // A memo validated between two reads moves the mark; a short dependency list is
    // checked directly. A longer one may get a duplicate edge, which only costs a visit.
    if (observer.deps.size <= kSmall) {
        for (i in 0..observer.deps.size) {
            if (observer.deps.data[i].source == source) { return; }
        }
    }
    source.marked = observer;
    source.marked_epoch = observer.epoch;
    observer.deps.push(Edge{source, source.readers.size});
    source.readers.push(Reader{observer, observer.deps.size - 1});
}

void ui_drop_from(List<*Node>* list, *Node node) {
    for (int i = list.size - 1; i >= 0; i--) {
        if (list.data[i] == node) { list.remove(i); return; }
    }
}

void ui_schedule(*Node node) {
    if (node.next) { return; }
    node.next = true;
    ui.next_nodes.push(node);
}

void ui_queue(List<*Observer>* list, *Observer observer) {
    if (observer.queued) { return; }
    observer.queued = true;
    list.push(observer);
}

void ui_unqueue(List<*Observer>* list, *Observer observer) {
    if (!observer.queued) { return; }
    observer.queued = false;
    for (int i = list.size - 1; i >= 0; i--) {
        if (list.data[i] == observer) { list.remove(i); return; }
    }
}

void ui_changed(*Source source) {
    if (ui == null) { return; }
    for (i in 0..source.readers.size) {
        *Observer observer = source.readers.data[i].observer;
        observer.dirty = true;
        if (observer.kind == 1) {
            ui_queue(&ui.dirty_memos, observer);
            ui_stale_memos(observer.output);
        } else if (observer.kind == 2) {
            ui_queue(&ui.dirty_effects, observer);
        } else {
            ui_schedule(observer.owner);
            if (ui.phase == 1 && !observer.owner.render_write) {
                observer.owner.render_write = true;
                ui.render_writes.push(observer.owner);
            }
        }
    }
}

void ui_stale_memos(*Source source) {
    for (i in 0..source.readers.size) {
        *Observer reader = source.readers.data[i].observer;
        if (reader.kind == 1 && !reader.dirty) {
            reader.dirty = true;
            ui_queue(&ui.dirty_memos, reader);
            ui_stale_memos(reader.output);
        }
    }
}

// Forget a source that is being freed: no observer keeps it as a dependency.
void ui_detach_source(*Source source) {
    for (int i = source.readers.size - 1; i >= 0; i--) {
        Reader reader = source.readers.data[i];
        ui_remove_edge(reader.observer, reader.at);
    }
    source.readers.free();
    source.marked = null;
}

void ui_validate(*Observer observer) {
    ui_require(!observer.evaluating, "memo cycle");
    if (!observer.dirty) { return; }
    observer.evaluating = true;
    *Observer previous = ui.tracking;
    ui_untrack(observer);
    ui.tracking = observer;
    observer.dirty = false;
    observer.compute();
    ui.tracking = previous;
    observer.evaluating = false;
}

*Observer ui_observer(int kind, *Node owner) {
    *Observer observer = alloc<Observer>(1);
    observer.kind = kind;
    observer.owner = owner;
    observer.epoch = ++ui_epochs;
    return observer;
}

void ui_drop_observer(*Observer observer) {
    ui_untrack(observer);
    ui_unqueue(observer.kind == 1 ? &ui.dirty_memos : &ui.dirty_effects, observer);
    if (observer.has_cleanup) { observer.cleanup(); ui_release_closure(observer.cleanup); }
    if (observer.kind != 0) { ui_release_closure(observer.compute); }
    observer.deps.free();
    free(observer);
}

string ui_hook_name(int kind) {
    if (kind == 0) { return "use_signal"; }
    if (kind == 1) { return "use_memo"; }
    if (kind == 2) { return "use_effect"; }
    return "use_string";
}

*Slot ui_slot(int kind, *void tag) {
    *Node node = ui.builder;
    ui_require(node != null && ui.phase == 1, "hook outside render");
    int index = node.cursor++;
    if (index == node.slots.size) {
        ui_require(!node.mounted, "hook count increased");
        node.slots.push(Slot{kind: kind, tag: tag});
    }
    *Slot slot = &node.slots.data[index];
    if (slot.kind != kind || slot.tag != tag) {
        String message;
        if (slot.kind != kind) {
            String_appendf(&message, "hook kind/type changed at slot %d: expected %s, found %s",
                index, ui_hook_name(slot.kind), ui_hook_name(kind));
        } else {
            String_appendf(&message, "hook kind/type changed at slot %d: %s with another type",
                index, ui_hook_name(kind));
        }
        ui_fail(message.data);
    }
    return slot;
}

struct Signal<T> { T value; Source source; }
*Signal<T> use_signal<T>(T initial) {
    static int tag;
    *Slot slot = ui_slot(0, &tag);
    if (slot.data == null) {
        *Signal<T> signal = alloc<Signal<T>>(1);
        signal.value = initial;
        slot.data = signal;
        slot.dispose = void() { ui_detach_source(&signal.source); free(signal); };
    }
    return (*Signal<T>)slot.data;
}

// A signal owned by the app's model rather than by a scope: it outlives any mount, works
// with no runtime, and is freed by its owner (after the UI that reads it is shut down).
*Signal<T> signal_new<T>(T initial) {
    *Signal<T> signal = alloc<Signal<T>>(1);
    signal.value = initial;
    return signal;
}

void Signal_free<T>(Signal<T>* self) {
    ui_detach_source(&self.source);
    free(self);
}

T Signal_get<T>(Signal<T>* self) {
    if (self.source.memo != null) { ui_validate(self.source.memo); }
    ui_track(&self.source);
    return self.value;
}

void Signal_apply<T>(Signal<T>* self, T value) {
    if (self.value == value) { return; }
    self.value = value;
    ui_changed(&self.source);
}

void Signal_set<T>(Signal<T>* self, T value) {
    ui_require(ui == null || ui.tracking == null || ui.tracking.kind != 1, "memo must be pure");
    if (ui != null && ui.phase == 1) {
        ui.writes.push(void() { self.apply(value); });
    } else { self.apply(value); }
}

struct Memo<T> { Signal<T> signal; fn()->T callback; bool initialized; }
*Signal<T> use_memo<T>(escaping fn()->T callback) {
    static int tag;
    *Slot slot = ui_slot(1, &tag);
    *Memo<T> memo = (*Memo<T>)slot.data;
    if (memo == null) {
        memo = alloc<Memo<T>>(1);
        slot.data = memo;
        *Observer observer = ui_observer(1, ui.builder);
        slot.observer = observer;
        observer.output = &memo.signal.source;
        memo.signal.source.memo = observer;
        observer.compute = void() {
            T value = memo.callback();
            bool changed = !memo.initialized || memo.signal.value != value;
            memo.signal.value = value;
            memo.initialized = true;
            if (changed) { ui_changed(&memo.signal.source); }
        };
        slot.dispose = void() {
            ui_drop_observer(memo.signal.source.memo);
            ui_detach_source(&memo.signal.source);
            free_closure(memo.callback);
            free(memo);
        };
    } else { free_closure(memo.callback); }
    memo.callback = callback;
    memo.signal.source.memo.dirty = true;
    ui_queue(&ui.dirty_memos, memo.signal.source.memo);
    return &memo.signal;
}

void use_effect(escaping fn()->void callback) {
    static int tag;
    *Slot slot = ui_slot(2, &tag);
    *Observer effect = (*Observer)slot.data;
    if (effect == null) {
        effect = ui_observer(2, ui.builder);
        slot.data = effect;
        slot.observer = effect;
        slot.dispose = void() { ui_drop_observer(effect); };
    } else { ui_release_closure(effect.compute); }
    effect.compute = callback;
    effect.dirty = true;
    ui_queue(&ui.dirty_effects, effect);
}

void on_cleanup(escaping fn()->void callback) {
    ui_require(ui.tracking != null && ui.tracking.kind == 2, "on_cleanup outside effect");
    ui_require(!ui.tracking.has_cleanup, "only one cleanup per effect");
    ui.tracking.cleanup = callback;
    ui.tracking.has_cleanup = true;
}

// Which entries of `seq` (old positions, -1 for new nodes) form a longest increasing
// subsequence: those children keep their place, every other one moves.
List<bool> ui_kept(List<int>* seq) {
    List<bool> kept;
    List<int> previous;
    List<int> tails;
    for (i in 0..seq.size) { kept.push(false); previous.push(-1); }
    for (i in 0..seq.size) {
        int value = seq.data[i];
        if (value < 0) { continue; }
        int lo = 0;
        int hi = tails.size;
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (seq.data[tails.data[mid]] < value) { lo = mid + 1; } else { hi = mid; }
        }
        if (lo > 0) { previous.data[i] = tails.data[lo - 1]; }
        if (lo == tails.size) { tails.push(i); } else { tails.data[lo] = i; }
    }
    int at = tails.size > 0 ? tails.data[tails.size - 1] : -1;
    while (at >= 0) { kept.data[at] = true; at = previous.data[at]; }
    previous.free(); tails.free();
    return kept;
}

void ui_run(*Node node) {
    node.current = false;
    node.runs++;
    node.cursor = 0;
    node.indexed = node.children.size > kSmall;
    int keyed = 0;
    for (i in 0..node.children.size) {
        *Node child = node.children.data[i];
        child.seen = false;
        child.old_index = i;
        if (child.key.set) { keyed++; } else if (node.indexed) { node.old_unkeyed.push(child); }
    }
    if (keyed > 0 && node.indexed) {
        KeyTable_init(&node.old_keys, keyed);
        for (i in 0..node.children.size) {
            *Node child = node.children.data[i];
            if (child.key.set) { node.old_keys.put(child.key.value, child); }
        }
    }
    node.unkeyed_emitted = 0;
    *Node previous_builder = ui.builder;
    *Observer previous_tracking = ui.tracking;
    ui.builder = node;
    ui_untrack(node.observer);
    ui.tracking = node.observer;
    node.block();
    ui_require(node.cursor == node.slots.size, "hook count decreased");
    ui.builder = previous_builder;
    ui.tracking = previous_tracking;
    node.old_unkeyed.free();
    if (node.old_keys.mask != 0) { node.old_keys.free(); }
    if (node.new_keys.mask != 0) { node.new_keys.free(); }
    for (int i = node.children.size - 1; i >= 0; i--) {
        if (!node.children.data[i].seen) { ui_unmount(node.children.data[i]); }
    }
    // Back to front, each child goes before the one after it, which is already placed.
    // The kept children keep their place; when the old ones kept their order, all do.
    bool ordered = true;
    int last = -1;
    for (i in 0..node.emitted.size) {
        *Node child = node.emitted.data[i];
        if (!child.fresh) {
            if (child.old_index < last) { ordered = false; break; }
            last = child.old_index;
        }
    }
    List<bool> kept;
    if (!ordered) {
        List<int> seq;
        for (i in 0..node.emitted.size) {
            *Node child = node.emitted.data[i];
            seq.push(child.fresh ? -1 : child.old_index);
        }
        kept = ui_kept(&seq);
        seq.free();
    }
    int before = 0;
    for (int i = node.emitted.size - 1; i >= 0; i--) {
        *Node child = node.emitted.data[i];
        if (child.fresh) { ui_emit(4, child, before); }
        else if (!ordered && !kept.data[i]) { ui_emit(5, child, before); }
        child.fresh = false;
        before = child.id;
    }
    kept.free();
    node.children.free();
    node.children = node.emitted;
    node.emitted = List<*Node>{};
    node.mounted = true;
}

void ui_unmount(*Node node) {
    for (int i = node.children.size - 1; i >= 0; i--) { ui_unmount(node.children.data[i]); }
    ui_emit(6, node, 0);
    if (node.next) { ui_drop_from(&ui.next_nodes, node); node.next = false; }
    if (node.render_write) { ui_drop_from(&ui.render_writes, node); node.render_write = false; }
    if (node.loop_frames > 0) { ui_drop_from(&ui.looping, node); node.loop_frames = 0; }
    node.current = false;
    node.seen = false;
    // Detach dependencies immediately, destroy resources after renderer completion.
    ui_untrack(node.observer);
    for (i in 0..node.slots.size) {
        *Observer hook = node.slots.data[i].observer;
        if (hook != null) {
            ui_untrack(hook);
            ui_unqueue(hook.kind == 1 ? &ui.dirty_memos : &ui.dirty_effects, hook);
        }
    }
    ui.by_id.data[node.id] = null;
    ui.retired_ids.push(node.id);
    // Every unmount cleanup runs while ALL retired state is still alive. A cleanup
    // may read a signal registered after its own hook, or state in a sibling scope.
    ui.finalizers.push(void() {
        for (i in 0..node.slots.size) {
            Slot slot = node.slots.data[i];
            if (slot.kind == 2) {
                *Observer effect = (*Observer)slot.data;
                if (effect.has_cleanup) {
                    effect.cleanup(); ui_release_closure(effect.cleanup);
                    effect.has_cleanup = false;
                }
            }
        }
        node.handler_cleanup();
    });
    ui_retire(void() {
        for (int i = node.slots.size - 1; i >= 0; i--) {
            Slot slot = node.slots.data[i];
            slot.dispose(); ui_release_closure(slot.dispose);
        }
        ui_drop_observer(node.observer);
        ui_release_closure(node.block);
        ui_release_closure(node.handler);
        ui_release_closure(node.handler_cleanup);
        ui_release_text(node.on_text);
        ui_release_focus(node.on_bool);
        ui_release_item(node.on_item);
        ui_release_cell(node.on_cell);
        free(node.text); free(node.label); free(node.placeholder); free(node.source);
        node.slots.free(); node.children.free(); node.emitted.free();
        free(node);
    });
}

struct SwitchExtra { bool value; fn(bool)->void on_change; }
struct ListExtra { int count; int item_height; int header_height; *List<int> sizes;
    fn(int)->void on_item; fn(int, int)->void on_cell; }

// What an input element adds to an element: set by TextInput before ui_element.
struct InputExtra { fn(string)->void on_text; fn(bool)->void on_focus; bool has_on_focus;
    string placeholder; int focused; }

*Node ui_element(int kind, Style style, string text,
    escaping fn()->void block, escaping fn()->void handler, escaping fn()->void handler_cleanup) {
    *Node parent = ui.builder;
    ui_require(parent != null, "element outside render");
    // A keyed child matches the old child with its key, an unkeyed one the old unkeyed
    // child at its position; either only if the kind is the same.
    *Node node = null;
    *Node candidate = null;
    if (style.key.set) {
        int64 k = style.key.value;
        if (parent.new_keys.mask == 0 && parent.emitted.size >= kSmall) {
            KeyTable_init(&parent.new_keys, parent.emitted.size * 2);
            for (i in 0..parent.emitted.size) {
                *Node sibling = parent.emitted.data[i];
                if (sibling.key.set) { parent.new_keys.put(sibling.key.value, sibling); }
            }
        }
        bool duplicate = false;
        if (parent.new_keys.mask != 0) {
            duplicate = parent.new_keys.get(k) != null;
        } else {
            for (i in 0..parent.emitted.size) {
                *Node sibling = parent.emitted.data[i];
                if (sibling.key.set && sibling.key.value == k) { duplicate = true; }
            }
        }
        if (duplicate) {
            String message;
            String_appendf(&message, "duplicate key %lld at child %d", k, parent.emitted.size);
            if (!ui.lenient) { ui_fail(message.data); }
            String_append(&message, ", treated as unkeyed\n  in ");
            ui_scope_path(&message);
            print_err("ui: warning: "); println_err(message.data);
            String_free(&message);
            style.key = Key{};
        }
    }
    if (style.key.set) {
        int64 k = style.key.value;
        if (parent.indexed) {
            if (parent.old_keys.mask != 0) { candidate = parent.old_keys.get(k); }
        } else {
            for (i in 0..parent.children.size) {
                *Node old = parent.children.data[i];
                if (old.key.set && old.key.value == k) { candidate = old; break; }
            }
        }
    } else {
        int position = parent.unkeyed_emitted++;
        if (parent.indexed) {
            if (position < parent.old_unkeyed.size) { candidate = parent.old_unkeyed.data[position]; }
        } else {
            for (i in 0..parent.children.size) {
                *Node old = parent.children.data[i];
                if (!old.key.set) {
                    if (position == 0) { candidate = old; break; }
                    position--;
                }
            }
        }
    }
    if (candidate != null && !candidate.seen && candidate.kind == kind) { node = candidate; }
    bool fresh = node == null;
    if (fresh) {
        node = alloc<Node>(1);
        ui_assign_id(node);
        node.kind = kind; node.key = style.key; node.parent = parent;
        node.depth = parent.depth + 1;
        node.fresh = true;
        node.observer = ui_observer(0, node);
        ui_emit(1, node, 0);
    } else {
        fn()->void old_block = node.block;
        fn()->void old_handler = node.handler;
        fn()->void old_cleanup = node.handler_cleanup;
        ui_retire(void() { ui_release_closure(old_block); });
        ui_retire(void() { ui_release_closure(old_handler); old_cleanup(); ui_release_closure(old_cleanup); });
        if (node.virtual) {
            fn(int)->void old_item = node.on_item;
            fn(int, int)->void old_cell = node.on_cell;
            ui_retire(void() { ui_release_item(old_item); ui_release_cell(old_cell); });
        }
        if (kind == 5 || kind == 9) {
            fn(string)->void old_text = node.on_text;
            fn(bool)->void old_bool = node.on_bool;
            ui_retire(void() { ui_release_text(old_text); ui_release_focus(old_bool); });
        }
    }
    node.seen = true;
    node.name = ui.next_name;
    ui.next_name = null;
    if (style.key.set && parent.new_keys.mask != 0) { parent.new_keys.put(style.key.value, node); }
    if (fresh || node.gap != style.gap) { node.gap = style.gap; ui_emit_prop(node, 1, style.gap); }
    if (fresh || node.padding != style.padding) {
        node.padding = style.padding;
        ui_emit_prop(node, 2, style.padding);
    }
    // Sizes are sent when set or changed, so most elements send none.
    // Props left at their default are not sent, so most elements send none.
    ui_prop(node, fresh, 4, style.width, 0);
    ui_prop(node, fresh, 5, style.height, 0);
    ui_prop(node, fresh, 6, style.grow, 0);
    ui_prop(node, fresh, 7, style.wrap ? 1 : 0, 0);
    ui_prop(node, fresh, 8, style.background, -1);
    ui_prop(node, fresh, 9, style.color, -1);
    ui_prop(node, fresh, 10, style.font_size, 0);
    ui_prop(node, fresh, 11, style.font_weight, 0);
    ui_prop(node, fresh, 12, style.border_width, 0);
    ui_prop(node, fresh, 13, style.border_color, -1);
    ui_prop(node, fresh, 14, style.radius, 0);
    ui_prop(node, fresh, 15, style.opacity, 100);
    ui_prop(node, fresh, 16, style.align, 0);
    ui_prop(node, fresh, 17, style.justify, 0);
    if (ui_update_string(&node.label, style.label)) { ui_emit_string_prop(node, 1, node.label); }
    node.block = block;
    node.handler = handler;
    node.handler_cleanup = handler_cleanup;
    if (kind == 5) {
        *InputExtra extra = ui.next_input;
        ui.next_input = null;
        node.on_text = extra.on_text;
        node.on_bool = extra.on_focus;
        node.has_on_bool = extra.has_on_focus;
        if (ui_update_string(&node.placeholder, extra.placeholder)) {
            ui_emit_string_prop(node, 2, node.placeholder);
        }
        if (extra.focused >= 0 && (fresh || extra.focused != node.focused)) {
            node.focused = extra.focused;
            ui_emit_prop(node, 3, extra.focused);
        }
    }
    if (kind == 7) {
        string source = ui.next_source;
        ui.next_source = null;
        if (ui_update_string(&node.source, source)) { ui_emit_string_prop(node, 3, node.source); }
    }
    if (kind == 9) {
        *SwitchExtra toggle = ui.next_switch;
        ui.next_switch = null;
        node.on_bool = toggle.on_change;
        node.has_on_bool = true;
        ui_prop(node, fresh, 18, toggle.value ? 1 : 0, -1);
    }
    if (kind == 10) {
        ui_prop(node, fresh, 19, ui.next_animating ? 1 : 0, -1);
    }
    if (kind == 6 && ui.next_list != null) {
        *ListExtra list = ui.next_list;
        ui.next_list = null;
        node.virtual = true;
        node.row_count = list.count;
        node.row_height = list.item_height;
        node.header_height = list.header_height;
        node.section_sizes = list.sizes;
        node.on_item = list.on_item;
        node.on_cell = list.on_cell;
    }
    if (kind == 4 || kind == 5 || kind == 8 || kind == 9 || node.virtual) { ui_emit(7, node, 0); }
    if (text != null && (node.text == null || strcmp(text, node.text) != 0)) {
        string previous = node.text;
        if (previous != null) { ui_retire(void() { free(previous); }); }
        node.text = ui_copy(text);
        ui_emit(3, node, 0);
    }
    parent.emitted.push(node);
    ui_run(node);
    return node;
}

void Column(Style style, escaping fn()->void block) { ui_element(1, style, null, block, void() {}, void() {}); }
void Row(Style style, escaping fn()->void block) { ui_element(2, style, null, block, void() {}, void() {}); }
// An image from an http(s) URL or a resource bundled with the app (its file name). Give it
// a width and height; `label` is its text alternative.
void Image(Style style, string source) {
    ui.next_source = source;
    ui_element(7, style, null, void() {}, void() {}, void() {});
}

// The host's side: report the insets (whatever the host policy, so an edge-to-edge app can
// pad itself) and whether the app is in the foreground. Readers re-run on a change.
void ui_set_insets(Insets insets) {
    Insets old = ui.insets;
    if (old.top == insets.top && old.right == insets.right && old.bottom == insets.bottom &&
        old.left == insets.left && old.keyboard == insets.keyboard) { return; }
    ui.insets = insets;
    ui.environment.set(ui.environment.value + 1);
}

void ui_set_active(bool active) {
    if (ui.inactive == !active) { return; }
    ui.inactive = !active;
    ui.environment.set(ui.environment.value + 1);
}

Insets ui_insets() { ui.environment.get(); return ui.insets; }

void ui_set_window(Window window) {
    Window old = ui.window;
    if (old.width == window.width && old.height == window.height && old.scale == window.scale) { return; }
    ui.window = window;
    ui.environment.set(ui.environment.value + 1);
}

Window ui_window() { ui.environment.get(); return ui.window; }
bool ui_is_active() { ui.environment.get(); return !ui.inactive; }

// Virtual lists. The rows near the viewport are mounted, `kOverscan` rows each side, and
// spacers stand for the rest, so a list of any length costs the same to render. Rows have
// a fixed height (React Native's getItemLayout); the list scrolls like a Scroll.
const int kOverscan = 5;

// The rows from `start` to `end` (exclusive) of a FlatList, each in a keyed cell.
void ui_list_rows(*Node list) {
    int h = list.row_height;
    int viewport = list.viewport > 0 ? list.viewport : (list.props[5] > 0 ? (int)list.props[5] : 400);
    int first = list.scroll_offset / h;
    int start = first - kOverscan < 0 ? 0 : first - kOverscan;
    int end = first + viewport / h + 1 + kOverscan;
    if (end > list.row_count) { end = list.row_count; }
    if (start > end) { start = end; }
    list.rendered_offset = list.scroll_offset;
    list.rendered_viewport = viewport;
    if (start > 0) { Row(Style{key: key(-1), gap: 0, height: start * h}, void() {}); }
    for (i in start..end) {
        int index = i;
        Column(Style{key: key(index), gap: 0, height: h}, void() { list.on_item(index); });
    }
    if (end < list.row_count) { Row(Style{key: key(-2), gap: 0, height: (list.row_count - end) * h}, void() {}); }
}

// A SectionList's headers and rows near the viewport: each section is a header row, then
// its items. Cells are keyed by section and item.
void ui_section_rows(*Node list) {
    int viewport = list.viewport > 0 ? list.viewport : (list.props[5] > 0 ? (int)list.props[5] : 400);
    int low = list.scroll_offset - kOverscan * list.row_height;
    int high = list.scroll_offset + viewport + kOverscan * list.row_height;
    list.rendered_offset = list.scroll_offset;
    list.rendered_viewport = viewport;
    int y = 0;
    int skipped = 0;
    int after = 0;
    for (s in 0..list.section_sizes.size) {
        int section = s;
        for (int i = -1; i < list.section_sizes.data[s]; i++) {
            int item = i;
            int h = item < 0 ? list.header_height : list.row_height;
            if (y + h <= low) { skipped += h; }
            else if (y >= high) { after += h; }
            else {
                if (skipped > 0) { Row(Style{key: key(-1), gap: 0, height: skipped}, void() {}); skipped = 0; }
                int64 cell = ((int64)section << 32) | (int64)(item + 1);
                Column(Style{key: key(cell), gap: 0, height: h}, void() { list.on_cell(section, item); });
            }
            y += h;
        }
    }
    if (skipped > 0) { Row(Style{key: key(-1), gap: 0, height: skipped}, void() {}); }
    if (after > 0) { Row(Style{key: key(-2), gap: 0, height: after}, void() {}); }
}

// `count` rows of `item_height` points; render(i) emits row i's content.
void FlatList(Style style, int count, int item_height, escaping fn(int)->void render) {
    ListExtra list = ListExtra{count: count, item_height: item_height < 1 ? 1 : item_height, on_item: render};
    ui.next_list = &list;
    style.gap = 0;
    ui_element(6, style, null, void() { ui_list_rows(ui.builder); }, void() {}, void() {});
}

// Sections from `sizes` (the app keeps it alive), each a header of `header_height` and its
// rows of `item_height`; render(section, -1) emits a header, render(section, i) row i.
void SectionList(Style style, *List<int> sizes, int header_height, int item_height,
    escaping fn(int, int)->void render) {
    ListExtra list = ListExtra{item_height: item_height < 1 ? 1 : item_height, header_height: header_height,
        sizes: sizes, on_cell: render};
    ui.next_list = &list;
    style.gap = 0;
    ui_element(6, style, null, void() { ui_section_rows(ui.builder); }, void() {}, void() {});
}

// A column whose content scrolls when it is taller than the space it gets.
void Scroll(Style style, escaping fn()->void block) { ui_element(6, style, null, block, void() {}, void() {}); }
// A component's own scope: state, identity and its name in diagnostics.
void Scope(string name, Key k, escaping fn()->void block) {
    ui.next_name = name;
    ui_element(0, Style{key: k}, null, block, void() {}, void() {});
}
void Text(string text) { ui_element(3, Style{}, text, void() {}, void() {}, void() {}); }
void Button(string text, escaping fn()->void handler) { ui_element(4, Style{}, text, void() {}, handler, void() {}); }

// Text and Button with a style: color, font, background and the rest of Style.
void TextWith(Style style, string text) { ui_element(3, style, text, void() {}, void() {}, void() {}); }
void ButtonWith(Style style, string text, escaping fn()->void handler) {
    ui_element(4, style, text, void() {}, handler, void() {});
}

// A container that reacts to a press anywhere in it (the children are its content).
void Pressable(Style style, escaping fn()->void on_press, escaping fn()->void block) {
    ui_element(8, style, null, block, on_press, void() {});
}

// A controlled on/off switch: it shows `value`, and on_change gets the user's toggle.
void Switch(Style style, bool value, escaping fn(bool)->void on_change) {
    SwitchExtra extra = SwitchExtra{value, on_change};
    ui.next_switch = &extra;
    ui_element(9, style, null, void() {}, void() {}, void() {});
}

// The platform's busy indicator, spinning while `animating`.
void ActivityIndicator(Style style, bool animating) {
    ui.next_animating = animating;
    ui_element(10, style, null, void() {}, void() {}, void() {});
}
void Button_owned(string text, escaping fn()->void handler, escaping fn()->void cleanup) {
    ui_element(4, Style{}, text, void() {}, handler, cleanup);
}

// A controlled text field: `value` is what it shows, `on_change` gets each edit (the text
// is borrowed for the call; keep it in owned state such as use_string). `focused` is 1 to
// focus it, 0 to blur it, -1 to leave focus to the user.
struct Input { Key key; string value; string placeholder; string label; int focused = -1; }

void TextInput(Input input, escaping fn(string)->void on_change) {
    InputExtra extra = InputExtra{on_text: on_change, placeholder: input.placeholder,
        focused: input.focused};
    ui.next_input = &extra;
    ui_element(5, Style{key: input.key, label: input.label}, input.value == null ? "" : input.value,
        void() {}, void() {}, void() {});
}

// The same, with `on_focus` told when the field gains (true) or loses (false) focus.
void TextInput_focus(Input input, escaping fn(string)->void on_change, escaping fn(bool)->void on_focus) {
    InputExtra extra = InputExtra{on_text: on_change, on_focus: on_focus, has_on_focus: true,
        placeholder: input.placeholder, focused: input.focused};
    ui.next_input = &extra;
    ui_element(5, Style{key: input.key, label: input.label}, input.value == null ? "" : input.value,
        void() {}, void() {}, void() {});
}

void ui_assign_id(*Node node) {
    if (ui.free_ids.size > 0) {
        node.id = ui.free_ids.data[--ui.free_ids.size];
    } else {
        node.id = ui.by_id.size;
        ui.by_id.push(null);
        ui.generations.push(0);
    }
    node.generation = ++ui.generations.data[node.id];
    ui.by_id.data[node.id] = node;
}

void ui_init(*Ui runtime, escaping fn(*uint8, int)->void apply) {
    ui = runtime;
    ui.apply = apply;
    ui.environment = signal_new<int>(0);
    ui.by_id.push(null);
    ui.generations.push(0);
    *Node root = alloc<Node>(1);
    ui_assign_id(root);
    root.block = void() {}; root.handler = void() {}; root.handler_cleanup = void() {};
    root.observer = ui_observer(0, root);
    ui.root = root;
}

void ui_mount(escaping fn()->void block) {
    ui_require(!ui.root.next && !ui.root.mounted, "already mounted");
    ui.root.block = block;
    ui_schedule(ui.root);
}

// The indices of `depths` ordered by depth, ties in their order (a counting sort: stable
// and linear). Parents come before children.
List<int> ui_by_depth(List<int>* depths) {
    int deepest = 0;
    for (i in 0..depths.size) { if (depths.data[i] > deepest) { deepest = depths.data[i]; } }
    List<int> starts;
    for (i in 0..deepest + 2) { starts.push(0); }
    for (i in 0..depths.size) { starts.data[depths.data[i] + 1]++; }
    for (i in 1..deepest + 2) { starts.data[i] += starts.data[i - 1]; }
    List<int> order;
    for (i in 0..depths.size) { order.push(0); }
    for (i in 0..depths.size) { order.data[starts.data[depths.data[i]]++] = i; }
    starts.free();
    return order;
}

// One pass over the effects dirty at completion, parents first and, within a depth, in
// the order they were scheduled. An effect dirtied again after it ran waits for the next
// commit.
void ui_run_effects() {
    List<*Observer> due = ui.dirty_effects;
    ui.dirty_effects = List<*Observer>{};
    List<int> depths;
    for (i in 0..due.size) { depths.push(due.data[i].owner.depth); }
    List<int> order = ui_by_depth(&depths);
    for (i in 0..order.size) {
        *Observer effect = due.data[order.data[i]];
        effect.queued = false;
        if (!effect.dirty) { continue; }
        if (effect.has_cleanup) {
            effect.cleanup(); ui_release_closure(effect.cleanup); effect.has_cleanup = false;
        }
        ui_validate(effect);
    }
    order.free();
    depths.free();
    due.free();
}

void ui_complete(int sequence) {
    ui_require(ui.in_flight && sequence == ui.sequence, "invalid commit completion");
    ui.in_flight = false;
    for (i in 0..ui.finalizers.size) {
        fn()->void finalize = ui.finalizers.data[i];
        finalize(); ui_release_closure(finalize);
    }
    ui.finalizers.size = 0;
    for (i in 0..ui.retired.size) {
        fn()->void dispose = ui.retired.data[i];
        dispose(); ui_release_closure(dispose);
    }
    ui.retired.size = 0;
    // The renderer has applied the removals: their ids are free again.
    for (i in 0..ui.retired_ids.size) { ui.free_ids.push(ui.retired_ids.data[i]); }
    ui.retired_ids.size = 0;
    ui.commit.len = 0;
    ui.phase = 2;
    ui_run_effects();
    ui.phase = 0;
    // Events that arrived while the commit was in flight, in arrival order. Their text was
    // copied on receipt and is freed once the handler returns.
    for (i in 0..ui.events.size) {
        Event event = ui.events.data[i];
        ui_dispatch_event(&event);
        free(event.text);
    }
    ui.events.size = 0;
}

// A throw out of a block, handler or effect is not caught by the runtime: the program
// stops through the uncaught-exception reporter. A caller that catches it anyway leaves
// the runtime mid-phase, and the next entry point stops here instead of running on it.
void ui_require_consistent() {
    ui_require(ui.phase == 0 && ui.builder == null && ui.tracking == null,
        "runtime left mid-phase (an exception escaped a block, handler or effect)");
}

bool ui_memo_work() {
    for (i in 0..ui.dirty_memos.size) {
        *Observer memo = ui.dirty_memos.data[i];
        if (memo.dirty && memo.output.readers.size > 0) { return true; }
    }
    return false;
}

bool ui_frame() {
    ui_require_consistent();
    ui_require(!ui.in_flight, "frame while commit in flight");
    // Validate observed memos even when their consumers have not been scheduled yet.
    // Validation can queue more memos; the loop reaches them too.
    for (int i = 0; i < ui.dirty_memos.size; i++) {
        *Observer memo = ui.dirty_memos.data[i];
        memo.queued = false;
        if (memo.dirty && memo.output.readers.size > 0) { ui_validate(memo); }
    }
    ui.dirty_memos.size = 0;
    if (ui.next_nodes.size == 0 && ui.dirty_effects.size == 0) { return false; }
    List<*Node> due = ui.next_nodes;
    ui.next_nodes = List<*Node>{};
    List<int> depths;
    for (i in 0..due.size) {
        due.data[i].next = false; due.data[i].current = true;
        depths.push(due.data[i].depth);
    }
    // Parents before children: a parent's run re-runs a dirty child and clears it.
    List<int> order = ui_by_depth(&depths);
    ui.phase = 1;
    for (i in 0..order.size) {
        *Node node = due.data[order.data[i]];
        if (node.current) { ui_run(node); }
    }
    order.free();
    depths.free();
    due.free();
    for (i in 0..ui.writes.size) {
        fn()->void write = ui.writes.data[i];
        write(); ui_release_closure(write);
    }
    ui.writes.size = 0;
    for (i in 0..ui.looping.size) {
        if (!ui.looping.data[i].render_write) { ui.looping.data[i].loop_frames = 0; }
    }
    ui.looping.size = 0;
    for (i in 0..ui.render_writes.size) {
        *Node node = ui.render_writes.data[i];
        node.render_write = false;
        node.loop_frames++;
        ui_require(node.loop_frames < 100, "render loop (100 frames)");
        ui.looping.push(node);
    }
    ui.render_writes.size = 0;
    ui.phase = 0;
    ui.sequence++;
    ui.in_flight = true;
    ui.apply(ui.commit.data, ui.commit.len);
    return true;
}

// Dispatch now, or queue until the commit in flight completes (copying its text). Returns
// false only for an event dispatched now whose node is gone or stale; a queued one is
// checked when it runs.
bool ui_post(Event event) {
    if (ui.in_flight || ui.phase != 0) {
        if (event.text != null) { event.text = ui_copy(event.text); }
        ui.events.push(event);
        return true;
    }
    ui_require_consistent();
    return ui_dispatch_event(&event);
}

bool ui_event(int id, int generation) { return ui_post(Event{id, generation, 1, 0, null}); }

// The text of an input changed; `text` is only read during the call.
bool ui_event_text(int id, int generation, string text) {
    return ui_post(Event{id, generation, 2, 0, text});
}

bool ui_event_focus(int id, int generation, bool focused) {
    return ui_post(Event{id, generation, 3, focused ? 1 : 0, null});
}

bool ui_event_toggle(int id, int generation, bool on) {
    return ui_post(Event{id, generation, 4, on ? 1 : 0, null});
}

// A scroll view moved: its offset and viewport height, in points.
bool ui_event_scroll(int id, int generation, int offset, int viewport) {
    return ui_post(Event{id, generation, 5, offset, null, viewport});
}

bool ui_dispatch_event(*Event event) {
    int id = event.id;
    if (id <= 0 || id >= ui.by_id.size) { return false; }
    *Node node = ui.by_id.data[id];
    if (node == null || node.generation != event.generation) { return false; }
    if (event.kind == 1 && (node.kind == 4 || node.kind == 8)) { node.handler(); return true; }
    // What the user changed is what the renderer shows now: recorded as sent, so a render
    // that keeps the old value (the app refused the change) sends it back.
    if (event.kind == 2 && node.kind == 5) {
        string shown = node.text;
        if (shown != null) { ui_retire(void() { free(shown); }); }
        node.text = ui_copy(event.text);
        node.on_text(event.text);
        // Render the scope again even if the app ignored the edit, so its value wins.
        ui_schedule(node.parent);
        return true;
    }
    if (event.kind == 3 && node.kind == 5) {
        node.focused = event.value;
        if (node.has_on_bool) { node.on_bool(event.value != 0); }
        return true;
    }
    if (event.kind == 5 && node.kind == 6) {
        if (!node.virtual) { return true; }
        // A new window only after the view moved a row's height or was resized: the overscan
        // covers what is between.
        bool resized = event.extra != node.rendered_viewport;
        node.scroll_offset = event.value < 0 ? 0 : event.value;
        node.viewport = event.extra;
        int moved = node.scroll_offset - node.rendered_offset;
        if (moved < 0) { moved = -moved; }
        if (resized || moved >= node.row_height) { ui_schedule(node); }
        return true;
    }
    if (event.kind == 4 && node.kind == 9) {
        node.props[18] = event.value;
        node.on_bool(event.value != 0);
        ui_schedule(node.parent);
        return true;
    }
    return false;
}

bool ui_needs_frame() {
    if (ui == null || ui.in_flight) { return false; }
    return ui.next_nodes.size > 0 || ui.dirty_effects.size > 0 || ui_memo_work();
}

void ui_shutdown() {
    ui_require(!ui.in_flight, "shutdown while commit in flight");
    ui_unmount(ui.root);
    ui.root = null;
    ui.sequence++; ui.in_flight = true;
    ui.apply(ui.commit.data, ui.commit.len);
    ui_require(!ui.in_flight, "prototype shutdown requires synchronous renderer");
    free_closure(ui.apply);
    ui.environment.free();
    ui.by_id.free(); ui.generations.free(); ui.retired_ids.free(); ui.free_ids.free();
    ui.next_nodes.free(); ui.render_writes.free(); ui.looping.free();
    ui.dirty_memos.free(); ui.dirty_effects.free();
    ui.commit.free(); ui.writes.free(); ui.retired.free();
    for (i in 0..ui.events.size) { free(ui.events.data[i].text); }
    ui.finalizers.free(); ui.events.free();
    ui = null;
}
