// Accessibility and input: Style's role and states go out as props only when set, a disabled
// element (or one inside it) drops what the user does, and a TextInput sends its editing
// options and reports return to ui_on_submit.
// Part of the model tests (tests/model/main.esk imports every part).

*Signal<bool> access_off;

int access_presses;

void accessibility() {
    Ui runtime;
    ui_init(&runtime, record);
    access_presses = 0;
    ui_mount() {
        access_off = use_signal<bool>(false);
        Row(Style{label: "Agree", role: RoleCheckbox, checked: CheckOn, value: "1 of 2", hint: "Accepts the terms"}) {}
        Row(Style{role: RoleTab, selected: true, expanded: DisclosureCollapsed}) {}
        Row(Style{role: RoleProgress, value_min: 0, value_max: 100, value_now: 40}) {}
        Row(Style{}) {}
        ButtonWith(Style{label: "Go", disabled: access_off.get()}, "Go") { access_presses++; }
        Column(Style{disabled: access_off.get()}) {
            ButtonWith(Style{label: "Inner"}, "Inner") { access_presses++; }
        }
    }
    ui_frame();
    check(count_prop(2, 57) == 3 && prop_value(2, 57) == RoleCheckbox, "a role goes out only where it is set");
    check(count_prop(2, 58) == 1 && prop_value(2, 58) == CheckOn, "checked");
    check(count_prop(2, 59) == 1 && count_prop(2, 60) == 1 && prop_value(2, 60) == DisclosureCollapsed,
        "selected and expanded");
    check(count_prop(2, 62) == 1 && prop_value(2, 62) == 40 && count_prop(2, 64) == 1, "a range");
    check(count_prop(9, 8) == 1 && count_prop(9, 9) == 1, "value and hint as strings");
    check(count_prop(2, 61) == 0, "nothing disabled: no disabled prop");
    press_label("Go");
    press_label("Inner");
    check(access_presses == 2, "enabled buttons take presses");
    access_off.set(true); ui_frame();
    check(count_prop(2, 61) == 2, "disabled goes out where it is set");
    press_label("Go");
    press_label("Inner");
    check(access_presses == 2, "a disabled button and one inside a disabled column take no press");
    access_off.set(false); ui_frame();
    press_label("Inner");
    check(access_presses == 3, "enabled again");
    ui_shutdown(); balanced("accessibility leak");
}

*StringState access_text;

String access_submitted;

void input_options() {
    Ui runtime;
    ui_init(&runtime, record);
    String_clear(&access_submitted);
    ui_mount() {
        access_text = use_string("hunter2");
        ui_on_submit(void(string text) { String_clear(&access_submitted); String_append(&access_submitted, text); });
        TextInput(Input{value: access_text.get(), label: "Password", secure: true, return_key: ReturnGo,
            keyboard: KeyboardText, capitalize: CapitalizeNone, autocorrect: false, autofill: AutofillPassword},
            void(string text) { access_text.set(text); });
        TextInput(Input{value: "", label: "Notes", multiline: true}, void(string text) {});
    }
    ui_frame();
    check(count_prop(2, 65) == 1 && count_prop(2, 67) == 1 && prop_value(2, 67) == ReturnGo, "secure and return key");
    check(count_prop(2, 69) == 1 && count_prop(2, 70) == 1 && prop_value(2, 70) == 0 && prop_value(2, 71) == AutofillPassword,
        "capitalize, autocorrect off, autofill");
    check(count_prop(2, 66) == 0, "the default keyboard sends nothing");
    check(count_prop(2, 68) == 1 && count_prop(2, 72) == 1, "multiline, and one submit listener");
    *Node field = find_label(ui.root, "Password");
    check(ui_event_submit(field.id, field.generation, "hunter2"), "submit dispatched");
    check(strcmp((string)access_submitted.data, "hunter2") == 0, "the submit handler got the text");
    String_clear(&access_submitted);
    check(has(drive("{\"op\": \"submit\", \"target\": \"Password\"}"), "\"ok\": true, \"op\": \"submit\""), "the submit op");
    check(strcmp((string)access_submitted.data, "hunter2") == 0, "the submit op hands over the field's text");
    check(has(drive("{\"op\": \"submit\", \"target\": \"Notes\"}"), "has no ui_on_submit listener"),
        "the submit op on a field without a listener says so");
    *Node notes = find_label(ui.root, "Notes");
    check(!ui_event_submit(notes.id, notes.generation, "x") || strcmp((string)access_submitted.data, "hunter2") == 0,
        "a field without a submit listener does not call another's");
    ui_frame();
    ui_shutdown(); balanced("input options leak");
    String_free(&access_submitted);
}

// The kit's words: a date and a month in Spanish, weeks from Monday; a Checkbox and a Radio
// say their state.
void kit_access() {
    kit_text = kit_text_spanish();
    String text;
    kit_text_fill(kit_text.date, 2026, 11, 15, &text);
    check(strcmp((string)text.data, "15 de noviembre de 2026") == 0, "a Spanish date");
    kit_text_item(kit_text.weekdays, 1, &text);
    check(strcmp((string)text.data, "L") == 0 && kit_text.first_weekday == 1, "Spanish weekdays from Monday");
    kit_text_item(kit_text.weekday_names, 3, &text);
    check(strcmp((string)text.data, "miércoles") == 0, "a weekday's name for a screen reader");
    String_free(&text);
    kit_text = kit_text_english();
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() {
        Checkbox("Agree", true, void(bool on) {});
        RadioGroup("One\nTwo", 1, void(int i) {});
    }
    ui_frame();
    check(count_prop(2, 58) == 3 && count_prop(2, 57) == 4, "a checkbox and two radios with their state, and the group");
    ui_shutdown(); balanced("kit access leak");
}

// The kit's headings and menu rows say what they are, its controls are 44 points tall, and
// text with no color of its own takes ui_text_color.
void kit_semantics() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_text_color = 0xF3F4F6FF;
    ui_mount() {
        Title("Settings");
        Heading("Account");
        MenuItem("Rename", false) {}
        _kit_menu_item("Large", CheckOn) {}
        _kit_menu_item("Small", CheckOff) {}
        Checkbox("Agree", false, void(bool on) {});
        Text("Plain");
        TextWith(Style{color: 0x111827FF}, "Colored");
        ToastHost();
    }
    ui_frame();
    ui_text_color = -1;
    kit_toast("Saved"); kit_toast("Saved");
    check(kit_toast_queue.size == 1, "the same toast twice in a row is queued once");
    for (i in 0..12) { kit_toast(textf("Toast %d", i)); }
    check(kit_toast_queue.size == 1 + KIT_TOASTS_WAITING, "at most KIT_TOASTS_WAITING toasts wait");
    check(strcmp(kit_toast_queue.data[0].data, "Saved") == 0 && strcmp(kit_toast_queue.data[kit_toast_queue.size - 1].data, "Toast 11") == 0,
        "the oldest waiting ones are dropped, the newest kept");
    check(count_prop(2, 57) == 6, "two headings, three menu rows and a checkbox have roles (a toast is no alert)");
    check(count_prop(2, 58) == 3, "the checked state of a Select's rows and of the checkbox, none for an action");
    check(count_prop(2, 44) >= 4 && prop_value(2, 44) == 44, "menu rows and the checkbox are 44 points tall");
    check(count_prop(2, 9) >= 4, "text with no color takes ui_text_color");
    ui_shutdown(); balanced("kit semantics leak");
}

int image_loads;

int image_failures;

// Layout props: a side's padding only when set, margins resolved per side, text and shrink;
// an Image's load listener.
void layout_props() {
    Ui runtime;
    ui_init(&runtime, record);
    image_loads = 0;
    image_failures = 0;
    ui_mount() {
        Row(Style{padding: 8, padding_left: 20}) {}
        Row(Style{margin: 4, margin_top: 12}) {}
        TextWith(Style{text_align: TextAlignCenter, max_lines: 2, shrink: 1}, "A long line");
        Row(Style{}) {}
        ui_on_image(void(bool loaded) { if (loaded) { image_loads++; } else { image_failures++; } });
        Image(Style{label: "Photo", width: 40, height: 40}, "missing.png");
    }
    ui_frame();
    check(count_prop(2, 76) == 1 && count_prop(2, 73) == 0, "only the side that is set");
    check(count_prop(2, 77) == 1 && prop_value(2, 77) == 12 && count_prop(2, 78) == 1 && prop_value(2, 78) == 4,
        "margins resolved per side");
    check(count_prop(2, 81) == 1 && count_prop(2, 82) == 1 && count_prop(2, 83) == 1, "text align, lines, shrink");
    check(count_prop(2, 84) == 1, "one image listener");
    *Node image = find_label(ui.root, "Photo");
    ui_event_image(image.id, image.generation, false);
    ui_event_image(image.id, image.generation, true);
    check(image_failures == 1 && image_loads == 1, "the image listener hears both");
    ui_shutdown(); balanced("layout props leak");
}

// The driver's tree shows the role, the states and the hint (`ui agent tree`).
void driver_access() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() {
        Row(Style{label: "Agree", role: RoleCheckbox, checked: CheckOn, hint: "Accepts the terms", disabled: true}) {}
        Column(Style{disabled: true}) { ButtonWith(Style{test_id: "off"}, "Off") {} }
    }
    ui_frame();
    check(has(drive("{\"op\": \"tap\", \"target\": \"off\"}"), "\"ok\": false, \"op\": \"tap\", \"error\": \"'off' is disabled"),
        "a tap on a disabled element says so");
    String out;
    _ui_driver_tree_node(&out, ui.root);
    string json = (string)out.data;
    check(strstr(json, "\"role\": 5") != null && strstr(json, "\"checked\": 2") != null, "the tree has the role and checked");
    check(strstr(json, "\"disabled\": 1") != null && strstr(json, "\"hint\": \"Accepts the terms\"") != null,
        "the tree has disabled and the hint");
    String_free(&out);
    ui_shutdown(); balanced("driver access leak");
}

// The text, stacking, clipping and layout-animation props, and a ModalWith's presentation.
void style_props() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() {
        TextWith(Style{line_height: 22, italic: true}, "Slanted");
        Row(Style{z_index: 2, clip: true, layout_ms: 200}) {}
        Row(Style{}) {}
        ModalWith(ModalOptions{presentation: PresentSheet, style: Style{padding: 16}}, true, void() {}) { Text("Sheet"); }
        Modal(true, void() {}) { Text("Plain"); }
    }
    ui_frame();
    check(count_prop(2, 85) == 1 && prop_value(2, 85) == 22 && count_prop(2, 86) == 1, "line height and italic");
    check(count_prop(2, 87) == 1 && count_prop(2, 88) == 1 && count_prop(2, 90) == 1 && prop_value(2, 90) == 200,
        "z index, clip and the layout animation, only where set");
    check(count_prop(2, 89) == 1 && prop_value(2, 89) == PresentSheet && count_prop(2, 91) == 1 && prop_value(2, 91) == 1,
        "a sheet that animates in; a plain Modal sends neither");
    ui_shutdown(); balanced("style props leak");
}

int gesture_last_dx;
int gesture_phases;
int gesture_long;
bool gesture_inside;

// drag, long_press and hover reach the nearest listener around the element named.
void driver_gestures() {
    Ui runtime;
    ui_init(&runtime, record);
    gesture_last_dx = 0; gesture_phases = 0; gesture_long = 0; gesture_inside = false;
    ui_mount() {
        ui_on_pan(void(Pan p) { gesture_phases++; gesture_last_dx = p.dx; });
        ui_on_long_press(void() { gesture_long++; });
        ui_on_hover(void(bool inside) { gesture_inside = inside; });
        Row(Style{test_id: "card"}) { TextWith(Style{test_id: "inside"}, "Card"); }
        TextWith(Style{test_id: "plain"}, "Plain");
    }
    ui_frame();
    check(has(drive("{\"op\": \"drag\", \"target\": \"inside\", \"dx\": -120, \"dy\": 0, \"ms\": 200}"), "\"ok\": true"), "drag");
    check(gesture_phases == 7 && gesture_last_dx == -120, "began, five moves and the end at the full distance");
    check(has(drive("{\"op\": \"long_press\", \"target\": \"card\"}"), "\"ok\": true") && gesture_long == 1, "long press");
    check(has(drive("{\"op\": \"hover\", \"target\": \"card\", \"inside\": \"in\"}"), "\"ok\": true") && gesture_inside, "hover in");
    check(has(drive("{\"op\": \"drag\", \"target\": \"plain\", \"dx\": 10, \"dy\": 0}"), "has ui_on_pan"),
        "a drag on an element nothing listens around says so");
    ui_shutdown(); balanced("gestures leak");
}
