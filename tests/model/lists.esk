// Virtual lists and pull to refresh.
// Part of the model tests (tests/model/main.esk imports every part).

int rendered_rows;

void flat_list() {
    Ui runtime;
    rendered_rows = 0;
    ui_init(&runtime, record);
    ui_mount() {
        FlatList(Style{height: 400}, 10000, 40, void(int i) { rendered_rows++; text_number(i); });
    }
    ui_frame();
    *Node list = ui.root.children.data[0];
    check(list.kind == 6 && list.virtual, "a flat list is a virtual scroll");
    check(list.children.size == 17, "16 rows (a viewport and the overscan) and the bottom spacer");
    check(text_is(list.children.data[0].children.data[0], 0), "row 0 first");
    int mounted = rendered_rows;
    ui_event_scroll(list.id, list.generation, 20, 400);
    check(!ui_frame(), "a move under one row renders nothing");
    ui_event_scroll(list.id, list.generation, 4000, 400);
    ui_frame();
    check(list.children.size == 23 && prop_value(2, 5) == 95 * 40, "rows 95 to 115 between two spacers");
    check(text_is(list.children.data[1].children.data[0], 95), "the window starts at row 95");
    int live = 0;
    for (i in 0..ui.by_id.size) { if (ui.by_id.data[i] != null) { live++; } }
    check(live < 80, "nodes stay bounded for 10,000 rows");
    check(rendered_rows - mounted < 40, "only the new rows are rendered");
    ui_shutdown(); balanced("flat list leak");
}

List<int> sections;

void section_list() {
    Ui runtime;
    sections.push(3); sections.push(100); sections.push(2);
    ui_init(&runtime, record);
    ui_mount() {
        SectionList(Style{height: 200}, &sections, 30, 40, void(int section, int item) {
            text_number(item < 0 ? 1000 + section : item);
        });
    }
    ui_frame();
    *Node list = ui.root.children.data[0];
    check(text_is(list.children.data[0].children.data[0], 1000), "section 0's header first");
    check(text_is(list.children.data[4].children.data[0], 1001), "then its 3 rows, then section 1's header");
    ui_event_scroll(list.id, list.generation, 2000, 200);
    ui_frame();
    check(list.children.data[0].key.value == -1 && list.children.data[0].kind == 2, "a top spacer");
    bool header0 = false;
    for (i in 0..list.children.size) { if (list.children.data[i].key.value == 0) { header0 = true; } }
    check(!header0, "section 0 is scrolled away");
    ui_shutdown(); sections.free(); balanced("section list leak");
}

*Signal<bool> loading;

int refreshes;

void refresh_control() {
    Ui runtime;
    refreshes = 0;
    ui_init(&runtime, record);
    ui_mount() {
        loading = use_signal<bool>(false);
        RefreshControl(loading.get()) { refreshes++; loading.set(true); }
        FlatList(Style{height: 200}, 50, 40, void(int i) { text_number(i); });
    }
    ui_frame();
    *Node list = ui.root.children.data[0];
    check(count_prop(2, 22) == 1 && prop_value(2, 22) == 0, "the list says it can refresh");
    check(ui_event_refresh(list.id, list.generation) && refreshes == 1, "a pull runs on_refresh");
    ui_frame();
    check(count_prop(2, 22) == 1 && prop_value(2, 22) == 1, "the indicator shows");
    loading.set(false); ui_frame();
    check(prop_value(2, 22) == 0, "and goes away");
    ui_shutdown(); balanced("refresh leak");
}

// ListSignal: a model's list and a scope's list render their readers again when they
// change, a change during a render waits for it, and both free their storage.
*ListSignal<int> model_list;
*ListSignal<int> scope_list;
int list_renders;

void list_signals() {
    Ui runtime;
    ui_init(&runtime, record);
    model_list = list_signal_new<int>();
    model_list.push(1);
    model_list.push(2);
    list_renders = 0;
    ui_mount() {
        list_renders++;
        scope_list = use_list<int>();
        int sum = 0;
        for (i in 0..model_list.size()) { sum += model_list.get(i); }
        int in_scope = scope_list.size();
        Column(Style{}) {
            Text(textf("sum %d, %d in scope", sum, in_scope));
            for (i in 0..scope_list.size()) { Text(textf("item %d", scope_list.get(i))); }
        }
    }
    ui_frame();
    check(list_renders == 1, "the first render");
    model_list.push(3); ui_frame();
    check(list_renders == 2, "a push renders the reader again");
    model_list.items().data[0] = 10; model_list.changed(); ui_frame();
    check(list_renders == 3, "changed() after an edit in place renders it again");
    ui_frame();
    check(list_renders == 3, "no change, no render");
    scope_list.push(7); scope_list.insert(0, 5); ui_frame();
    check(list_renders == 4 && scope_list.list.size == 2 && scope_list.list.data[0] == 5, "a scope's list");
    scope_list.swap(0, 1); scope_list.remove(1); ui_frame();
    check(scope_list.list.size == 1 && scope_list.list.data[0] == 7, "swap and remove");
    model_list.set(1, 20); model_list.clear(); ui_frame();
    check(model_list.list.size == 0 && list_renders == 6, "set and clear");
    ui_shutdown();
    model_list.free();
    balanced("list signals leak");
}

