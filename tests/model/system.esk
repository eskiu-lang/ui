// The platform: environment, window, commands, links, status bar, back, modals, native modules.
// Part of the model tests (tests/model/main.esk imports every part).

int env_top;

bool env_active;

void environment() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() {
        Row(Style{key: key(1)}) { env_top = ui_insets().top; }
        Row(Style{key: key(2)}) { env_active = ui_is_active(); }
    }
    ui_frame();
    check(env_top == 0 && env_active, "defaults");
    ui_set_insets(Insets{top: 47, bottom: 34});
    check(ui_needs_frame(), "an inset change schedules a frame");
    ui_frame();
    check(env_top == 47 && keyed(1).runs == 2, "readers see the insets");
    ui_set_insets(Insets{top: 47, bottom: 34});
    check(!ui_needs_frame(), "the same insets change nothing");
    ui_set_active(false); ui_frame();
    check(!env_active, "background");
    ui_shutdown(); balanced("environment leak");
}

int seen_width;

void window_size() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() { Row(Style{key: key(1)}, void() { seen_width = ui_window().width; }); }
    ui_frame();
    ui_set_window(Window{390, 844, 300});
    ui_frame();
    check(seen_width == 390 && keyed(1).runs == 2, "window size reaches readers");
    ui_shutdown(); balanced("window leak");
}

int alert_choice;

void commands() {
    Ui runtime;
    alert_choice = -9;
    ui_init(&runtime, record);
    ui_mount() {
        Button("Delete") {
            Alert("Delete?", "It cannot be undone.", "Cancel\nDelete", void(int choice) { alert_choice = choice; });
        }
    }
    ui_frame();
    *Node button = ui.root.children.data[0];
    ui_event(button.id, button.generation);
    check(ui_needs_frame(), "an alert needs a frame to reach the host");
    ui_frame();
    check(mutation_count == 1 && mutation_ops[0] == 10 && mutation_kinds[0] == 1 && mutation_befores[0] == 4,
        "one alert command: title, message and two buttons");
    check(strcmp(mutation_texts[0], "Delete?") == 0, "its title");
    check(ui_event_alert(mutation_ids[0], 1) && alert_choice == 1 && ui.alerts.size == 0, "the answer");
    ui_open_url("https://eskiu-lang.org");
    ui_frame();
    check(mutation_ops[0] == 10 && mutation_kinds[0] == 2 && strcmp(mutation_texts[0], "https://eskiu-lang.org") == 0,
        "open a URL");
    ui_open_settings();
    ui_frame();
    check(mutation_ops[0] == 10 && mutation_kinds[0] == 2 && strcmp(mutation_texts[0], "app-settings:") == 0,
        "open the app's settings");
    ui_splash_hold();
    ui_frame();
    check(mutation_ops[0] == 10 && mutation_kinds[0] == 11 && strcmp(mutation_texts[0], "1") == 0, "hold the splash");
    ui_splash_hide();
    ui_frame();
    check(mutation_ops[0] == 10 && mutation_kinds[0] == 11 && strcmp(mutation_texts[0], "0") == 0, "hide the splash");
    // An unanswered alert is freed at shutdown.
    ui_event(button.id, button.generation);
    ui_frame();
    ui_shutdown(); balanced("commands leak");
}

string seen_link;

*Signal<int> bar_version;

void links_and_status_bar() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() {
        bar_version = use_signal<int>(0);
        StatusBar(BarLight, bar_version.get() > 0);
        Row(Style{key: key(1)}) { seen_link = ui_link(); }
    }
    ui_frame();
    check(count_prop(2, 20) == 1 && prop_value(2, 20) == 1 && count_prop(2, 21) == 1, "status bar style and visibility");
    bar_version.set(1); ui_frame();
    check(count_prop(2, 20) == 0 && count_prop(2, 21) == 1 && prop_value(2, 21) == 1, "only the change");
    ui_set_link("eskiu://todo/3");
    ui_frame();
    check(seen_link != null && strcmp(seen_link, "eskiu://todo/3") == 0, "the link reaches readers");
    ui_shutdown(); balanced("links leak");
}

*Signal<bool> show_details;

*Signal<bool> modal_open;

bool consume_back;

int closes;

void back_and_modal() {
    Ui runtime;
    closes = 0;
    consume_back = true;
    ui_init(&runtime, record);
    ui_mount() {
        show_details = use_signal<bool>(true);
        modal_open = use_signal<bool>(false);
        if (show_details.get()) {
            Scope("Details", Key{}) { use_back(bool() { return consume_back; }); }
        }
        Modal(modal_open.get(), void() { closes++; modal_open.set(false); }) { Text("Sheet"); }
    }
    ui_frame();
    check(ui_back(), "the handler takes the back press");
    consume_back = false;
    check(!ui_back(), "a handler that declines lets the platform go back");
    modal_open.set(true); ui_frame();
    check(ui.modals.size == 1 && ui.root.children.data[1].kind == 12, "the modal is open");
    check(ui_back() && closes == 1, "back asks the modal to close first");
    ui_frame();
    check(ui.modals.size == 0, "the modal closed");
    show_details.set(false); ui_frame();
    check(ui.back_handlers.size == 0, "an unmounted scope's handler is gone");
    ui_shutdown(); balanced("back and modal leak");
}

int ticks;

string last_tap;

*Signal<int> map_zoom;

bool show_map;

void native_modules() {
    Ui runtime;
    ticks = 0;
    show_map = true;
    ui_init(&runtime, record);
    ui_mount() {
        map_zoom = use_signal<int>(3);
        use_native_event("ticker", void(string payload) { ticks += atoi(payload); });
        if (show_map) {
            String zoom;
            defer String_free(&zoom);
            String_format(&zoom, "%d", map_zoom.get());
            ui_native_prop("zoom", zoom.data);
            if (map_zoom.get() < 5) { ui_native_prop("style", "satellite"); }
            NativeView(Style{width: 200, height: 120, label: "Map"}, "MapView", void(string name, string payload) {
                last_tap = ui_copy(payload);
            });
        }
    }
    ui_frame();
    check(count_prop(9, 4) == 1 && ops[11] == 2, "the type once, then both named props");
    check(ui_event_native("ticker", "2") && ui_event_native("ticker", "3") && ticks == 5, "channel events");
    check(!ui_event_native("other", "1"), "no handler for another channel");
    map_zoom.set(4); ui_frame();
    check(ops[11] == 1 && strcmp(mutation_names[0], "zoom") == 0 && strcmp(mutation_texts[0], "4") == 0,
        "only the changed prop");
    map_zoom.set(6); ui_frame();
    check(ops[11] == 2, "the zoom and the style removed (sent empty)");
    *Node map = find_label(ui.root, "Map");
    check(ui_event_view(map.id, map.generation, "tap", "19.4,-99.1") && strcmp(last_tap, "19.4,-99.1") == 0,
        "a view's event reaches its handler");
    free(last_tap);
    show_map = false;
    map_zoom.set(7); ui_frame();
    check(ops[6] == 1, "the view is removed");
    ui_shutdown();
    check(ui == null, "shut down");
    balanced("native modules leak");
}

// The host's clock, faked: what is armed, and what was stopped.
List<int> armed_tokens;
List<int> armed_ms;
int stopped_token;
int timer_ticks;
*Signal<int> timer_period;

void timers() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_set_timer_host(void(int token, int ms, bool repeat) { armed_tokens.push(token); armed_ms.push(repeat ? ms : -ms); },
        void(int token) { stopped_token = token; });
    ui_mount() {
        timer_period = use_signal<int>(100);
        *Signal<int> ticks = use_signal<int>(0);
        timer_ticks = ticks.get();
        use_interval(timer_period.get()) { ticks.set(ticks.get() + 1); }
        use_timeout(50) { ticks.set(ticks.get() + 100); }
    }
    ui_frame();
    check(armed_tokens.size == 2 && armed_ms.data[0] == 100 && armed_ms.data[1] == -50, "both armed");
    int interval = armed_tokens.data[0];
    int timeout = armed_tokens.data[1];
    check(ui_event_timer(interval) && ui_event_timer(interval), "ticks");
    ui_frame();
    check(timer_ticks == 2, "the interval's handler ran twice");
    check(ui_event_timer(timeout), "the timeout fires");
    check(!ui_event_timer(timeout), "once");
    ui_frame();
    check(timer_ticks == 102, "its handler ran");
    timer_period.set(0); ui_frame();
    check(stopped_token == interval && armed_tokens.size == 2, "a period of 0 pauses it");
    check(!ui_event_timer(interval), "a paused timer does not tick");
    timer_period.set(200); ui_frame();
    check(armed_tokens.size == 3 && armed_ms.data[2] == 200, "a new period arms it again");
    stopped_token = 0;
    ui_shutdown();
    check(stopped_token == interval, "unmounting stops it");
    armed_tokens.free(); armed_ms.free();
    balanced("timers leak");
}

// The display clock, faked: whether frames were asked for, and what the handler saw.
int frame_requests;
bool frames_wanted;
*Signal<bool> frame_running;
int frame_count;
double frame_delta;
int fallback_token;

void display_frames() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_set_frame_host(void(bool on) { frame_requests++; frames_wanted = on; });
    ui_mount() {
        frame_running = use_signal<bool>(true);
        *Signal<int> shown = use_signal<int>(0);
        Text(shown.get() > 0 ? "moving" : "still");
        use_frame(frame_running.get(), void(Tick tick) { frame_count++; frame_delta = tick.delta; shown.set(frame_count); });
    }
    ui_frame();
    check(frames_wanted && frame_requests == 1, "a running use_frame starts the display clock");
    check(ui_event_frame(10.0) && frame_count == 1 && frame_delta == 0, "the first frame has no delta");
    check(ui_event_frame(10.016) && frame_count == 2 && frame_delta > 0.0159 && frame_delta < 0.0161, "the next one has the time since");
    ui_frame();
    frame_running.set(false); ui_frame();
    check(!frames_wanted && frame_requests == 2, "pausing it stops the clock");
    check(!ui_event_frame(10.032) && frame_count == 2, "no frame runs while paused");
    frame_running.set(true); ui_frame();
    check(frames_wanted && frame_requests == 3, "running again restarts it");
    check(ui_event_frame(11.0) && frame_delta == 0, "and the delta starts over");
    ui_shutdown();
    check(!frames_wanted, "unmounting stops it");
    balanced("frames leak");

    // Without a display clock, a 16 ms timer stands in.
    frame_count = 0;
    Ui plain;
    ui_init(&plain, record);
    ui_set_timer_host(void(int token, int ms, bool repeat) { if (ms == 16 && repeat) { fallback_token = token; } },
        void(int token) { if (token == fallback_token) { fallback_token = 0; } });
    ui_mount() { use_frame(true, void(Tick tick) { frame_count++; frame_delta = tick.delta; }); }
    ui_frame();
    check(fallback_token != 0, "the fallback timer is armed");
    check(ui_event_timer(fallback_token) && ui_event_timer(fallback_token) && frame_count == 2, "its ticks are frames");
    check(frame_delta > 0.0159 && frame_delta < 0.0161, "16 ms apart");
    ui_shutdown();
    check(fallback_token == 0, "unmounting stops the fallback timer");
    balanced("fallback frames leak");
}

int app_state_changes;
bool app_state_last;
*Signal<bool> app_state_listening;

void app_state() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() {
        app_state_listening = use_signal<bool>(true);
        if (app_state_listening.get()) {
            Column(Style{}) { use_app_state(void(bool active) { app_state_changes++; app_state_last = active; }); }
        }
    }
    ui_frame();
    ui_set_active(false);
    check(app_state_changes == 1 && !app_state_last, "leaving the foreground is reported");
    ui_set_active(false);
    check(app_state_changes == 1, "only changes are");
    ui_set_active(true);
    check(app_state_changes == 2 && app_state_last, "coming back is reported");
    app_state_listening.set(false); ui_frame();
    ui_set_active(false);
    check(app_state_changes == 2, "an unmounted scope hears nothing");
    ui_shutdown();
    balanced("app state leaks");
}

int repeat_seen;
int sequence_seen;
int then_seen;
int then_done;
*Signal<int> then_target;
bool motion_frames;

void motions() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_set_frame_host(void(bool on) { motion_frames = on; });
    ui_mount() {
        repeat_seen = use_repeat(0, 100, 100, EaseLinear, 2, true);
        Keyframe[3] steps = {Keyframe{10, 50, EaseLinear}, Keyframe{30, 100, EaseLinear}, Keyframe{0, 100, EaseLinear}};
        sequence_seen = use_sequence(&steps[0], 3, 1);
        then_target = use_signal<int>(0);
        then_seen = use_animated_then(then_target.get(), 100, EaseLinear, void() { then_done++; });
    }
    ui_frame();
    check(motion_frames, "repeats and sequences run on display frames");
    ui_event_frame(0); ui_frame();
    ui_event_frame(0.050); ui_frame();
    check(repeat_seen == 50, "halfway through the first time");
    check(sequence_seen == 10, "the first keyframe holds for its time");
    ui_event_frame(0.100); ui_frame();
    check(sequence_seen == 20, "then moves to the next");
    ui_event_frame(0.150); ui_frame();
    check(repeat_seen == 50 && sequence_seen == 30, "the repeat comes back (reverse); the sequence reached its second value");
    ui_event_frame(0.250); ui_frame();
    check(sequence_seen == 0, "and its last");
    ui_event_frame(0.300); ui_frame();
    check(repeat_seen == 0 && sequence_seen == 0, "both end: the repeat back at its start after two times");
    check(!motion_frames, "and the frames stop");
    then_target.set(100); ui_frame();
    check(motion_frames, "a new target runs frames");
    ui_event_frame(1.0); ui_frame();
    ui_event_frame(1.1); ui_frame();
    check(then_seen == 100 && then_done == 1, "on_done when it arrives");
    ui_frame();
    check(then_done == 1 && !motion_frames, "once");
    ui_shutdown(); balanced("motions leak");
}

int seen_scheme;
string seen_locale;

void environment_apis() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() {
        Row(Style{key: key(1)}) { seen_scheme = ui_color_scheme(); seen_locale = ui_locale(); }
    }
    ui_frame();
    check(seen_scheme == SchemeLight && strcmp(seen_locale, "en") == 0, "light and English until the host says");
    check(ui_platform() == PlatformDesktop && strcmp(ui_platform_name(), "desktop") == 0, "the platform");
    ui_set_appearance(SchemeDark);
    ui_set_locale("es-MX", false);
    ui_set_accessibility(true, true, 130);
    ui_frame();
    check(seen_scheme == SchemeDark && strcmp(seen_locale, "es-MX") == 0, "readers see the system");
    check(ui_screen_reader() && ui_reduce_motion() && ui_font_scale() == 130, "accessibility");
    int runs = keyed(1).runs;
    ui_set_appearance(SchemeDark);
    check(!ui_needs_frame() && keyed(1).runs == runs, "the same appearance changes nothing");
    kit_follow_system();
    check(kit.dark, "the kit follows");
    // A wide window gets the dense sizes; a phone's keeps the touch ones.
    ui_set_window(Window{1280, 800, 200});
    check(ui_wide(), "a computer's window is wide");
    kit_follow_system();
    check(kit.dense && kit.body_size == 14 && kit.control_padding == 8, "the kit is dense in a wide window");
    ui_set_window(Window{390, 844, 300});
    kit_follow_system();
    check(!ui_wide() && !kit.dense && kit.body_size == 16, "and touch-sized on a phone");
    kit = kit_light();
    ui_shutdown(); balanced("environment apis leak");
}

string pasted;

void actions() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() { Row(Style{}, void() {}); }
    ui_frame();
    ui_clipboard_set("eskiu");
    ui_clipboard_get(void(string text) { pasted = ui_copy(text); });
    ui_haptic(HapticSuccess);
    ui_share("Look", null);
    ui_keyboard_dismiss();
    ui_announce("Saved");
    check(ui_needs_frame(), "commands need a frame");
    ui_frame();
    check(mutation_count == 6 && mutation_ops[0] == 10 && mutation_kinds[0] == 6 && strcmp(mutation_texts[0], "eskiu") == 0,
        "copy");
    check(mutation_kinds[1] == 7 && mutation_befores[1] == 0, "paste, with no strings");
    check(mutation_kinds[2] == 8 && strcmp(mutation_texts[2], "4") == 0, "a haptic by kind");
    check(mutation_kinds[3] == 5 && mutation_befores[3] == 2, "share: text and an empty URL");
    check(mutation_kinds[4] == 4 && mutation_kinds[5] == 9, "keyboard, announce");
    check(ui_event_answer(mutation_ids[1], "eskiu") && strcmp(pasted, "eskiu") == 0, "the paste answered");
    check(!ui_event_answer(mutation_ids[1], "again"), "once");
    free(pasted);
    ui_clipboard_get(void(string text) {});
    ui_shutdown(); balanced("actions leak");
}

void storage() {
    ui_set_data_dir("build/storage-test");
    fs_remove_all("build/storage-test");
    check(ui_storage_get("theme") == null, "nothing saved yet");
    ui_storage_set("theme", "dark");
    ui_storage_set("note", "two\tparts\nand \\ a slash");
    ui_storage_set("theme", "light");
    ui_storage_unload();
    check(strcmp(ui_storage_get("theme"), "light") == 0, "saved and read back from the file");
    check(strcmp(ui_storage_get("note"), "two\tparts\nand \\ a slash") == 0, "tabs, newlines and slashes survive");
    ui_storage_remove("theme");
    ui_storage_unload();
    check(ui_storage_get("theme") == null && ui_storage_get("note") != null, "removed");
    ui_storage_unload();
    ui_set_data_dir(null);
    balanced("storage leak");
}

int fetched_status;
string fetched;

void network() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount() { Row(Style{}, void() {}); }
    ui_frame();
    ui_fetch(FetchRequest{url: "https://example.com/a", headers: "Accept: text/plain"}, void(FetchResult r) {
        fetched_status = r.status;
        fetched = ui_copy(r.status == 0 ? r.error : r.body);
    });
    ui_frame();
    check(mutation_count == 1 && mutation_kinds[0] == 10 && mutation_befores[0] == 6 &&
          strcmp(mutation_texts[0], "https://example.com/a") == 0, "a fetch command: URL, method, headers, body, timeout");
    int request = mutation_ids[0];
    check(ui_event_fetch(request, 200, "hello", "Content-Type: text/plain"), "the answer");
    check(fetched_status == 200 && strcmp(fetched, "hello") == 0, "status and body");
    free(fetched);
    ui_fetch(FetchRequest{url: "https://nowhere.invalid"}, void(FetchResult r) {
        fetched_status = r.status;
        fetched = ui_copy(r.error);
    });
    ui_frame();
    ui_event_fetch(mutation_ids[0], 0, "no such host", null);
    check(fetched_status == 0 && strcmp(fetched, "no such host") == 0, "a failure");
    free(fetched);
    ui_fetch(FetchRequest{url: "https://example.com"}, void(FetchResult r) {});
    ui_shutdown(); balanced("network leak");
}

int animated_seen;
*Signal<int> animated_target;
int animated_token;
bool animated_armed;

void animated_values() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_set_timer_host(void(int token, int ms, bool repeat) { animated_token = token; animated_armed = true; },
        void(int token) { animated_armed = false; });
    ui_mount() {
        animated_target = use_signal<int>(0);
        animated_seen = use_animated(animated_target.get(), 160, EaseLinear);
    }
    ui_frame();
    check(animated_seen == 0 && !animated_armed, "at rest: no clock");
    animated_target.set(100); ui_frame();
    check(animated_seen == 0 && animated_armed, "a new target starts the clock from where it was");
    // The first frame starts the clock (no time has passed); each one after is 16 ms.
    for (i in 0..6) { ui_event_timer(animated_token); ui_frame(); }
    check(animated_seen == 50, "halfway after half the time (linear)");
    for (i in 0..5) { ui_event_timer(animated_token); ui_frame(); }
    check(animated_seen == 100 && !animated_armed, "there, and the clock stops");
    check(ui_ease(EaseOut, 500) > 500 && ui_ease(EaseIn, 500) < 500 && ui_ease(EaseSpring, 800) > 1000, "the curves");
    ui_shutdown(); balanced("animated leak");
}
