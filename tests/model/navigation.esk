// Navigation: the router's stack, screens kept under the top, back, links and the history.
// Part of the model tests (tests/model/main.esk imports every part).

*Router nav_router;

int nav_detail_runs;

// The screens with their active prop, from the root: "1" on top, "0" under it.
void nav_screens(String* out) {
    String_clear(out);
    for (i in 0..ui.by_id.size) {
        *Node node = ui.by_id.data[i];
        if (node != null && node.kind == 14) { String_append(out, node.props[23] != 0 ? "1" : "0"); }
    }
}

// Whether a text node shows `text`.
bool nav_text_shown(string text) {
    for (i in 0..ui.by_id.size) {
        *Node node = ui.by_id.data[i];
        if (node != null && node.kind == 3 && node.text != null && strcmp(node.text, text) == 0) { return true; }
    }
    return false;
}

// Press the button showing `text`.
void nav_press(string text) {
    for (i in 0..ui.by_id.size) {
        *Node node = ui.by_id.data[i];
        if (node != null && node.kind == 4 && node.text != null && strcmp(node.text, text) == 0) {
            ui_event(node.id, node.generation);
            ui_frame();
            return;
        }
    }
    check(false, "a button to press");
}

// A screen handed its parameter as text, shown from a block of its own that renders again on
// its own when nav_tick changes, after the Navigator's block has returned: the text must
// outlive that block (route_param's does; route_match's params are freed by then).
*Signal<int> nav_tick;

void NavNote(string name) {
    Column(Style{}) {
        nav_tick.get();
        String title;
        defer String_free(&title);
        String_format(&title, "Note %s", name);
        Text(title.data);
    }
}

void nav_app() {
    Navigator(nav_router, void(string route) {
        string note = route_param("/notes/:name", route, 0);
        if (note != null) {
            NavNote(note);
            return;
        }
        List<String> params;
        defer route_params_free(&params);
        if (route_match("/tasks/:id", route, &params)) {
            nav_detail_runs++;
            String title;
            defer String_free(&title);
            String_format(&title, "Task %s", params.data[0].data);
            Text(title.data);
            Button("Back") { nav_router.back(); }
        } else {
            *Signal<int> taps = use_signal<int>(0);
            text_number(taps.get());
            Button("Tap") { taps.set(taps.get() + 1); }
            Button("Open") { nav_router.push("/tasks/42"); }
        }
    });
}

void navigation() {
    List<String> params;
    check(route_match("/tasks/:id", "/tasks/7?tab=notes", &params) && params.size == 1 &&
          String_eq_cstr(&params.data[0], "7") == 1, "a parameter, the query ignored");
    route_params_free(&params);
    check(!route_match("/tasks/:id", "/tasks", null) && !route_match("/tasks", "/tasks/7", null), "segment counts");
    check(route_match("/", "/", null) && !route_match("/a", "/b", null), "literal segments");
    check(route_match("/files/*", "/files/a/b.txt", &params) && String_eq_cstr(&params.data[0], "a/b.txt") == 1, "rest");
    route_params_free(&params);
    String route;
    ui_link_route("https://example.com/tasks/3?x=1#top", &route);
    check(String_eq_cstr(&route, "/tasks/3?x=1") == 1, "a web link's path");
    ui_link_route("myapp://tasks/3", &route);
    check(String_eq_cstr(&route, "/tasks/3") == 1, "a custom scheme's host is the first part");
    String_free(&route);

    Ui runtime;
    ui_init(&runtime, record);
    nav_router = router_new("/");
    ui_mount() { nav_app(); }
    ui_frame();
    check(mutation_ops[mutation_count - 1] == 10 && mutation_kinds[mutation_count - 1] == 3 &&
          strcmp(mutation_texts[mutation_count - 1], "reset") == 0, "the URL follows the first navigator");
    String screens;
    nav_screens(&screens);
    check(String_eq_cstr(&screens, "1") == 1, "the root screen");
    nav_press("Tap");
    nav_press("Open");
    nav_screens(&screens);
    check(String_eq_cstr(&screens, "01") == 1, "the root stays mounted, hidden");
    check(strcmp(nav_router.path(), "/tasks/42") == 0 && nav_router.depth() == 2, "pushed");
    check(ops[10] == 1 && strcmp(mutation_texts[mutation_count - 1], "push") == 0, "a history push");
    check(ui_back() && nav_router.depth() == 1, "back pops the navigator");
    ui_frame();
    nav_screens(&screens);
    check(String_eq_cstr(&screens, "1") == 1, "the detail screen is gone");
    check(text_is(keyed(0).children.data[0], 1), "the root kept its state");
    check(!ui_back(), "at the root, back is the platform's");
    // A link the app is opened with is pushed.
    ui_set_link("myapp://tasks/9");
    ui_frame();
    check(strcmp(nav_router.path(), "/tasks/9") == 0, "a link opens its route");
    // The browser went back to the first entry, then forward again.
    check(ui_event_route("/", 0), "a route event");
    ui_frame();
    check(nav_router.depth() == 1, "the browser's back");
    ui_event_route("/tasks/9", 1);
    ui_frame();
    check(nav_router.depth() == 2 && strcmp(nav_router.path(), "/tasks/9") == 0, "and forward");
    nav_router.replace("/tasks/10");
    ui_frame();
    check(strcmp(nav_router.path(), "/tasks/10") == 0 && strcmp(mutation_texts[mutation_count - 1], "replace") == 0,
        "replace");
    nav_router.reset("/");
    ui_frame();
    check(nav_router.depth() == 1, "reset");
    // A parameter a screen keeps: the right text in its block, again after a render, and freed
    // with the route.
    nav_tick = signal_new<int>(0);
    nav_router.push("/notes/groceries");
    ui_frame();
    check(nav_text_shown("Note groceries"), "a kept route parameter");
    // Only the note's block renders again: the Navigator's does not.
    nav_tick.set(1);
    ui_frame();
    check(nav_text_shown("Note groceries"), "the parameter after the screen's block renders on its own");
    check(route_param("/notes/:name", nav_router.path(), 0) == route_param("/notes/:name", nav_router.path(), 0),
          "the same text each time");
    check(route_param("/notes/:name", nav_router.path(), 1) == null && route_param("/tasks/:id", nav_router.path(), 0) == null,
          "no parameter past the last, none for another pattern");
    nav_router.replace("/notes/errands");
    ui_frame();
    check(nav_text_shown("Note errands"), "the replaced route's parameter");
    nav_router.reset("/");
    ui_frame();
    check(ui_route_params.size == 0, "the parameters go with their routes");
    nav_tick.free();
    String_free(&screens);
    ui_shutdown();
    nav_router.free();
    balanced("navigation leak");
}
