// The counter with no screen: a renderer that prints the texts it receives.
import "../../examples/counter/src/counter.esk";

int main() {
    Ui runtime;
    ui_init(&runtime, void(*uint8 data, int len) {
        List<Mutation> items;
        ui_decode(data, len, &items);
        for (i in 0..items.size) {
            if (items.data[i].op == 3) { printf("%s\n", items.data[i].text); }
        }
        items.free();
        ui_complete(ui.sequence);
    });
    ui_mount() { Counter(); }
    ui_frame();
    int button = ui.root.children.data[0].children.data[2].id;
    for (i in 0..3) { ui_event(button, 1); ui_frame(); }
    ui_shutdown();
    return 0;
}
