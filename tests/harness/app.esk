// The test app every host runs: the examples, the conformance scene and a scheduler probe,
// picked by the number the host was started with.
import "../../examples/counter/src/counter.esk";
import "../../examples/todo/src/todo.esk";
import "../../examples/tasks/src/tasks.esk";
import "../../examples/kit-gallery/src/gallery.esk";
import "../../examples/native/src/clock.esk";
import "conformance.esk";
import "../../hosts/bridge.esk";

// The examples behind one host app: `which` picks one (0 counter, 1 TODO, 2 a scheduler
// probe, 3 the conformance scene, 4 the Tasks showcase, 5 the kit gallery, 6 native code: the
// native example's clock module and slider view, built from examples/native/native, 7 error
// recovery: a boundary whose content breaks on demand and a handler that throws).
void ui_app_start(int example) {
    if (example == 0) { ui_mount(void() { Counter(); }); }
    else if (example == 7) {
        ui_mount() {
            ErrorBoundary(void(UiError e) {
                Text("Recovered");
                Button("Retry") { ui_boundary_reset(e.boundary); }
            }) {
                *Signal<bool> broken = use_signal<bool>(false);
                if (broken.get()) { throw 7; }
                Button("Break") { broken.set(true); }
            }
            Button("Throw in handler") { throw 3; }
        }
    }
    else if (example == 6) { ui_mount(void() { Clock(); }); }
    else if (example == 5) { ui_mount(void() { KitGallery(); }); }
    else if (example == 4) {
        tasks_seed(&task_store);
        ui_mount() { TasksApp(&task_store); }
    }
    else if (example == 3) {
        conformance_reset();
        ui_mount() { Conformance(); }
    }
    else if (example == 2) {
        // Scheduler probe: effects must advance without another user event.
        ui_mount() {
            *Signal<int> progress = use_signal<int>(0);
            NumberText("Progress: ", progress.get());
            use_effect() {
                int value = progress.get();
                if (value < 2) { progress.set(value + 1); }
            }
        }
    }
    else {
        todo_store.init();
        todo_store.add("Try Eskiu UI");
        todo_store.add("Reorder without losing state");
        ui_mount() { TodoApp(&todo_store); }
    }
}

void ui_app_stop() {
    if (todo_store.revision != null) { todo_store.free(); }
    if (task_store.revision != null) { task_store.free(); }
}
