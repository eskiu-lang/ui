import "../../hosts/bridge.esk";
import <string>;

// The conformance scene: one fixed-width column whose fixed-size elements come first, so
// their frames are known in advance on every renderer (tools/conformance.py has them).
// Every element a host reports carries a label; handlers append to the log.
String conformance_log;

// The size the layout handler last logged.
Frame conformance_frame;

void conformance_reset() {
    String_free(&conformance_log);
    conformance_frame = Frame{};
    ui_test_log = null;
}

void conformance_note(string entry) {
    if (conformance_log.len > 0) { String_append(&conformance_log, ","); }
    String_append(&conformance_log, entry);
    ui_test_log = conformance_log.data;
}

void Conformance() {
    Column(Style{width: 320, padding: 10, gap: 10, label: "Suite"}) {
        // The host's clock: right after the first frame (and its layout report).
        use_timeout(1) {
            conformance_note("timer");
            // Storage: written, then read back.
            ui_storage_set("conformance", "saved");
            String entry;
            defer String_free(&entry);
            String_appendf(&entry, "store:%s", ui_storage_get("conformance"));
            conformance_note(entry.data);
            // The network: tools/conformance.py serves "pong" on the host's port 8899, which the
            // Android emulator reaches as 10.0.2.2.
            string ping = ui_platform() == PlatformAndroid ? "http://10.0.2.2:8899/ping" : "http://127.0.0.1:8899/ping";
            ui_fetch(FetchRequest{url: ping}, void(FetchResult r) {
                String answer;
                defer String_free(&answer);
                String_appendf(&answer, "fetch:%d:%s", r.status, r.status == 0 ? r.error : r.body);
                conformance_note(answer.data);
            });
        }
        Row(Style{gap: 10, height: 50, label: "Boxes"}) {
            Row(Style{width: 100, height: 50, label: "Fixed"}) {}
            Row(Style{grow: 1, height: 50, label: "Grow"}) {}
        }
        Scroll(Style{height: 100, label: "List"}) {
            Row(Style{key: key(0), height: 40, label: "Item 0"}) {}
            Row(Style{key: key(1), height: 40, label: "Item 1"}) {}
            Row(Style{key: key(2), height: 40, label: "Item 2"}) {}
        }
        Image(Style{width: 48, height: 48, label: "Logo"}, "logo.png");
        *StringState field = use_string("");
        TextInput(Input{value: field.get(), label: "Field"}, void(string text) {
            String entry;
            defer String_free(&entry);
            String_appendf(&entry, "text:%s", text);
            conformance_note(entry.data);
            field.set(text);
        });
        Button("Tap") { conformance_note("tap"); }
        Pressable(Style{width: 100, height: 40, label: "Press"}, void() { conformance_note("press"); }) {}
        *Signal<bool> on = use_signal<bool>(false);
        Switch(Style{label: "Toggle"}, on.get(), void(bool value) {
            conformance_note(value ? "switch:1" : "switch:0");
            on.set(value);
        });
        *Signal<int> volume = use_signal<int>(30);
        Slider(Style{label: "Volume"}, volume.get(), 0, 100, void(int v) {
            String entry;
            defer String_free(&entry);
            String_appendf(&entry, "slider:%d", v);
            conformance_note(entry.data);
            volume.set(v);
        });
        // The clipboard: copy, then read it back.
        Button("Copy") {
            ui_clipboard_set("eskiu");
            ui_clipboard_get(void(string text) {
                String entry;
                defer String_free(&entry);
                String_appendf(&entry, "clip:%s", text);
                conformance_note(entry.data);
            });
        }
        ActivityIndicator(Style{width: 24, height: 24, label: "Busy"}, true);
        Row(Style{width: 60, height: 30, label: "Painted", background: rgb(255, 0, 0), radius: 8,
                  border_width: 2, border_color: rgb(0, 0, 0), opacity: 50}) {}
        TextWith(Style{label: "Title", color: rgb(0, 0, 255), font_size: 24, font_weight: 700}, "Title");
        StatusBar(BarDark, false);
        Button("Ask") {
            Alert("Ask?", "Pick one", "No\nYes", void(int choice) {
                String entry;
                defer String_free(&entry);
                String_appendf(&entry, "alert:%d", choice);
                conformance_note(entry.data);
            });
        }
        *Signal<bool> sheet = use_signal<bool>(false);
        Button("Open sheet") { sheet.set(true); }
        Modal(sheet.get(), void() { conformance_note("close"); sheet.set(false); }) {
            Column(Style{label: "Sheet", width: 200, height: 100, background: rgb(255, 255, 255)}) {
                Button("Close") { conformance_note("close"); sheet.set(false); }
            }
        }
        *Signal<bool> loading = use_signal<bool>(false);
        Button("Loaded") { loading.set(false); }
        // 1000 rows, of which only those near the viewport exist; pull to refresh.
        RefreshControl(loading.get()) { conformance_note("refresh"); loading.set(true); }
        FlatList(Style{height: 120, label: "Feed"}, 1000, 40, void(int i) {
            String label;
            defer String_free(&label);
            String_appendf(&label, "Row %d", i);
            Row(Style{height: 40, label: label.data}) {}
        });
        // Out of the flow: pinned to the stage's top right; a ratio gives the height.
        Row(Style{height: 60, label: "Stage"}) {
            Row(Style{absolute: true, right: 10, top: 5, width: 40, height: 30, label: "Pinned"}) {}
            // Drawn moved, scaled and turned; laid out where it was.
            Row(Style{absolute: true, left: 0, bottom: 0, width: 20, height: 20, translate_x: 20, translate_y: 10,
                      scale: 150, rotate: 45, label: "Moved"}) {}
            ui_on_layout(void(Frame f) {
                if (f.width == conformance_frame.width && f.height == conformance_frame.height) { return; }
                conformance_frame = f;
                String entry;
                defer String_free(&entry);
                String_appendf(&entry, "layout:%dx%d", f.width, f.height);
                conformance_note(entry.data);
            });
            Row(Style{width: 100, aspect_ratio: 2.0, label: "Ratio"}) {}
        }
    }
}
