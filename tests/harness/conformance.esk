import "../../hosts/bridge.esk";
import <string>;

// The conformance scene: one fixed-width column whose fixed-size elements come first, so
// their frames are known in advance on every renderer (tools/conformance.py has them).
// Every element a host reports carries a label; handlers append to the log.
String conformance_log;

// The size the layout handler last logged.
Frame conformance_frame;

void conformance_reset() {
    String_free(&conformance_log);
    conformance_frame = Frame{};
    ui_test_log = null;
}

void conformance_note(string entry) {
    if (conformance_log.len > 0) { String_append(&conformance_log, ","); }
    String_append(&conformance_log, entry);
    ui_test_log = conformance_log.data;
}

void Conformance() {
    Column(Style{width: 320, padding: 10, gap: 10, label: "Suite"}, void() {
        // The host's clock: right after the first frame (and its layout report).
        use_timeout(1, void() { conformance_note("timer"); });
        Row(Style{gap: 10, height: 50, label: "Boxes"}, void() {
            Row(Style{width: 100, height: 50, label: "Fixed"}, void() {});
            Row(Style{grow: 1, height: 50, label: "Grow"}, void() {});
        });
        Scroll(Style{height: 100, label: "List"}, void() {
            Row(Style{key: key(0), height: 40, label: "Item 0"}, void() {});
            Row(Style{key: key(1), height: 40, label: "Item 1"}, void() {});
            Row(Style{key: key(2), height: 40, label: "Item 2"}, void() {});
        });
        Image(Style{width: 48, height: 48, label: "Logo"}, "logo.png");
        *StringState field = use_string("");
        TextInput(Input{value: field.get(), label: "Field"}, void(string text) {
            String entry;
            defer String_free(&entry);
            String_appendf(&entry, "text:%s", text);
            conformance_note(entry.data);
            field.set(text);
        });
        Button("Tap", void() { conformance_note("tap"); });
        Pressable(Style{width: 100, height: 40, label: "Press"}, void() { conformance_note("press"); }, void() {});
        *Signal<bool> on = use_signal<bool>(false);
        Switch(Style{label: "Toggle"}, on.get(), void(bool value) {
            conformance_note(value ? "switch:1" : "switch:0");
            on.set(value);
        });
        *Signal<int> volume = use_signal<int>(30);
        Slider(Style{label: "Volume"}, volume.get(), 0, 100, void(int v) {
            String entry;
            defer String_free(&entry);
            String_appendf(&entry, "slider:%d", v);
            conformance_note(entry.data);
            volume.set(v);
        });
        ActivityIndicator(Style{width: 24, height: 24, label: "Busy"}, true);
        Row(Style{width: 60, height: 30, label: "Painted", background: rgb(255, 0, 0), radius: 8,
                  border_width: 2, border_color: rgb(0, 0, 0), opacity: 50}, void() {});
        TextWith(Style{label: "Title", color: rgb(0, 0, 255), font_size: 24, font_weight: 700}, "Title");
        StatusBar(BarDark, false);
        Button("Ask", void() {
            Alert("Ask?", "Pick one", "No\nYes", void(int choice) {
                String entry;
                defer String_free(&entry);
                String_appendf(&entry, "alert:%d", choice);
                conformance_note(entry.data);
            });
        });
        *Signal<bool> sheet = use_signal<bool>(false);
        Button("Open sheet", void() { sheet.set(true); });
        Modal(sheet.get(), void() { conformance_note("close"); sheet.set(false); }, void() {
            Column(Style{label: "Sheet", width: 200, height: 100, background: rgb(255, 255, 255)}, void() {
                Button("Close", void() { conformance_note("close"); sheet.set(false); });
            });
        });
        *Signal<bool> loading = use_signal<bool>(false);
        Button("Loaded", void() { loading.set(false); });
        // 1000 rows, of which only those near the viewport exist; pull to refresh.
        RefreshControl(loading.get(), void() { conformance_note("refresh"); loading.set(true); });
        FlatList(Style{height: 120, label: "Feed"}, 1000, 40, void(int i) {
            String label;
            defer String_free(&label);
            String_appendf(&label, "Row %d", i);
            Row(Style{height: 40, label: label.data}, void() {});
        });
        // Out of the flow: pinned to the stage's top right; a ratio gives the height.
        Row(Style{height: 60, label: "Stage"}, void() {
            Row(Style{absolute: true, right: 10, top: 5, width: 40, height: 30, label: "Pinned"}, void() {});
            ui_on_layout(void(Frame f) {
                if (f.width == conformance_frame.width && f.height == conformance_frame.height) { return; }
                conformance_frame = f;
                String entry;
                defer String_free(&entry);
                String_appendf(&entry, "layout:%dx%d", f.width, f.height);
                conformance_note(entry.data);
            });
            Row(Style{width: 100, aspect_ratio: 2.0, label: "Ratio"}, void() {});
        });
    });
}
