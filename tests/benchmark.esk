import "../examples/todo/src/todo.esk";
import "../examples/counter/src/counter.esk";
extern double ui_clock_ms();

void host(*uint8 data, int len) { ui_complete(ui.sequence); }

void benchmark(int rows, int frames) {
    Store model;
    *Store store = &model;
    store.init();
    for (i in 0..rows) { store.add("Task"); }
    Ui runtime;
    ui_init(&runtime, host);
    ui_mount() { TodoApp(store); }
    ui_frame();
    double[100] times;
    for (i in 0..frames) {
        double start = ui_clock_ms();
        store.changed(); ui_frame();
        times[i] = ui_clock_ms() - start;
    }
    for (i in 0..frames) {
        for (int j = i + 1; j < frames; j++) {
            if (times[j] < times[i]) { double temporary = times[i]; times[i] = times[j]; times[j] = temporary; }
        }
    }
    printf("rows=%d frames=%d p50_ms=%.3f p95_ms=%.3f\n", rows, frames, times[frames / 2], times[frames * 95 / 100]);
    ui_shutdown(); store.free();
}

// Whole-list operations: mount, reverse (every row moves), one event, unmount.
void scaling(int rows) {
    Store model;
    *Store store = &model;
    store.init();
    for (i in 0..rows) { store.add("Task"); }
    Ui runtime;
    ui_init(&runtime, host);
    double start = ui_clock_ms();
    ui_mount() { TodoApp(store); }
    ui_frame();
    double mounted = ui_clock_ms();
    for (int i = 0; i < rows / 2; i++) {
        Todo temporary = store.items.data[i];
        store.items.data[i] = store.items.data[rows - 1 - i];
        store.items.data[rows - 1 - i] = temporary;
    }
    store.changed(); ui_frame();
    double reversed = ui_clock_ms();
    // The last row's "Done" button: the deepest, last-created handler.
    *Node list = ui.root.children.data[0].children.data[2];
    *Node row = list.children.data[rows - 1];
    ui_event(row.children.data[1].id, row.children.data[1].generation);
    ui_frame();
    double dispatched = ui_clock_ms();
    ui_shutdown();
    double unmounted = ui_clock_ms();
    printf("scale rows=%d mount_ms=%.1f reverse_ms=%.1f event_ms=%.1f unmount_ms=%.1f\n", rows,
        mounted - start, reversed - mounted, dispatched - reversed, unmounted - dispatched);
    store.free();
}

// Every row reads one shared signal: a change re-runs all of them, and each re-run
// re-subscribes.
void shared_reader(int rows) {
    *Signal<int> selected = signal_new<int>(0);
    Ui runtime;
    ui_init(&runtime, host);
    ui_mount() {
        Column(Style{}) {
            for (i in 0..rows) {
                int id = i;
                Row(Style{key: key(id)}) {
                    Text(selected.get() == id ? "selected" : "row");
                }
            }
        }
    }
    ui_frame();
    double start = ui_clock_ms();
    selected.set(rows / 2); ui_frame();
    double changed = ui_clock_ms();
    ui_shutdown();
    double unmounted = ui_clock_ms();
    printf("shared rows=%d change_ms=%.1f unmount_ms=%.1f\n", rows, changed - start, unmounted - changed);
    selected.free();
}

// A FlatList's cost is its window, not its length.
void virtual_list(int rows) {
    Ui runtime;
    ui_init(&runtime, host);
    double start = ui_clock_ms();
    ui_mount() { FlatList(Style{height: 800}, rows, 40, void(int i) { NumberText("Row ", i); }); }
    ui_frame();
    double mounted = ui_clock_ms();
    *Node list = ui.root.children.data[0];
    double worst = 0;
    for (step in 1..101) {
        double before = ui_clock_ms();
        ui_event_scroll(list.id, list.generation, step * 400, 800);
        ui_frame();
        double took = ui_clock_ms() - before;
        if (took > worst) { worst = took; }
    }
    printf("virtual rows=%d mount_ms=%.2f worst_scroll_frame_ms=%.3f\n", rows, mounted - start, worst);
    ui_shutdown();
}

int main() {
    benchmark(10, 100); benchmark(100, 100); benchmark(1000, 20);
    scaling(1000); scaling(2000); scaling(5000); scaling(10000);
    shared_reader(1000); shared_reader(5000); shared_reader(10000);
    virtual_list(1000); virtual_list(1000000);
    return 0;
}
