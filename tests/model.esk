*Signal<bool> show_details;
*Signal<bool> modal_open;
bool consume_back;
int closes;
void back_and_modal() {
    Ui runtime;
    closes = 0;
    consume_back = true;
    ui_init(&runtime, record);
    ui_mount(void() {
        show_details = use_signal<bool>(true);
        modal_open = use_signal<bool>(false);
        if (show_details.get()) {
            Scope("Details", Key{}, void() { use_back(bool() { return consume_back; }); });
        }
        Modal(modal_open.get(), void() { closes++; modal_open.set(false); }, void() { Text("Sheet"); });
    });
    ui_frame();
    check(ui_back(), "the handler takes the back press");
    consume_back = false;
    check(!ui_back(), "a handler that declines lets the platform go back");
    modal_open.set(true); ui_frame();
    check(ui.modals.size == 1 && ui.root.children.data[1].kind == 12, "the modal is open");
    check(ui_back() && closes == 1, "back asks the modal to close first");
    ui_frame();
    check(ui.modals.size == 0, "the modal closed");
    show_details.set(false); ui_frame();
    check(ui.back_handlers.size == 0, "an unmounted scope's handler is gone");
    ui_shutdown(); balanced("back and modal leak");
}

*Signal<bool> banner;
// An element that comes and goes does not move its siblings of other kinds.
void conditional_siblings() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount(void() {
        banner = use_signal<bool>(false);
        if (banner.get()) { Text("Saved"); }
        Row(Style{}, void() { *Signal<int> kept = use_signal<int>(7); text_number(kept.get()); });
        Scroll(Style{}, void() {});
    });
    ui_frame();
    *Node row = ui.root.children.data[0];
    *Node scroll = ui.root.children.data[1];
    *Signal<int> kept = (*Signal<int>)row.slots.data[0].data;
    kept.set(8); ui_frame();
    banner.set(true); ui_frame();
    check(ui.root.children.data[1] == row && ui.root.children.data[2] == scroll, "row and scroll keep their nodes");
    check(text_is(row.children.data[0], 8), "and the row its state");
    banner.set(false); ui_frame();
    check(ui.root.children.data[0] == row, "and when the text goes away");
    ui_shutdown(); balanced("conditional siblings leak");
}

*Signal<bool> loading;
int refreshes;
