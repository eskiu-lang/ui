        RefreshControl(loading.get(), void() { refreshes++; loading.set(true); });
        FlatList(Style{height: 200}, 50, 40, void(int i) { text_number(i); });
    });
    ui_frame();
    *Node list = ui.root.children.data[0];
    check(count_prop(2, 22) == 1 && prop_value(2, 22) == 0, "the list says it can refresh");
    check(ui_event_refresh(list.id, list.generation) && refreshes == 1, "a pull runs on_refresh");
    ui_frame();
    check(count_prop(2, 22) == 1 && prop_value(2, 22) == 1, "the indicator shows");
    loading.set(false); ui_frame();
    check(prop_value(2, 22) == 0, "and goes away");
    ui_shutdown(); balanced("refresh leak");
}

*Node find_label(*Node node, string label) {
    if (node.label != null && strcmp(node.label, label) == 0) { return node; }
    for (i in 0..node.children.size) {
        *Node found = find_label(node.children.data[i], label);
        if (found != null) { return found; }
    }
    return null;
}

// The showcase app: filters, toggling, adding; no leaks.
void tasks_app() {
    TaskStore model;
    *TaskStore store = &model;
    tasks_seed(store);
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount(void() { TasksApp(store); });
    ui_frame();
    check(find_label(ui.root, "Tasks").row_count == 7, "seven tasks");
    *Node active = find_label(ui.root, "Active");
    ui_event(active.id, active.generation); ui_frame();
    check(store.visible.size == 3 && find_label(ui.root, "Tasks").row_count == 3, "three active");
    *Node row = find_label(ui.root, "Book flights to Mexico City");
    *Node toggle = row.children.data[0];
    ui_event(toggle.id, toggle.generation); ui_frame();
    check(store.visible.size == 2, "marking one done leaves two active");
    *Node all = find_label(ui.root, "All");
    ui_event(all.id, all.generation); ui_frame();
    *Node field = find_label(ui.root, "New task");
    ui_event_text(field.id, field.generation, "Plan the launch"); ui_frame();
    *Node add = field.parent.children.data[1];
    ui_event(add.id, add.generation); ui_frame();
    check(store.tasks.size == 8 && find_label(ui.root, "Plan the launch") != null, "a typed task is added");
    ui_shutdown();
    store.free();
    balanced("tasks app leak");
}

void press_label(string label) {
    *Node node = find_label(ui.root, label);
    if (node == null) { print_err("missing: "); println_err(label); }
    check(node != null, "a labeled element to press");
    ui_event(node.id, node.generation);
    ui_frame();
}

// The kit: each control changes its state, closures passed in are freed (ui_own) however
// often the page renders.
void kit_gallery() {
    Ui runtime;
    ui_init(&runtime, record);
    ui_mount(void() { KitGallery(); });
    ui_frame();
    press_label("Weekly summary");
    check(find_label(ui.root, "Weekly summary").children.data[0].children.data[0].props[8] == kit.primary,
        "the checkbox is checked");
    press_label("Team");
    press_label("Month");
    press_label("Settings");
    press_label("What is Eskiu?");
    check(find_label(ui.root, "What is Eskiu?").parent.children.size == 2, "the section opened");
    int64 live = ui_live_allocations();
    for (i in 0..500) {
        press_label(i % 2 == 0 ? "Secondary" : "Ghost");
        press_label(i % 2 == 0 ? "Pro" : "Free");
    }
    check(ui_live_allocations() <= live + 8, "renders do not leak the closures components were given");
    ui_shutdown(); balanced("kit gallery leak");
}

int ticks;
string last_tap;
*Signal<int> map_zoom;
bool show_map;
void native_modules() {
    Ui runtime;
    ticks = 0;
    show_map = true;
    ui_init(&runtime, record);
    ui_mount(void() {
        map_zoom = use_signal<int>(3);
        use_native_event("ticker", void(string payload) { ticks += atoi(payload); });
        if (show_map) {
            String zoom;
            defer String_free(&zoom);
            String_format(&zoom, "%d", map_zoom.get());
            ui_native_prop("zoom", zoom.data);
            if (map_zoom.get() < 5) { ui_native_prop("style", "satellite"); }
            NativeView(Style{width: 200, height: 120, label: "Map"}, "MapView", void(string name, string payload) {
                last_tap = ui_copy(payload);
            });
        }
    });
    ui_frame();
    check(count_prop(9, 4) == 1 && ops[11] == 2, "the type once, then both named props");
    check(ui_event_native("ticker", "2") && ui_event_native("ticker", "3") && ticks == 5, "channel events");
    check(!ui_event_native("other", "1"), "no handler for another channel");
    map_zoom.set(4); ui_frame();
    check(ops[11] == 1 && strcmp(mutation_names[0], "zoom") == 0 && strcmp(mutation_texts[0], "4") == 0,
        "only the changed prop");
    map_zoom.set(6); ui_frame();
    check(ops[11] == 2, "the zoom and the style removed (sent empty)");
    *Node map = find_label(ui.root, "Map");
    check(ui_event_view(map.id, map.generation, "tap", "19.4,-99.1") && strcmp(last_tap, "19.4,-99.1") == 0,
        "a view's event reaches its handler");
    free(last_tap);
    show_map = false;
    map_zoom.set(7); ui_frame();
    check(ops[6] == 1, "the view is removed");
    ui_shutdown();
    check(ui == null, "shut down");
    balanced("native modules leak");
}

