}

int rendered_rows;
void flat_list() {
    Ui runtime;
    rendered_rows = 0;
    ui_init(&runtime, record);
    ui_mount(void() {
        FlatList(Style{height: 400}, 10000, 40, void(int i) { rendered_rows++; text_number(i); });
    });
    ui_frame();
    *Node list = ui.root.children.data[0];
    check(list.kind == 6 && list.virtual, "a flat list is a virtual scroll");
    check(list.children.size == 17, "16 rows (a viewport and the overscan) and the bottom spacer");
    check(text_is(list.children.data[0].children.data[0], 0), "row 0 first");
    int mounted = rendered_rows;
    ui_event_scroll(list.id, list.generation, 20, 400);
    check(!ui_frame(), "a move under one row renders nothing");
    ui_event_scroll(list.id, list.generation, 4000, 400);
    ui_frame();
    check(list.children.size == 23 && prop_value(2, 5) == 95 * 40, "rows 95 to 115 between two spacers");
    check(text_is(list.children.data[1].children.data[0], 95), "the window starts at row 95");
    int live = 0;
    for (i in 0..ui.by_id.size) { if (ui.by_id.data[i] != null) { live++; } }
    check(live < 80, "nodes stay bounded for 10,000 rows");
    check(rendered_rows - mounted < 40, "only the new rows are rendered");
    ui_shutdown(); balanced("flat list leak");
}

List<int> sections;
void section_list() {
    Ui runtime;
    sections.push(3); sections.push(100); sections.push(2);
    ui_init(&runtime, record);
    ui_mount(void() {
        SectionList(Style{height: 200}, &sections, 30, 40, void(int section, int item) {
            text_number(item < 0 ? 1000 + section : item);
        });
    });
    ui_frame();
    *Node list = ui.root.children.data[0];
    check(text_is(list.children.data[0].children.data[0], 1000), "section 0's header first");
    check(text_is(list.children.data[4].children.data[0], 1001), "then its 3 rows, then section 1's header");
    ui_event_scroll(list.id, list.generation, 2000, 200);
    ui_frame();
    check(list.children.data[0].key.value == -1 && list.children.data[0].kind == 2, "a top spacer");
    bool header0 = false;
    for (i in 0..list.children.size) { if (list.children.data[i].key.value == 0) { header0 = true; } }
    check(!header0, "section 0 is scrolled away");
    ui_shutdown(); sections.free(); balanced("section list leak");
}

int alert_choice;
void commands() {
    Ui runtime;
    alert_choice = -9;
    ui_init(&runtime, record);
    ui_mount(void() {
        Button("Delete", void() {
            Alert("Delete?", "It cannot be undone.", "Cancel\nDelete", void(int choice) { alert_choice = choice; });
        });
    });
    ui_frame();
    *Node button = ui.root.children.data[0];
    ui_event(button.id, button.generation);
    check(ui_needs_frame(), "an alert needs a frame to reach the host");
    ui_frame();
    check(mutation_count == 1 && mutation_ops[0] == 10 && mutation_kinds[0] == 1 && mutation_befores[0] == 4,
        "one alert command: title, message and two buttons");
    check(strcmp(mutation_texts[0], "Delete?") == 0, "its title");
    check(ui_event_alert(mutation_ids[0], 1) && alert_choice == 1 && ui.alerts.size == 0, "the answer");
    ui_open_url("https://eskiu-lang.org");
    ui_frame();
    check(mutation_ops[0] == 10 && mutation_kinds[0] == 2 && strcmp(mutation_texts[0], "https://eskiu-lang.org") == 0,
        "open a URL");
    // An unanswered alert is freed at shutdown.
    ui_event(button.id, button.generation);
    ui_frame();
    ui_shutdown(); balanced("commands leak");
}

