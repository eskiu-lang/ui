// Ed25519 and SHA-512 (src/apis/ed25519.esk) against RFC 8032's test vectors 1 to 3, FIPS
// 180's SHA-512 examples and a longer message signed by node's crypto; a changed message, a
// changed signature, an S not below the group's order and a key that is not a point are
// refused.
import <io>;
import <string>;
import <hash>;
import "../src/apis/ed25519.esk";

int failures;

void check(bool ok, string what) {
    if (!ok) { printf("FAIL %s\n", what); failures++; }
}

// `hex` into `out`; its length in bytes.
int unhex(string hex, *uint8 out) {
    return (int)hash_hex_decode(hex, out, 1100);
}

string hex_of(*uint8 data, int n) {
    String out;
    hash_hex_encode(data, n, &out);
    return out.data;
}

void sha(string message, int repeat, string expected) {
    UiSha512 h;
    ui_sha512_init(&h);
    for (int i = 0; i < repeat; i++) { ui_sha512_update(&h, (*uint8)message, strlen(message)); }
    uint8[64] digest;
    ui_sha512_final(&h, &digest[0]);
    check(strcmp(hex_of(&digest[0], 64), expected) == 0, expected);
}

void vector(string seed_hex, string public_hex, string message_hex, string signature_hex) {
    uint8[32] seed;
    uint8[32] public_key;
    uint8[1100] message;
    uint8[64] signature;
    unhex(seed_hex, &seed[0]);
    int n = unhex(message_hex, &message[0]);
    ui_ed25519_public_key(&seed[0], &public_key[0]);
    check(strcmp(hex_of(&public_key[0], 32), public_hex) == 0, public_hex);
    ui_ed25519_sign(&seed[0], &message[0], n, &signature[0]);
    check(strcmp(hex_of(&signature[0], 64), signature_hex) == 0, signature_hex);
    check(ui_ed25519_verify(&public_key[0], &message[0], n, &signature[0]), "verify");
    // A changed message, a changed signature.
    message[n] = 1;
    check(!ui_ed25519_verify(&public_key[0], &message[0], n + 1, &signature[0]), "a longer message is refused");
    signature[5] ^= 4;
    check(!ui_ed25519_verify(&public_key[0], &message[0], n, &signature[0]), "a changed R is refused");
    signature[5] ^= 4;
    signature[40] ^= 1;
    check(!ui_ed25519_verify(&public_key[0], &message[0], n, &signature[0]), "a changed S is refused");
    signature[40] ^= 1;
    check(ui_ed25519_verify(&public_key[0], &message[0], n, &signature[0]), "verify again");
}

int main() {
    sha("", 1, "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
    sha("abc", 1, "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
    sha("x", 200, "ef978e23dc520404ae16fd17bde9ee5945610d671551d6863a5ffbc99433fc726726e51f989b886191be9325b8f8b03b1a63fe3e5eff23d126c2f41f07d2bf87");
    vector("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
           "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "",
           "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b");
    vector("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
           "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c", "72",
           "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00");
    vector("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
           "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025", "af82",
           "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a");
    String long_message;
    for (i in 0..500) { String_append(&long_message, "6162"); }
    vector("0101010101010101010101010101010101010101010101010101010101010101",
           "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c", long_message.data,
           "a439326e885b7434fbe700c1ecdc5768c83256b647c9dc5c9a5f9372c8fd4c228f3844084437018ba1e9492894f2f53ebaa365cbd71c3c027ea87a87d2f68b0f");
    // S at the group's order (L): refused, though S mod L would pass a check that reduced it.
    uint8[32] public_key;
    uint8[64] signature;
    unhex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", &public_key[0]);
    unhex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b", &signature[0]);
    unhex("edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010", &signature[32]);
    check(!ui_ed25519_verify(&public_key[0], (*uint8)"", 0, &signature[0]), "S = L is refused");
    // A public key that is not on the curve (y = 2 has no x).
    uint8[32] bad;
    bad[0] = 2;
    unhex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b", &signature[0]);
    check(!ui_ed25519_verify(&bad[0], (*uint8)"", 0, &signature[0]), "a key off the curve is refused");
    if (failures > 0) { return 1; }
    printf("PASS ed25519: RFC 8032 vectors, SHA-512, rejections\n");
    return 0;
}
