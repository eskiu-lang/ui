import "../src/ui.esk";

// The bridge between a host (hosts/commit.h, hosts/web/ui-library.js, the iOS, Android and
// macOS hosts) and an app. The app defines what to mount and what to free:
//
//   void ui_app_start(int which) { ui_mount(void() { App(); }); }
//   void ui_app_stop() {}
//
// `which` is the example a host was asked for (0 unless it was given one).
void ui_app_start(int which);
void ui_app_stop();

// The host applies a whole commit (the format in src/ui.esk) and lays it out.
extern void ui_host_commit(*uint8 data, int len);
extern void ui_host_schedule();
extern void ui_host_cancel();
// The host's timers (use_interval, use_timeout): each tick calls ui_dispatch_timer(token).
extern void ui_host_timer_start(int token, int ms, int repeat);
extern void ui_host_timer_stop(int token);
Ui ui_host_runtime;

// What the hosts' conformance runs read back: the conformance scene writes its handler log
// here; any other app leaves it empty.
string ui_test_log;
string ui_conformance_log() { return ui_test_log == null ? "" : ui_test_log; }
bool app_active;

void ui_dispatch(int id, int generation) {
    if (!app_active) { return; }
    ui_event(id, generation);
    if (ui_needs_frame()) { ui_host_schedule(); }
}
void ui_dispatch_text(int id, int generation, string text) {
    if (!app_active) { return; }
    ui_event_text(id, generation, text);
    if (ui_needs_frame()) { ui_host_schedule(); }
}
void ui_dispatch_focus(int id, int generation, int focused) {
    if (!app_active) { return; }
    ui_event_focus(id, generation, focused != 0);
    if (ui_needs_frame()) { ui_host_schedule(); }
}
// The host's edge policy (ui_edge_policy, in src/core/state.esk).
int ui_edge_to_edge() { return ui_edge_policy; }

void ui_report_insets(int top, int right, int bottom, int left, int keyboard) {
    if (!app_active) { return; }
    ui_set_insets(Insets{top, right, bottom, left, keyboard});
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// A fetch finished: its status (0 when it failed, `body` the error), body and headers.
void ui_dispatch_fetch(int request, int status, string body, string headers) {
    if (!app_active) { return; }
    ui_event_fetch(request, status, body == null ? "" : body, headers);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// The app's data directory (ui_data_dir); hosts report it before ui_start.
void ui_report_data_dir(string path) { ui_set_data_dir(path); }

// The text a request asked for (the clipboard).
void ui_dispatch_answer(int request, string text) {
    if (!app_active) { return; }
    ui_event_answer(request, text == null ? "" : text);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// A drag on a node with a pan handler: phase (PanPhase), translation and velocity in points.
void ui_dispatch_pan(int id, int generation, int phase, int dx, int dy, int vx, int vy) {
    if (!app_active) { return; }
    ui_event_pan(id, generation, phase, dx, dy, vx, vy);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// The user moved a Slider to `value`.
void ui_dispatch_value(int id, int generation, int value) {
    if (!app_active) { return; }
    ui_event_value(id, generation, value);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// A pointer entered (1) or left (0) a node with a hover handler.
void ui_dispatch_hover(int id, int generation, int inside) {
    if (!app_active) { return; }
    ui_event_hover(id, generation, inside != 0);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// A timer the app armed fired.
void ui_dispatch_timer(int token) {
    if (!app_active) { return; }
    ui_event_timer(token);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// A node with a layout listener (ui_on_layout) was laid out at a new frame, in points
// relative to its parent.
void ui_dispatch_layout(int id, int generation, int x, int y, int width, int height) {
    if (!app_active) { return; }
    ui_event_layout(id, generation, x, y, width, height);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_dispatch_scroll(int id, int generation, int offset, int viewport) {
    if (!app_active) { return; }
    ui_event_scroll(id, generation, offset, viewport);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_dispatch_refresh(int id, int generation) {
    if (!app_active) { return; }
    ui_event_refresh(id, generation);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_dispatch_alert(int request, int choice) {
    if (!app_active) { return; }
    ui_event_alert(request, choice);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// Android's back press: 1 when the app handled it.
int ui_report_back() {
    if (!app_active) { return 0; }
    bool handled = ui_back();
    if (ui_needs_frame()) { ui_host_schedule(); }
    return handled ? 1 : 0;
}

// A link the host has before the app starts (the one it was opened with) waits for it.
string pending_link;

void ui_report_link(string url) {
    if (!app_active) {
        free(pending_link);
        pending_link = url == null ? null : ui_copy(url);
        return;
    }
    ui_set_link(url);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_dispatch_toggle(int id, int generation, int on) {
    if (!app_active) { return; }
    ui_event_toggle(id, generation, on != 0);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// The window in points and its scale, pixels per point times 100.
void ui_report_window(int width, int height, int scale) {
    if (!app_active) { return; }
    ui_set_window(Window{width, height, scale});
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// A native module posted `payload` on `channel` (use_native_event); both are read during
// the call. Hosts call it on the UI thread (ui_native_emit gets there from any thread).
void ui_dispatch_native(string channel, string payload) {
    if (!app_active) { return; }
    ui_event_native(channel, payload == null ? "" : payload);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// A NativeView sent an event: its name and payload, read during the call.
void ui_dispatch_view(int id, int generation, string name, string payload) {
    if (!app_active) { return; }
    ui_event_view(id, generation, name, payload == null ? "" : payload);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// The web: the browser went back or forward to `path`, at `index` in the app's history.
void ui_dispatch_route(string path, int index) {
    if (!app_active) { return; }
    ui_event_route(path, index);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

// The system's appearance (1 dark), accessibility settings (a screen reader, reduced motion,
// the text scale in percent) and language (a BCP 47 tag; 1 right to left).
void ui_report_appearance(int dark) {
    if (!app_active) { return; }
    ui_set_appearance(dark != 0 ? SchemeDark : SchemeLight);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_report_accessibility(int screen_reader, int reduce_motion, int font_scale) {
    if (!app_active) { return; }
    ui_set_accessibility(screen_reader != 0, reduce_motion != 0, font_scale);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_report_locale(string locale, int rtl) {
    if (!app_active) { return; }
    ui_set_locale(locale, rtl != 0);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_report_active(int active) {
    if (!app_active) { return; }
    ui_set_active(active != 0);
    if (ui_needs_frame()) { ui_host_schedule(); }
}

void ui_tick() {
    if (!app_active) { return; }
    ui_frame();
    if (ui_needs_frame()) { ui_host_schedule(); }
}
void ui_stop() {
    if (!app_active) { return; }
    app_active = false;
    ui_host_cancel();
    ui_shutdown();
    ui_app_stop();
}

void ui_start(int which) {
    if (app_active) { ui_stop(); }
    app_active = true;
    ui_init(&ui_host_runtime, void(*uint8 data, int len) {
        ui_host_commit(data, len);
        ui_complete(ui.sequence);
    });
    ui_set_timer_host(void(int token, int ms, bool repeat) { ui_host_timer_start(token, ms, repeat ? 1 : 0); },
        void(int token) { ui_host_timer_stop(token); });
    if (pending_link != null) {
        ui_set_link(pending_link);
        free(pending_link);
        pending_link = null;
    }
    ui_app_start(which);
    ui_frame();
    if (ui_needs_frame()) { ui_host_schedule(); }
}
