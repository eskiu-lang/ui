// A TODO list: keyed rows with their own state, a model-owned list, a text field.
import <string>;
import <ui>;

struct Todo { int id; bool done; string title; }
// The model owns its list, so it outlives any mount of the view that reads it; a change to
// the list renders what reads it.
struct Store { *ListSignal<Todo> items; int next_id; }
Store todo_store;

void Store_init(*Store self) { self.items = list_signal_new<Todo>(); }
void Store_free(*Store self) {
    for (i in 0..self.items.list.size) { free(self.items.list.data[i].title); }
    self.items.free();
    self.items = null;
}

// Tells the views after the items were edited in place.
void Store_changed(*Store self) { self.items.changed(); }
// The store owns its titles: a title is copied in and freed with its item.
void Store_add(*Store self, string title) {
    self.items.push(Todo{self.next_id++, false, ui_copy(title)});
}
void Store_toggle(*Store self, int id) {
    *List<Todo> items = self.items.items();
    for (i in 0..items.size) {
        if (items.data[i].id == id) { items.data[i].done = !items.data[i].done; }
    }
    self.changed();
}
void Store_remove(*Store self, int id) {
    *List<Todo> items = self.items.items();
    for (i in 0..items.size) {
        if (items.data[i].id == id) {
            free(items.data[i].title);
            self.items.remove(i);
            break;
        }
    }
}

void TodoApp(*Store store) {
    Column(Style{padding: 16}) {
        *List<Todo> items = store.items.items();
        Row(Style{}) {
            Image(Style{width: 48, height: 48, label: "Eskiu"}, "logo.png");
            Text("Eskiu TODO");
        }
        int pending = 0;
        for (i in 0..items.size) { if (!items.data[i].done) { pending++; } }
        Text(textf("Pending: %d", pending));
        // The rows scroll when there are more than fit.
        Scroll(Style{height: 320}) {
            for (i in 0..items.size) {
                Todo item = items.data[i];
                Row(Style{key: key(item.id), wrap: true}) {
                    *Signal<bool> editing = use_signal<bool>(false);
                    Text(item.title);
                    if (editing.get()) { Text("Editing"); }
                    Button(item.done ? "Undo" : "Done") { store.toggle(item.id); }
                    Button("Edit") { editing.set(!editing.get()); }
                    Button("Delete") { store.remove(item.id); }
                }
            }
            if (items.size == 0) { Text("Nothing to do"); }
        }
        *StringState draft = use_string("");
        TextInput_bind(Input{placeholder: "New task", label: "New task"}, draft);
        Button("Add") {
            if (!draft.empty()) { store.add(draft.get()); draft.set(""); }
        }
        Button("Reverse") {
            int n = store.items.size();
            for (int i = 0; i < n / 2; i++) { store.items.swap(i, n - 1 - i); }
        }
    }
}
