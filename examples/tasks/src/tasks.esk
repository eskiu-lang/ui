import <ui>;
import <string>;
import <time>;

// Eskiu Tasks: the showcase app the screenshots come from. A header with today's date, a
// progress card, filters, a field to add a task and the list of tasks.

// The palette, as 0xRRGGBBAA.
const int64 kInk = 0x111827FF;
const int64 kMuted = 0x6B7280FF;
const int64 kPage = 0xF5F6FAFF;
const int64 kCard = 0xFFFFFFFF;
const int64 kLine = 0xE5E7EBFF;
const int64 kPrimary = 0x4F46E5FF;
const int64 kPrimarySoft = 0xE0E7FFFF;
const int64 kSuccess = 0x10B981FF;

struct Task { int id; string title; int tag; bool done; }

// Tags: a name, its text color and its background.
string tag_name(int tag) { return tag == 0 ? "Work" : tag == 1 ? "Personal" : "Errands"; }
int64 tag_color(int tag) { return tag == 0 ? 0x1D4ED8FF : tag == 1 ? 0xBE185DFF : 0xB45309FF; }
int64 tag_background(int tag) { return tag == 0 ? 0xDBEAFEFF : tag == 1 ? 0xFCE7F3FF : 0xFEF3C7FF; }

// The model owns its tasks (and their titles) in a list whose changes render what reads it,
// and the indices the current filter shows, which the list reads when it renders rows on
// its own while scrolling.
struct TaskStore { *ListSignal<Task> tasks; List<int> visible; int next_id; }
TaskStore task_store;

void TaskStore_init(*TaskStore self) { self.tasks = list_signal_new<Task>(); }
void TaskStore_free(*TaskStore self) {
    for (i in 0..self.tasks.list.size) { free(self.tasks.list.data[i].title); }
    self.tasks.free();
    self.tasks = null;
    self.visible.free();
}
void TaskStore_add(*TaskStore self, string title, int tag, bool done) {
    self.tasks.push(Task{self.next_id++, ui_copy(title), tag, done});
}
void TaskStore_toggle(*TaskStore self, int id) {
    *List<Task> tasks = self.tasks.items();
    for (i in 0..tasks.size) {
        if (tasks.data[i].id == id) { tasks.data[i].done = !tasks.data[i].done; }
    }
    self.tasks.changed();
}

void tasks_seed(*TaskStore store) {
    store.init();
    store.add("Review the UI plan", 0, true);
    store.add("Ship the conformance suite", 0, true);
    store.add("Book flights to Mexico City", 1, false);
    store.add("Pick up groceries", 2, true);
    store.add("Write the 0.13 release notes", 0, false);
    store.add("Call the dentist", 1, false);
    store.add("Renew the passport", 2, true);
}

void Chip(string name, int value, *Signal<int> filter) {
    bool selected = filter.get() == value;
    Pressable(Style{padding: 10, radius: 18, border_width: 1, border_color: selected ? kInk : kLine,
                    background: selected ? kInk : kCard, label: name},
        void() { filter.set(value); }) {
        TextWith(Style{font_size: 14, font_weight: 600, color: selected ? kCard : kInk}, name);
    }
}

void TaskRow(*TaskStore store, int index) {
    Task task = store.tasks.get(index);
    Row(Style{height: 60, padding: 14, gap: 12, align: AlignCenter, background: kCard, radius: 14,
              border_width: 1, border_color: kLine, label: task.title}) {
        Pressable(Style{width: 24, height: 24, radius: 12, border_width: 2,
                        border_color: task.done ? kSuccess : 0xD1D5DBFF,
                        background: task.done ? kSuccess : NoColor, align: AlignCenter, justify: JustifyCenter,
                        label: task.done ? "Mark as not done" : "Mark as done"},
            void() { store.toggle(task.id); }) {
            if (task.done) { TextWith(Style{font_size: 13, font_weight: 700, color: kCard}, "✓"); }
        }
        TextWith(Style{grow: 1, font_size: 16, font_weight: 500, color: task.done ? kMuted : kInk}, task.title);
        Row(Style{padding: 6, radius: 8, background: tag_background(task.tag)}) {
            TextWith(Style{font_size: 12, font_weight: 600, color: tag_color(task.tag)}, tag_name(task.tag));
        }
    }
}

void TasksApp(*TaskStore store) {
    Column(Style{grow: 1, padding: 20, gap: 16, background: kPage}) {
        StatusBar(BarDark, false);
        *Signal<int> filter = use_signal<int>(0);
        *StringState draft = use_string("");
        *List<Task> tasks = store.tasks.items();
        int done = 0;
        for (i in 0..tasks.size) { if (tasks.data[i].done) { done++; } }
        int total = tasks.size;
        store.visible.clear();
        for (i in 0..total) {
            bool shown = filter.get() == 0 || (filter.get() == 1) != tasks.data[i].done;
            if (shown) { store.visible.push(i); }
        }

        Row(Style{gap: 12, align: AlignCenter}) {
            Image(Style{width: 44, height: 44, radius: 22, label: "Eskiu"}, "logo.png");
            Column(Style{gap: 2, grow: 1}) {
                TextWith(Style{font_size: 26, font_weight: 700, color: kInk}, "Today");
                *String date = frame_string();
                time_format(time_now_s(), "%A, %B %d", TIME_LOCAL, date);
                TextWith(Style{font_size: 14, color: kMuted}, date.data);
            }
            Row(Style{width: 40, height: 40, radius: 20, background: kPrimarySoft, align: AlignCenter,
                      justify: JustifyCenter, label: "Account"}) {
                TextWith(Style{font_size: 15, font_weight: 700, color: kPrimary}, "ED");
            }
        }

        Column(Style{background: kPrimary, radius: 20, padding: 20, gap: 10, label: "Progress"}) {
            Row(Style{justify: JustifyBetween, align: AlignCenter}) {
                TextWith(Style{font_size: 14, font_weight: 600, color: rgba(255, 255, 255, 210)}, "Daily progress");
                TextWith(Style{font_size: 14, font_weight: 600, color: kCard}, textf("%d of %d", done, total));
            }
            TextWith(Style{font_size: 34, font_weight: 800, color: kCard}, textf("%d%%", total == 0 ? 0 : done * 100 / total));
            Row(Style{height: 8, radius: 4, gap: 0, background: rgba(255, 255, 255, 70)}) {
                if (done > 0) { Box(Style{grow: done, background: kCard, radius: 4}); }
                if (total - done > 0) { Spacer(total - done); }
            }
        }

        Row(Style{gap: 8}) {
            Chip("All", 0, filter);
            Chip("Active", 1, filter);
            Chip("Done", 2, filter);
        }

        Row(Style{gap: 10, align: AlignCenter}) {
            TextInput_bind(Input{placeholder: "Add a task", label: "New task",
                                 style: Style{grow: 1, padding: 12, radius: 12, background: kCard, border_width: 1,
                                              border_color: kLine, font_size: 16}}, draft);
            ButtonWith(Style{background: kPrimary, color: kCard, radius: 12, padding: 12, font_size: 16,
                             font_weight: 600}, "Add") {
                if (!draft.empty()) { store.add(draft.get(), 0, false); draft.set(""); }
            }
        }

        if (store.visible.size == 0) {
            TextWith(Style{font_size: 15, color: kMuted}, "Nothing here yet");
        }
        FlatList(Style{grow: 1, label: "Tasks"}, store.visible.size, 68, void(int i) {
            TaskRow(store, store.visible.data[i]);
        });
    }
}
