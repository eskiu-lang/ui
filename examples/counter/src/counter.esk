// A counter: one signal, one text, one button.
import <string>;
import <ui>;

// textf formats a text for this frame (freed with it); -Wformat checks its arguments.
void NumberText(string label, int value) { Text(textf("%s%d", label, value)); }

void Counter() {
    Column(Style{padding: 16}) {
        *Signal<int> count = use_signal<int>(0);
        Text("Eskiu counter");
        // A test_id: what tests/ui/counter.uitest finds it by.
        TextWith(Style{test_id: "count"}, textf("Count: %d", count.get()));
        Button("Increment") { count.set(count.get() + 1); }
    }
}
