// A counter: one signal, one text, one button.
import <string>;
import <ui>;

// Text takes finished text; formatting goes through <string>, which -Wformat checks.
void NumberText(string label, int value) {
    String text;
    defer String_free(&text);
    String_format(&text, "%s%d", label, value);
    Text(text.data);
}

void Counter() {
    Column(Style{padding: 16}) {
        *Signal<int> count = use_signal<int>(0);
        Text("Eskiu counter");
        // A test_id: what tests/ui/counter.uitest finds it by.
        String label;
        defer String_free(&label);
        String_format(&label, "Count: %d", count.get());
        TextWith(Style{test_id: "count"}, label.data);
        Button("Increment") { count.set(count.get() + 1); }
    }
}
