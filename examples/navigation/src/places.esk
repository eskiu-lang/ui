// Explore: screens on the phone, pages on the web. A list of places, each place's page and
// a plan for the trip, with a date picker, a menu and a toast when it is saved. The routes
// are "/", "/places/:id" and "/places/:id/plan"; on the web they are the URL, and the page
// under the top keeps its state.
import <string>;
import <ui>;
import <ui/kit>;

// The palette.
int64 ink() { return rgb(17, 24, 39); }
int64 muted() { return rgb(107, 114, 128); }
int64 page() { return rgb(245, 246, 250); }
int64 card() { return rgb(255, 255, 255); }
int64 line() { return rgb(229, 231, 235); }
int64 primary() { return rgb(79, 70, 229); }
int64 primary_soft() { return rgb(224, 231, 255); }
int64 white() { return rgb(255, 255, 255); }
int64 white_soft() { return rgba(255, 255, 255, 60); }

struct Place { string name; string country; string flag; string blurb; string rating; string season; string month; string flight;
               string todo1; string todo2; string todo3; int64 color; int64 soft; }

const int kPlaces = 4;

Place place(int id) {
    if (id == 0) {
        return Place{"Lisbon", "Portugal", "🇵🇹",
                     "Seven hills over the Tagus, yellow trams climbing them and a light that turns every street gold before dinner.",
                     "4.8", "May", "May", "8h", "Ride tram 28 through Alfama", "Pastéis de nata in Belém",
                     "Sunset from the Senhora do Monte viewpoint", rgb(234, 88, 12), rgb(255, 237, 213)};
    }
    if (id == 1) {
        return Place{"Kyoto", "Japan", "🇯🇵",
                     "A thousand temples, moss gardens and wooden machiya on quiet lanes, with the old capital's rhythm in every season.",
                     "4.9", "April", "Apr", "14h", "Walk the Fushimi Inari gates at dawn", "Tea in Higashiyama",
                     "The bamboo grove in Arashiyama", rgb(225, 29, 72), rgb(255, 228, 230)};
    }
    if (id == 2) {
        return Place{"Oaxaca", "Mexico", "🇲🇽",
                     "Markets that smell of chocolate and chiles, seven moles, mezcal from the hills and Monte Albán above the valley.",
                     "4.9", "November", "Nov", "5h", "Mole at the 20 de Noviembre market", "Monte Albán at sunrise",
                     "A mezcal palenque in Santiago Matatlán", rgb(5, 150, 105), rgb(209, 250, 229)};
    }
    return Place{"Reykjavik", "Iceland", "🇮🇸",
                 "A small, bright capital at the edge of lava fields, hot springs and long summer days that never quite end.",
                 "4.7", "June", "Jun", "6h", "Soak in the Sky Lagoon", "Drive the Golden Circle",
                 "Whale watching from the Old Harbour", rgb(2, 132, 199), rgb(224, 242, 254)};
}

// The id in a route's ":id" part, or -1.
int place_id(string route, string pattern) {
    List<String> params;
    defer route_params_free(&params);
    if (!route_match(pattern, route, &params)) { return -1; }
    int id = atoi(params.data[0].data);
    return id >= 0 && id < kPlaces ? id : -1;
}

void open_place(*Router router, int id, string suffix) {
    String route;
    defer String_free(&route);
    String_format(&route, "/places/%d%s", id, suffix);
    router.push(route.data);
}

// The flag in a rounded tile of the place's soft color.
void FlagTile(Place p, int size) {
    Row(Style{width: size, height: size, radius: size / 4, background: p.soft, align: AlignCenter,
              justify: JustifyCenter}) { TextWith(Style{font_size: size / 2}, p.flag); }
}

void Featured(*Router router) {
    Place p = place(1);
    Pressable(Style{padding: 22, gap: 6, radius: 24, background: p.color, label: "Featured: Kyoto"},
        void() { open_place(router, 1, ""); }) {
        Row(Style{}) {
            Row(Style{padding: 6, radius: 10, background: white_soft()}) {
                TextWith(Style{font_size: 12, font_weight: 700, color: white()}, "TRIP OF THE MONTH");
            }
        }
        Row(Style{height: 18}) {}
        TextWith(Style{font_size: 32, font_weight: 800, color: white()}, "Kyoto in April");
        TextWith(Style{font_size: 15, color: rgba(255, 255, 255, 225)}, "Cherry blossoms, temples and tea houses.");
    }
}

void PlaceRow(*Router router, int id) {
    Place p = place(id);
    Pressable(Style{padding: 14, radius: 18, background: card(), border_width: 1, border_color: line(), label: p.name},
        void() { open_place(router, id, ""); }) {
        Row(Style{gap: 14, align: AlignCenter}) {
            FlagTile(p, 52);
            Column(Style{grow: 1, gap: 2}) {
                TextWith(Style{font_size: 17, font_weight: 700, color: ink()}, p.name);
                String detail;
                defer String_free(&detail);
                String_format(&detail, "%s · best in %s", p.country, p.season);
                TextWith(Style{font_size: 14, color: muted()}, detail.data);
            }
            Row(Style{padding: 6, radius: 10, background: primary_soft()}) {
                String stars;
                defer String_free(&stars);
                String_format(&stars, "★ %s", p.rating);
                TextWith(Style{font_size: 13, font_weight: 700, color: primary()}, stars.data);
            }
        }
    }
}

void PlaceList(*Router router) {
    Scroll(Style{grow: 1, background: page(), gap: 0}) {
        Column(Style{padding: 20, gap: 16}) {
            Row(Style{height: ui_insets().top}) {}
            Row(Style{align: AlignCenter, gap: 12}) {
                Column(Style{grow: 1, gap: 2}) {
                    TextWith(Style{font_size: 15, font_weight: 600, color: muted()}, "Good morning");
                    TextWith(Style{font_size: 32, font_weight: 800, color: ink()}, "Explore");
                }
                Avatar("ED", 44);
            }
            Featured(router);
            Row(Style{align: AlignCenter}) {
                TextWith(Style{grow: 1, font_size: 20, font_weight: 700, color: ink()}, "Popular places");
                TextWith(Style{font_size: 14, color: muted()}, "4 places");
            }
            for (i in 0..kPlaces) { PlaceRow(router, i); }
        }
    }
}

void Stat(string label, string value) {
    // A width of 1 and a share of the row: the three take equal parts.
    Column(Style{width: 1, grow: 1, padding: 14, gap: 2, radius: 16, background: card(), border_width: 1, border_color: line(),
                 label: label}) {
        TextWith(Style{font_size: 13, color: muted()}, label);
        TextWith(Style{font_size: 18, font_weight: 700, color: ink()}, value);
    }
}

void Todo(Place p, string text) {
    Row(Style{gap: 12, align: AlignCenter}) {
        Row(Style{width: 10, height: 10, radius: 5, background: p.color}) {}
        TextWith(Style{grow: 1, font_size: 16, color: ink()}, text);
    }
}

void PlacePage(*Router router, int id) {
    Place p = place(id);
    Scroll(Style{grow: 1, background: page(), gap: 0}) {
        Column(Style{padding: 20, gap: 8, background: p.color}) {
            Row(Style{height: ui_insets().top}) {}
            Row(Style{}) {
                Pressable(Style{padding: 10, radius: 14, background: white_soft(), label: "Back"},
                    void() { router.back(); }) {
                    TextWith(Style{font_size: 15, font_weight: 700, color: white()}, "‹  Places");
                }
            }
            Row(Style{height: 28}) {}
            TextWith(Style{font_size: 52}, p.flag);
            TextWith(Style{font_size: 40, font_weight: 800, color: white()}, p.name);
            TextWith(Style{font_size: 17, color: rgba(255, 255, 255, 225)}, p.country);
            Row(Style{height: 8}) {}
        }
        Column(Style{padding: 20, gap: 18}) {
            Row(Style{gap: 10}) {
                String stars;
                defer String_free(&stars);
                String_format(&stars, "★ %s", p.rating);
                Stat("Rating", stars.data);
                Stat("Best time", p.month);
                Stat("Flight", p.flight);
            }
            TextWith(Style{font_size: 17, color: ink()}, p.blurb);
            Column(Style{padding: 18, gap: 14, radius: 18, background: card(), border_width: 1, border_color: line()}) {
                TextWith(Style{font_size: 18, font_weight: 700, color: ink()}, "Things to do");
                Todo(p, p.todo1);
                Todo(p, p.todo2);
                Todo(p, p.todo3);
            }
            ButtonWith(Style{padding: 16, radius: 16, background: ink(), color: white(), font_size: 17, font_weight: 700},
                "Plan a trip") { open_place(router, id, "/plan"); }
        }
    }
}

void PlanPage(*Router router, int id) {
    Place p = place(id);
    Column(Style{grow: 1, background: page(), gap: 0}) {
        Row(Style{height: ui_insets().top, background: card()}) {}
        String title;
        defer String_free(&title);
        String_format(&title, "Trip to %s", p.name);
        NavBar(title.data) { KitButton("Back", VariantGhost, void() { router.back(); }); }
        Column(Style{padding: 20, gap: 16}) {
            Card() {
                // The day leaving, as year * 10000 + month * 100 + day (a signal holds a number).
                *Signal<int> leaving = use_signal<int>(20261112);
                *Signal<int> travelers = use_signal<int>(1);
                *Signal<int> budget = use_signal<int>(1);
                int day = leaving.get();
                TextWith(Style{font_size: 15, font_weight: 600, color: muted()}, "Leaving");
                DatePicker(Date{day / 10000, day / 100 % 100, day % 100}, void(Date d) {
                    leaving.set(d.year * 10000 + d.month * 100 + d.day);
                });
                TextWith(Style{font_size: 15, font_weight: 600, color: muted()}, "Travelers");
                Select("Just me\nTwo people\nA family of four", travelers.get(), void(int i) { travelers.set(i); });
                TextWith(Style{font_size: 15, font_weight: 600, color: muted()}, "Budget");
                SegmentedControl("Saver\nComfort\nLuxury", budget.get(), void(int i) { budget.set(i); });
            }
            Card() {
                *Signal<bool> flights = use_signal<bool>(true);
                *Signal<bool> hotel = use_signal<bool>(true);
                *Signal<bool> guide = use_signal<bool>(false);
                Checkbox("Flights", flights.get(), void(bool on) { flights.set(on); });
                Checkbox("Hotel", hotel.get(), void(bool on) { hotel.set(on); });
                Checkbox("A local guide", guide.get(), void(bool on) { guide.set(on); });
            }
            KitButton("Save the plan", VariantPrimary) {
                String saved;
                defer String_free(&saved);
                String_format(&saved, "Your trip to %s is saved", p.name);
                kit_toast(saved.data);
                router.reset("/");
            }
        }
    }
}

void Places(*Router router) {
    Column(Style{grow: 1, gap: 0}) {
        // Light status bar text over a place's cover, dark elsewhere.
        bool cover = place_id(router.path(), "/places/:id") >= 0;
        StatusBar(cover ? BarLight : BarDark, false);
        Navigator(router, void(string route) {
            int plan = place_id(route, "/places/:id/plan");
            int place_at = place_id(route, "/places/:id");
            if (plan >= 0) { PlanPage(router, plan); }
            else if (place_at >= 0) { PlacePage(router, place_at); }
            else { PlaceList(router); }
        });
        ToastHost();
    }
}
