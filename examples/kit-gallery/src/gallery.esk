import <ui/kit>;

// Every <ui/kit> component, with state, on one scrolling page.
void KitGallery() {
    // Light or dark, as the system is.
    kit_follow_system();
    StatusBar(kit.dark ? BarLight : BarDark, false);
    Column(Style{grow: 1, background: kit.page, gap: 0}) {
        NavBar("Kit") { Avatar("ED", 36); }
        Separator();
        Scroll(Style{grow: 1, padding: 16, gap: 16, label: "Gallery"}) {
            *Signal<bool> notify = use_signal<bool>(true);
            *Signal<bool> weekly = use_signal<bool>(false);
            *Signal<int> plan = use_signal<int>(1);
            *Signal<int> view = use_signal<int>(0);
            *Signal<int> tab = use_signal<int>(0);
            *Signal<int> steps = use_signal<int>(3);
            *StringState email = use_string("");

            Card() {
                Title("Text");
                Heading("A section's heading");
                Body("Running text, in the theme's ink.");
                Secondary("Text that explains or qualifies.");
                Caption("A small note: version 0.2.0");
            }

            Card() {
                Heading("Badges and avatars");
                Row(Style{gap: 8, wrap: true}) {
                    Badge("Neutral", ToneNeutral);
                    Badge("Primary", TonePrimary);
                    Badge("Success", ToneSuccess);
                    Badge("Warning", ToneWarning);
                    Badge("Danger", ToneDanger);
                }
                Row(Style{gap: 8, align: AlignCenter}) {
                    Avatar("AB", 40);
                    Avatar("CD", 40);
                    AvatarImage("logo.png", 40, "Eskiu");
                }
            }

            Card() {
                Heading("Buttons");
                Row(Style{gap: 8, wrap: true}) {
                    KitButton("Primary", VariantPrimary) { steps.set(steps.get() + 1); }
                    KitButton("Secondary", VariantSecondary) { steps.set(steps.get() - 1); }
                    KitButton("Ghost", VariantGhost) {}
                    KitButton("Danger", VariantDanger) { steps.set(0); }
                }
                ProgressBar(steps.get(), 5);
            }

            Card() {
                Heading("Forms");
                TextField(email.get(), "Email", void(string text) { email.set(text); });
                Checkbox("Email notifications", notify.get(), void(bool on) { notify.set(on); });
                Checkbox("Weekly summary", weekly.get(), void(bool on) { weekly.set(on); });
                Separator();
                RadioGroup("Free\nPro\nTeam", plan.get(), void(int i) { plan.set(i); });
            }

            Card() {
                Heading("Navigation");
                SegmentedControl("Day\nWeek\nMonth", view.get(), void(int i) { view.set(i); });
                TabBar("Overview\nActivity\nSettings", tab.get(), void(int i) { tab.set(i); });
                Secondary(
                    tab.get() == 0 ? "Everything at a glance." : tab.get() == 1 ? "What changed lately." : "How it works.");
            }

            Card() {
                Heading("Overlays");
                *Signal<int> sort = use_signal<int>(0);
                *Signal<int> day = use_signal<int>(21);
                *Signal<int64> color = use_signal<int64>(0x6366F1FF);
                Select("Newest first\nOldest first\nBy name", sort.get(), void(int i) { sort.set(i); });
                Row(Style{gap: 12, align: AlignCenter}) {
                    Column(Style{grow: 1, gap: 0}) {
                        DatePicker(Date{2026, 10, day.get()}, void(Date d) { day.set(d.day); });
                    }
                    ColorPicker(color.get(), void(int64 c) { color.set(c); });
                }
                Row(Style{gap: 12, align: AlignCenter}) {
                    DropdownMenu("Share", "Copy link\nEmail\nMessages", void(int i) {
                        kit_toast(i == 0 ? "Link copied" : i == 1 ? "Opening Mail" : "Opening Messages");
                    });
                    Tooltip("Shows a message for a moment") {
                        KitButton("Toast", VariantGhost) { kit_toast("Saved to your library"); }
                    }
                }
            }

            Card() {
                Heading("Gestures");
                // Swipe a row left to delete it; each row is keyed, so the others keep their state.
                *Signal<int> deleted = use_signal<int>(0);
                for (i in 0..3) {
                    int row = i;
                    if ((deleted.get() & (1 << row)) != 0) { continue; }
                    Column(Style{key: key(row), gap: 0}) {
                        SwipeToDelete("Delete", void() { deleted.set(deleted.get() | (1 << row)); }) {
                            ListItem(row == 0 ? "Inbox" : row == 1 ? "Drafts" : "Archive", "Swipe left to delete") {}
                        }
                    }
                }
                if (deleted.get() == 7) { KitButton("Bring them back", VariantSecondary, void() { deleted.set(0); }); }
            }

            Card() {
                Heading("Errors");
                // A render that throws shows the boundary's fallback; the rest of the page goes on.
                ErrorBoundary(void(UiError e) {
                    Secondary("This card failed. The rest of the page kept running.");
                    KitButton("Try again", VariantSecondary) { ui_boundary_reset(e.boundary); }
                }) {
                    *Signal<bool> broken = use_signal<bool>(false);
                    if (broken.get()) { throw 1; }
                    Secondary("A part of the screen that fails shows a fallback in its place.");
                    KitButton("Break this card", VariantDanger) { broken.set(true); }
                }
            }

            Accordion() {
                Collapsible("What is Eskiu?") {
                    Secondary("A systems language that compiles through LLVM.");
                }
                Separator();
                Collapsible("Where does ui run?") {
                    Secondary("iOS, Android, the web and the desktop.");
                }
            }

            Toolbar() {
                KitButton("Bold", VariantGhost) {}
                VSeparator();
                KitButton("Italic", VariantGhost) {}
            }

            ListItem("Account", "Name, email and password") {}
            ListItem("Notifications", "") {}
        }
        ToastHost();
    }
}
