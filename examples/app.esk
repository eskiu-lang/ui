import "components.esk";
import "conformance.esk";
import "tasks.esk";
import "../hosts/bridge.esk";

// The examples behind one host app: `which` picks one (0 counter, 1 TODO, 2 a scheduler
// probe, 3 the conformance scene, 4 the Tasks showcase).
void ui_app_start(int example) {
    if (example == 0) { ui_mount(void() { Counter(); }); }
    else if (example == 4) {
        tasks_seed(&task_store);
        ui_mount(void() { TasksApp(&task_store); });
    }
    else if (example == 3) {
        String_free(&conformance_log);
        ui_test_log = null;
        ui_mount(void() { Conformance(); });
    }
    else if (example == 2) {
        // Scheduler probe: effects must advance without another user event.
        ui_mount(void() {
            *Signal<int> progress = use_signal<int>(0);
            NumberText("Progress: ", progress.get());
            use_effect(void() {
                int value = progress.get();
                if (value < 2) { progress.set(value + 1); }
            });
        });
    }
    else {
        todo_store.init();
        todo_store.add("Try Eskiu UI");
        todo_store.add("Reorder without losing state");
        ui_mount(void() { TodoApp(&todo_store); });
    }
}

void ui_app_stop() {
    if (todo_store.revision != null) { todo_store.free(); }
    if (task_store.revision != null) { task_store.free(); }
}
