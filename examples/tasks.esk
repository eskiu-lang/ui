import "../src/ui.esk";
import <string>;
import <time>;

// Eskiu Tasks: the showcase app the screenshots come from. A header with today's date, a
// progress card, filters, a field to add a task and the list of tasks.

// The palette.
int64 ink() { return rgb(17, 24, 39); }
int64 muted() { return rgb(107, 114, 128); }
int64 page() { return rgb(245, 246, 250); }
int64 card() { return rgb(255, 255, 255); }
int64 line() { return rgb(229, 231, 235); }
int64 primary() { return rgb(79, 70, 229); }
int64 primary_soft() { return rgb(224, 231, 255); }
int64 success() { return rgb(16, 185, 129); }

struct Task { int id; string title; int tag; bool done; }

// Tags: a name, its text color and its background.
string tag_name(int tag) { return tag == 0 ? "Work" : tag == 1 ? "Personal" : "Errands"; }
int64 tag_color(int tag) { return tag == 0 ? rgb(29, 78, 216) : tag == 1 ? rgb(190, 24, 93) : rgb(180, 83, 9); }
int64 tag_background(int tag) { return tag == 0 ? rgb(219, 234, 254) : tag == 1 ? rgb(252, 231, 243) : rgb(254, 243, 199); }

// The model owns its tasks (and their titles) and the indices the current filter shows,
// which the list reads when it renders rows on its own while scrolling.
struct TaskStore { List<Task> tasks; List<int> visible; int next_id; *Signal<int> revision; }
TaskStore task_store;

void TaskStore_init(*TaskStore self) { self.revision = signal_new<int>(0); }
void TaskStore_free(*TaskStore self) {
    for (i in 0..self.tasks.size) { free(self.tasks.data[i].title); }
    self.tasks.free();
    self.visible.free();
    self.revision.free();
    self.revision = null;
}
void TaskStore_changed(*TaskStore self) { self.revision.set(self.revision.get() + 1); }
void TaskStore_add(*TaskStore self, string title, int tag, bool done) {
    self.tasks.push(Task{self.next_id++, ui_copy(title), tag, done});
    self.changed();
}
void TaskStore_toggle(*TaskStore self, int id) {
    for (i in 0..self.tasks.size) {
        if (self.tasks.data[i].id == id) { self.tasks.data[i].done = !self.tasks.data[i].done; }
    }
    self.changed();
}

void tasks_seed(*TaskStore store) {
    store.init();
    store.add("Review the UI plan", 0, true);
    store.add("Ship the conformance suite", 0, true);
    store.add("Book flights to Mexico City", 1, false);
    store.add("Pick up groceries", 2, true);
    store.add("Write the 0.13 release notes", 0, false);
    store.add("Call the dentist", 1, false);
    store.add("Renew the passport", 2, true);
}

void Label(Style style, string text) { TextWith(style, text); }

void Chip(string name, int value, *Signal<int> filter) {
    bool selected = filter.get() == value;
    Pressable(Style{padding: 10, radius: 18, border_width: 1, border_color: selected ? ink() : line(),
                    background: selected ? ink() : card(), label: name},
        void() { filter.set(value); }, void() {
            Label(Style{font_size: 14, font_weight: 600, color: selected ? card() : ink()}, name);
        });
}

void TaskRow(*TaskStore store, int index) {
    Task task = store.tasks.data[index];
    Row(Style{height: 60, padding: 14, gap: 12, align: AlignCenter, background: card(), radius: 14,
              border_width: 1, border_color: line(), label: task.title}, void() {
        Pressable(Style{width: 24, height: 24, radius: 12, border_width: 2,
                        border_color: task.done ? success() : rgb(209, 213, 219),
                        background: task.done ? success() : -1, align: AlignCenter, justify: JustifyCenter,
                        label: task.done ? "Mark as not done" : "Mark as done"},
            void() { store.toggle(task.id); }, void() {
                if (task.done) { Label(Style{font_size: 13, font_weight: 700, color: card()}, "✓"); }
            });
        Label(Style{grow: 1, font_size: 16, font_weight: 500, color: task.done ? muted() : ink()}, task.title);
        Row(Style{padding: 6, radius: 8, background: tag_background(task.tag)}, void() {
            Label(Style{font_size: 12, font_weight: 600, color: tag_color(task.tag)}, tag_name(task.tag));
        });
    });
}

void TasksApp(*TaskStore store) {
    Column(Style{grow: 1, padding: 20, gap: 16, background: page()}, void() {
        StatusBar(BarDark, false);
        *Signal<int> filter = use_signal<int>(0);
        *StringState draft = use_string("");
        store.revision.get();
        int done = 0;
        for (i in 0..store.tasks.size) { if (store.tasks.data[i].done) { done++; } }
        int total = store.tasks.size;
        store.visible.clear();
        for (i in 0..total) {
            bool shown = filter.get() == 0 || (filter.get() == 1) != store.tasks.data[i].done;
            if (shown) { store.visible.push(i); }
        }

        Row(Style{gap: 12, align: AlignCenter}, void() {
            Image(Style{width: 44, height: 44, radius: 22, label: "Eskiu"}, "logo.png");
            Column(Style{gap: 2, grow: 1}, void() {
                Label(Style{font_size: 26, font_weight: 700, color: ink()}, "Today");
                String date;
                defer String_free(&date);
                time_format(time_now_s(), "%A, %B %d", TIME_LOCAL, &date);
                Label(Style{font_size: 14, color: muted()}, date.data);
            });
            Row(Style{width: 40, height: 40, radius: 20, background: primary_soft(), align: AlignCenter,
                      justify: JustifyCenter, label: "Account"}, void() {
                Label(Style{font_size: 15, font_weight: 700, color: primary()}, "ED");
            });
        });

        Column(Style{background: primary(), radius: 20, padding: 20, gap: 10, label: "Progress"}, void() {
            String count;
            defer String_free(&count);
            String_format(&count, "%d of %d", done, total);
            String percent;
            defer String_free(&percent);
            String_format(&percent, "%d%%", total == 0 ? 0 : done * 100 / total);
            Row(Style{justify: JustifyBetween, align: AlignCenter}, void() {
                Label(Style{font_size: 14, font_weight: 600, color: rgba(255, 255, 255, 210)}, "Daily progress");
                Label(Style{font_size: 14, font_weight: 600, color: card()}, count.data);
            });
            Label(Style{font_size: 34, font_weight: 800, color: card()}, percent.data);
            Row(Style{height: 8, radius: 4, gap: 0, background: rgba(255, 255, 255, 70)}, void() {
                if (done > 0) { Row(Style{grow: done, background: card(), radius: 4}, void() {}); }
                if (total - done > 0) { Row(Style{grow: total - done}, void() {}); }
            });
        });

        Row(Style{gap: 8}, void() {
            Chip("All", 0, filter);
            Chip("Active", 1, filter);
            Chip("Done", 2, filter);
        });

        Row(Style{gap: 10, align: AlignCenter}, void() {
            TextInput(Input{value: draft.get(), placeholder: "Add a task", label: "New task",
                            style: Style{grow: 1, padding: 12, radius: 12, background: card(), border_width: 1,
                                         border_color: line(), font_size: 16}},
                void(string text) { draft.set(text); });
            ButtonWith(Style{background: primary(), color: card(), radius: 12, padding: 12, font_size: 16,
                             font_weight: 600}, "Add", void() {
                if (draft.get()[0] != 0) { store.add(draft.get(), 0, false); draft.set(""); }
            });
        });

        if (store.visible.size == 0) {
            Label(Style{font_size: 15, color: muted()}, "Nothing here yet");
        }
        FlatList(Style{grow: 1, label: "Tasks"}, store.visible.size, 68, void(int i) {
            TaskRow(store, store.visible.data[i]);
        });
    });
}
